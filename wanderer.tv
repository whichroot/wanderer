import "../traveler/src/lib/time/time.tv";
import "../traveler/src/lib/nt/linrec.tv";
import "../traveler/src/lib/float/ieee.tv";   // f32_decode: exact float->dyadic for nnue import
import "../traveler/src/lib/float/quant.tv";  // quant_f32: exact scaled-int8 quantization (v2 import)
let BM_PRIME: i64 = 2147483647;              // 2^31-1 lifting prime (values bounded << p)

extern "C" fn write(fd: i32, buf: *u8, n: usize) -> i64;
extern "C" fn exit(code: i32);
extern "C" fn open(path: *u8, flags: i32, mode: i32) -> i32;
extern "C" fn creat(path: *u8, mode: i32) -> i32;
extern "C" fn read(fd: i32, buf: *u8, n: usize) -> i64;
extern "C" fn close(fd: i32) -> i32;

// ---------------- constants ----------------

let EMPTY: i32 = 0;
let WP: i32 = 1;  let WN: i32 = 2;  let WB: i32 = 3;
let WR: i32 = 4;  let WQ: i32 = 5;  let WK: i32 = 6;
let BP: i32 = 7;  let BN: i32 = 8;  let BB: i32 = 9;
let BR: i32 = 10; let BQ: i32 = 11; let BK: i32 = 12;
let OFF: i32 = 13;

let WHITE: i32 = 0;
let BLACK: i32 = 1;

let CWK: i32 = 1;   // castle right bits
let CWQ: i32 = 2;
let CBK: i32 = 4;
let CBQ: i32 = 8;

let MATE: i32 = 30000;
let INF: i32 = 31000;
let MAXPLY: i32 = 120;

let MF_EP: i32 = 1;
let MF_DOUBLE: i32 = 2;
let MF_CASTLE: i32 = 4;

let TT_EXACT: i32 = 1;   // score is exact (PV node)
let TT_LOWER: i32 = 2;   // score is a lower bound
let TT_UPPER: i32 = 3;   // score is an upper bound
let TTSIZE: i32 = 2097152;   // 2^21 direct-mapped slots
let TTMASK: i64 = 2097151;   // TTSIZE - 1

// ---------------- globals ----------------

var g_board: *i32 = null;      // 120
var g_side: i32 = 0;
var g_ep: i32 = 0;             // 0 = none
var g_castle: i32 = 0;
var g_fifty: i32 = 0;
var g_ksq: *i32 = null;        // 2: king square per side

var g_hply: i32 = 0;           // history height (game + search)
var g_h_move: *i32 = null;     // 1024 history stacks
var g_h_cap: *i32 = null;
var g_h_castle: *i32 = null;
var g_h_ep: *i32 = null;
var g_h_fifty: *i32 = null;
var g_h_key: *i64 = null;      // position key BEFORE the move at this height

var g_key: i64 = 0;            // incremental position key (pieces + side)
var g_zpiece: *i64 = null;
var g_zside: i64 = 0;
var g_zcastle: *i64 = null;    // 16 castle-right combinations
var g_zep: *i64 = null;        // by EP square (120-indexed; 0 = none, unhashed)

var g_tt_key: *i64 = null;     // full position key stored for verification
var g_tt_move: *i32 = null;    // best/refutation move at this position
var g_tt_score: *i32 = null;   // score, mate-adjusted relative to this node
var g_tt_depth: *i32 = null;   // search depth (draft) the score was proven to
var g_tt_flag: *i32 = null;    // TT_EXACT / TT_LOWER / TT_UPPER, 0 = empty
var g_ttmove: i32 = 0;         // TT move for the node currently being generated

var g_mv: *i32 = null;         // move stack 65536
var g_msc: *i32 = null;        // parallel scores
var g_first: *i32 = null;      // MAXPLY+2 slice starts

var g_pval: *i32 = null;       // 14 piece values
var g_pst: *i32 = null;        // 6*64 midgame-ish PST (white view)
var g_kend: *i32 = null;       // 64 endgame king PST
var g_passed: *i32 = null;     // 8 passed-pawn bonus by rank-index (0..7)

var g_kdir: *i32 = null;       // 8 knight offsets
var g_kingd: *i32 = null;      // 8 king offsets
var g_bdir: *i32 = null;       // 4 bishop
var g_rdir: *i32 = null;       // 4 rook

var g_kzsq: *i32 = null;       // 9: king-zone squares (king + on-board neighbors)
var g_kzc: i32 = 0;            // number of king-zone squares currently built
var g_ksmult: *i32 = null;     // 8: attacker-count danger multiplier (percent)
var g_kd_raw: i32 = 0;
var g_kd_att: i32 = 0;         // last king_danger: distinct attacker count

var g_crights: *i32 = null;    // 120: castle-right update mask per square

var g_killer1: *i32 = null;    // MAXPLY killers
var g_killer2: *i32 = null;
var g_hist: *i32 = null;       // 120*120 history heuristic

var g_nodes: i64 = 0;
var g_stop: i32 = 0;
var g_starttime: i64 = 0;
var g_budget: i64 = 0;         // ms; 0 = no time limit
var g_tc_clock: i32 = 0;       // 1 = budget came from a real clock (wtime/btime)
var g_maxdepth: i32 = 64;
var g_bestroot: i32 = 0;

var g_temp: i32 = 0;           // centipawn temperature; 0 = deterministic best
var g_root_n: i32 = 0;         // root moves recorded this iteration (temp>0 only)
var g_root_mv: *i32 = null;    // scratch: root moves
var g_root_sc: *i32 = null;    // scratch: root scores
var g_root_cn: i32 = 0;        // committed count from the last completed iteration
var g_root_cmv: *i32 = null;   // committed root moves
var g_root_csc: *i32 = null;   // committed root scores

var g_line: *u8 = null;        // uci input line buffer
var g_inbuf: *u8 = null;       // raw stdin buffer
var g_tok: *u8 = null;         // token scratch

// ---------------- small io helpers ----------------

fn str_len(s: *u8) -> i32 {
    var i: i32 = 0;
    while s[i] != 0 { i = i + 1; }
    return i;
}

fn wr(fd: i32, s: *u8) {
    write(fd, s, str_len(s) as usize);
}

fn wr_int(fd: i32, n: i64) {
    if n < 0 {
        wr(fd, "-");
        wr_int(fd, 0 - n);
        return;
    }
    if n >= 10 {
        wr_int(fd, n / 10);
    }
    var d: [u8; 1] = 0;
    d[0] = ((n % 10) + 48) as u8;
    write(fd, &d[0], 1);
}

fn wr_ch(fd: i32, c: i32) {
    var d: [u8; 1] = 0;
    d[0] = c as u8;
    write(fd, &d[0], 1);
}

fn now_ms() -> i64 {
    match time_mono_ns() {
        Result::Ok(ns) => { return ns / 1000000; }
        Result::Err(e) => { }
    }
    match time_wall_ns() {
        Result::Ok(ns) => { return ns / 1000000; }
        Result::Err(e) => { }
    }
    return 0;
}

// ---------------- board helpers ----------------

fn piece_side(p: i32) -> i32 {
    if p >= BP { return BLACK; }
    return WHITE;
}

fn sq64(sq: i32) -> i32 {
    let r: i32 = sq / 10 - 2;
    let f: i32 = sq % 10 - 1;
    return r * 8 + f;
}

fn mirror64(s: i32) -> i32 {
    let r: i32 = s / 8;
    let f: i32 = s % 8;
    return (7 - r) * 8 + f;
}

var g_rng: i64 = 88172645463325252;
fn rand64() -> i64 {
    var x: i64 = g_rng;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    g_rng = x;
    return x;
}

fn recompute_key() -> i64 {
    var k: i64 = 0;
    var sq: i32 = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if p != EMPTY && p != OFF {
            k = k ^ g_zpiece[p * 120 + sq];
        }
        sq = sq + 1;
    }
    k = k ^ g_zcastle[g_castle];
    if g_ep != 0 { k = k ^ g_zep[g_ep]; }
    if g_side == BLACK { k = k ^ g_zside; }
    return k;
}

fn init_tables() {
    g_board = alloc(120);
    g_ksq = alloc(2);
    g_h_move = alloc(1024);
    g_h_cap = alloc(1024);
    g_h_castle = alloc(1024);
    g_h_ep = alloc(1024);
    g_h_fifty = alloc(1024);
    g_h_key = alloc(1024);
    g_mv = alloc(65536);
    g_msc = alloc(65536);
    g_first = alloc(MAXPLY + 2);
    g_pval = alloc(14);
    g_pst = alloc(384);
    g_kend = alloc(64);
    g_passed = alloc(8);
    g_passed[0] = 0;   g_passed[1] = 10;  g_passed[2] = 20;  g_passed[3] = 35;
    g_passed[4] = 60;  g_passed[5] = 100; g_passed[6] = 160; g_passed[7] = 0;
    g_kdir = alloc(8);
    g_kingd = alloc(8);
    g_bdir = alloc(4);
    g_rdir = alloc(4);
    g_kzsq = alloc(9);
    g_ksmult = alloc(8);
    g_ksmult[0] = 0;  g_ksmult[1] = 0;  g_ksmult[2] = 50; g_ksmult[3] = 75;
    g_ksmult[4] = 88; g_ksmult[5] = 94; g_ksmult[6] = 97; g_ksmult[7] = 99;
    g_crights = alloc(120);
    g_killer1 = alloc(MAXPLY);
    g_killer2 = alloc(MAXPLY);
    g_hist = alloc(14400);
    g_root_mv = alloc(256);
    g_root_sc = alloc(256);
    g_root_cmv = alloc(256);
    g_root_csc = alloc(256);
    g_line = alloc(8192);
    g_inbuf = alloc(65536);
    g_tok = alloc(256);
    g_zpiece = alloc(1680);
    g_zcastle = alloc(16);
    g_zep = alloc(120);
    g_tt_key = alloc(TTSIZE);
    g_tt_move = alloc(TTSIZE);
    g_tt_score = alloc(TTSIZE);
    g_tt_depth = alloc(TTSIZE);
    g_tt_flag = alloc(TTSIZE);
    tt_clear();

    g_nn_ft = alloc(NN_NFH * NN_H);
    g_nn_w2 = alloc(NN_K * 2 * NN_H);
    g_nn_accs = alloc(1032 * 2 * NN_H);
    g_nn_acc = &g_nn_accs[0];
    g_nn_tmp = alloc(2 * NN_H);
    g_fin_acc = alloc(2 * 64 * NN_H);
    g_fin_board = alloc(2 * 64 * 120);
    g_fin_ok = alloc(128);
    g_nn_ok = alloc(1032 * 2);
    g_nn_dn = alloc(1032);
    g_nn_dpc = alloc(1032 * 5);
    g_nn_dsq = alloc(1032 * 5);
    g_nn_dsg = alloc(1032 * 5);
    g_nn_km = alloc(1032 * 2);
    g_ev_key = alloc(EVC_SIZE);
    g_ev_cls = alloc(EVC_SIZE);
    g_ev_nn = alloc(EVC_SIZE);
    g_ev_has = alloc(EVC_SIZE);
    nn_fin_flush();
    // trainer grad arrays (dft/dw2/dwf) deliberately NOT allocated: in-engine
    // train/gradcheck/factorcheck refuse in the v2 build (MLX is the trainer).
    nn_init_weights();

    var i: i32 = 0;
    while i < 1680 { g_zpiece[i] = rand64(); i = i + 1; }
    g_zside = rand64();
    i = 0; while i < 16 { g_zcastle[i] = rand64(); i = i + 1; }
    i = 0; while i < 120 { g_zep[i] = rand64(); i = i + 1; }

    g_kdir[0] = 0 - 21; g_kdir[1] = 0 - 19; g_kdir[2] = 0 - 12; g_kdir[3] = 0 - 8;
    g_kdir[4] = 8;      g_kdir[5] = 12;     g_kdir[6] = 19;     g_kdir[7] = 21;
    g_kingd[0] = 0 - 11; g_kingd[1] = 0 - 10; g_kingd[2] = 0 - 9; g_kingd[3] = 0 - 1;
    g_kingd[4] = 1;      g_kingd[5] = 9;      g_kingd[6] = 10;    g_kingd[7] = 11;
    g_bdir[0] = 0 - 11; g_bdir[1] = 0 - 9; g_bdir[2] = 9;  g_bdir[3] = 11;
    g_rdir[0] = 0 - 10; g_rdir[1] = 0 - 1; g_rdir[2] = 1;  g_rdir[3] = 10;

    g_pval[EMPTY] = 0;
    g_pval[WP] = 100; g_pval[WN] = 320; g_pval[WB] = 330;
    g_pval[WR] = 500; g_pval[WQ] = 900; g_pval[WK] = 0;
    g_pval[BP] = 100; g_pval[BN] = 320; g_pval[BB] = 330;
    g_pval[BR] = 500; g_pval[BQ] = 900; g_pval[BK] = 0;
    g_pval[OFF] = 0;

    i = 0;
    while i < 120 { g_crights[i] = 15; i = i + 1; }
    g_crights[21] = 15 - CWQ;
    g_crights[25] = 15 - CWK - CWQ;
    g_crights[28] = 15 - CWK;
    g_crights[91] = 15 - CBQ;
    g_crights[95] = 15 - CBK - CBQ;
    g_crights[98] = 15 - CBK;

    // ---- procedural piece-square tables (white point of view) ----
    var s: i32 = 0;
    while s < 64 {
        let r: i32 = s / 8;             // rank 0..7, 0 = rank 1
        let f: i32 = s % 8;             // file 0..7, 0 = a
        var fa: i32 = f * 2 - 7; if fa < 0 { fa = 0 - fa; }
        var ra: i32 = r * 2 - 7; if ra < 0 { ra = 0 - ra; }
        let cd: i32 = fa + ra;

        var pv: i32 = r * 5;
        if (f == 3 || f == 4) && r >= 2 && r <= 5 { pv = pv + 10; }
        if r == 1 && (f == 3 || f == 4) { pv = pv - 10; }
        if r == 6 { pv = pv + 30; }
        g_pst[0 * 64 + s] = pv;

        g_pst[1 * 64 + s] = 30 - cd * 3;

        g_pst[2 * 64 + s] = 18 - cd * 2;

        var rv: i32 = 0;
        if f == 3 || f == 4 { rv = rv + 6; }
        if r == 6 { rv = rv + 22; }
        g_pst[3 * 64 + s] = rv;

        g_pst[4 * 64 + s] = 8 - cd;

        var kv: i32 = 0 - r * 22;
        if r == 0 {
            if f == 6 || f == 2 { kv = kv + 30; }
            if f == 1 || f == 7 { kv = kv + 18; }
            if f == 4 || f == 3 { kv = kv - 8; }
        }
        g_pst[5 * 64 + s] = kv;

        g_kend[s] = 24 - cd * 3;

        s = s + 1;
    }
}

fn clear_search_tables() {
    var i: i32 = 0;
    while i < MAXPLY { g_killer1[i] = 0; g_killer2[i] = 0; i = i + 1; }
    i = 0;
    while i < 14400 { g_hist[i] = 0; i = i + 1; }
}

fn set_startpos() {
    nn_inval_all();
    var i: i32 = 0;
    while i < 120 { g_board[i] = OFF; i = i + 1; }
    var r: i32 = 0;
    while r < 8 {
        var f: i32 = 0;
        while f < 8 {
            g_board[21 + r * 10 + f] = EMPTY;
            f = f + 1;
        }
        r = r + 1;
    }
    g_board[21] = WR; g_board[22] = WN; g_board[23] = WB; g_board[24] = WQ;
    g_board[25] = WK; g_board[26] = WB; g_board[27] = WN; g_board[28] = WR;
    g_board[91] = BR; g_board[92] = BN; g_board[93] = BB; g_board[94] = BQ;
    g_board[95] = BK; g_board[96] = BB; g_board[97] = BN; g_board[98] = BR;
    var f2: i32 = 0;
    while f2 < 8 {
        g_board[31 + f2] = WP;
        g_board[81 + f2] = BP;
        f2 = f2 + 1;
    }
    g_side = WHITE;
    g_ep = 0;
    g_castle = 15;
    g_fifty = 0;
    g_hply = 0;
    g_ksq[WHITE] = 25;
    g_ksq[BLACK] = 95;
    g_key = recompute_key();
}

// ---------------- attack detection ----------------

fn sq_attacked(sq: i32, atk: i32) -> i32 {
    if atk == WHITE {
        if g_board[sq - 9] == WP || g_board[sq - 11] == WP { return 1; }
    } else {
        if g_board[sq + 9] == BP || g_board[sq + 11] == BP { return 1; }
    }
    let n: i32 = WN + atk * 6;
    var i: i32 = 0;
    while i < 8 {
        if g_board[sq + g_kdir[i]] == n { return 1; }
        i = i + 1;
    }
    let k: i32 = WK + atk * 6;
    i = 0;
    while i < 8 {
        if g_board[sq + g_kingd[i]] == k { return 1; }
        i = i + 1;
    }
    let b: i32 = WB + atk * 6;
    let q: i32 = WQ + atk * 6;
    i = 0;
    while i < 4 {
        var t: i32 = sq + g_bdir[i];
        while g_board[t] != OFF {
            let p: i32 = g_board[t];
            if p != EMPTY {
                if p == b || p == q { return 1; }
                break;
            }
            t = t + g_bdir[i];
        }
        i = i + 1;
    }
    let rk: i32 = WR + atk * 6;
    i = 0;
    while i < 4 {
        var t: i32 = sq + g_rdir[i];
        while g_board[t] != OFF {
            let p: i32 = g_board[t];
            if p != EMPTY {
                if p == rk || p == q { return 1; }
                break;
            }
            t = t + g_rdir[i];
        }
        i = i + 1;
    }
    return 0;
}

fn in_check(side: i32) -> i32 {
    return sq_attacked(g_ksq[side], 1 - side);
}

fn sq_attackers(sq: i32, atk: i32) -> i32 {
    var c: i32 = 0;
    if atk == WHITE {
        if g_board[sq - 9] == WP { c = c + 1; }
        if g_board[sq - 11] == WP { c = c + 1; }
    } else {
        if g_board[sq + 9] == BP { c = c + 1; }
        if g_board[sq + 11] == BP { c = c + 1; }
    }
    let n: i32 = WN + atk * 6;
    var i: i32 = 0;
    while i < 8 { if g_board[sq + g_kdir[i]] == n { c = c + 1; } i = i + 1; }
    let k: i32 = WK + atk * 6;
    i = 0;
    while i < 8 { if g_board[sq + g_kingd[i]] == k { c = c + 1; } i = i + 1; }
    let b: i32 = WB + atk * 6;
    let q: i32 = WQ + atk * 6;
    i = 0;
    while i < 4 {
        var t: i32 = sq + g_bdir[i];
        while g_board[t] != OFF {
            let p: i32 = g_board[t];
            if p != EMPTY {
                if p == b || p == q { c = c + 1; }
                break;
            }
            t = t + g_bdir[i];
        }
        i = i + 1;
    }
    let rk: i32 = WR + atk * 6;
    i = 0;
    while i < 4 {
        var t2: i32 = sq + g_rdir[i];
        while g_board[t2] != OFF {
            let p2: i32 = g_board[t2];
            if p2 != EMPTY {
                if p2 == rk || p2 == q { c = c + 1; }
                break;
            }
            t2 = t2 + g_rdir[i];
        }
        i = i + 1;
    }
    return c;
}

// ---------------- move encoding ----------------

fn mk_move(from: i32, to: i32, cap: i32, promo: i32, flags: i32) -> i32 {
    return from | (to << 7) | (cap << 14) | (promo << 18) | (flags << 22);
}
fn m_from(m: i32) -> i32 { return m & 127; }
fn m_to(m: i32) -> i32 { return (m >> 7) & 127; }
fn m_cap(m: i32) -> i32 { return (m >> 14) & 15; }
fn m_promo(m: i32) -> i32 { return (m >> 18) & 15; }
fn m_flags(m: i32) -> i32 { return (m >> 22) & 7; }

// ---------------- move generation ----------------

fn score_capture(m: i32) -> i32 {
    let cap: i32 = m_cap(m);
    let pr: i32 = m_promo(m);
    var s: i32 = 0;
    if cap != EMPTY {
        s = 1000000 + g_pval[cap] * 16 - g_pval[g_board[m_from(m)]] / 16;
    }
    if pr != EMPTY {
        s = s + 900000 + g_pval[pr];
    }
    if m_flags(m) == MF_EP {
        s = 1000000 + 100 * 16;
    }
    return s;
}

fn add_move(idx: i32, m: i32, ply: i32) -> i32 {
    g_mv[idx] = m;
    var s: i32 = 0;
    if m == g_ttmove {
        s = 2000000;
    } else {
        s = score_capture(m);
        if s == 0 {
            if m == g_killer1[ply] { s = 900000; }
            else if m == g_killer2[ply] { s = 800000; }
            else {
                s = g_hist[m_from(m) * 120 + m_to(m)];
            }
        }
    }
    g_msc[idx] = s;
    return idx + 1;
}

fn add_pawn_move(idx: i32, from: i32, to: i32, cap: i32, flags: i32, ply: i32, side: i32) -> i32 {
    let lastrow: i32 = 9 - side * 7;     // white promotes on row 9, black on row 2
    if to / 10 == lastrow {
        let base: i32 = WQ + side * 6;
        var i2: i32 = idx;
        i2 = add_move(i2, mk_move(from, to, cap, base, flags), ply);
        i2 = add_move(i2, mk_move(from, to, cap, base - 1, flags), ply);
        i2 = add_move(i2, mk_move(from, to, cap, base - 2, flags), ply);
        i2 = add_move(i2, mk_move(from, to, cap, base - 3, flags), ply);
        return i2;
    }
    return add_move(idx, mk_move(from, to, cap, EMPTY, flags), ply);
}

fn gen_moves(ply: i32, caps_only: i32) {
    var idx: i32 = g_first[ply];
    let side: i32 = g_side;
    let fwd: i32 = 10 - side * 20;       // white +10, black -10
    let mylo: i32 = 1 + side * 6;        // my piece range
    let myhi: i32 = 6 + side * 6;

    var sq: i32 = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if p >= mylo && p <= myhi {
            let kind: i32 = p - side * 6;    // 1..6 white-relative

            if kind == WP {
                var d: i32 = fwd - 1;
                var c: i32 = g_board[sq + d];
                if c != OFF && c != EMPTY && piece_side(c) != side {
                    idx = add_pawn_move(idx, sq, sq + d, c, 0, ply, side);
                }
                if g_ep != 0 && sq + d == g_ep {
                    idx = add_move(idx, mk_move(sq, g_ep, EMPTY, EMPTY, MF_EP), ply);
                }
                d = fwd + 1;
                c = g_board[sq + d];
                if c != OFF && c != EMPTY && piece_side(c) != side {
                    idx = add_pawn_move(idx, sq, sq + d, c, 0, ply, side);
                }
                if g_ep != 0 && sq + d == g_ep {
                    idx = add_move(idx, mk_move(sq, g_ep, EMPTY, EMPTY, MF_EP), ply);
                }
                if g_board[sq + fwd] == EMPTY {
                    let promorow: i32 = 9 - side * 7;
                    if caps_only == 0 || (sq + fwd) / 10 == promorow {
                        idx = add_pawn_move(idx, sq, sq + fwd, EMPTY, 0, ply, side);
                    }
                    let homerow: i32 = 3 + side * 5;     // white row 3, black row 8
                    if caps_only == 0 && sq / 10 == homerow && g_board[sq + fwd + fwd] == EMPTY {
                        idx = add_move(idx, mk_move(sq, sq + fwd + fwd, EMPTY, EMPTY, MF_DOUBLE), ply);
                    }
                }
            } else if kind == WN || kind == WK {
                var i: i32 = 0;
                while i < 8 {
                    var t: i32 = sq;
                    if kind == WN { t = t + g_kdir[i]; }
                    else { t = t + g_kingd[i]; }
                    let c2: i32 = g_board[t];
                    if c2 != OFF {
                        if c2 == EMPTY {
                            if caps_only == 0 {
                                idx = add_move(idx, mk_move(sq, t, EMPTY, EMPTY, 0), ply);
                            }
                        } else if piece_side(c2) != side {
                            idx = add_move(idx, mk_move(sq, t, c2, EMPTY, 0), ply);
                        }
                    }
                    i = i + 1;
                }
            } else {
                var di: i32 = 0;
                var dn: i32 = 4;
                if kind == WQ { dn = 8; }
                while di < dn {
                    var dv: i32 = 0;
                    if kind == WB { dv = g_bdir[di]; }
                    else if kind == WR { dv = g_rdir[di]; }
                    else {
                        if di < 4 { dv = g_bdir[di]; } else { dv = g_rdir[di - 4]; }
                    }
                    var t2: i32 = sq + dv;
                    while g_board[t2] != OFF {
                        let c3: i32 = g_board[t2];
                        if c3 == EMPTY {
                            if caps_only == 0 {
                                idx = add_move(idx, mk_move(sq, t2, EMPTY, EMPTY, 0), ply);
                            }
                        } else {
                            if piece_side(c3) != side {
                                idx = add_move(idx, mk_move(sq, t2, c3, EMPTY, 0), ply);
                            }
                            break;
                        }
                        t2 = t2 + dv;
                    }
                    di = di + 1;
                }
            }
        }
        sq = sq + 1;
    }

    if caps_only == 0 {
        if side == WHITE {
            if (g_castle & CWK) != 0
               && g_board[25] == WK && g_board[28] == WR
               && g_board[26] == EMPTY && g_board[27] == EMPTY
               && sq_attacked(25, BLACK) == 0 && sq_attacked(26, BLACK) == 0
               && sq_attacked(27, BLACK) == 0 {
                idx = add_move(idx, mk_move(25, 27, EMPTY, EMPTY, MF_CASTLE), ply);
            }
            if (g_castle & CWQ) != 0
               && g_board[25] == WK && g_board[21] == WR
               && g_board[24] == EMPTY && g_board[23] == EMPTY && g_board[22] == EMPTY
               && sq_attacked(25, BLACK) == 0 && sq_attacked(24, BLACK) == 0
               && sq_attacked(23, BLACK) == 0 {
                idx = add_move(idx, mk_move(25, 23, EMPTY, EMPTY, MF_CASTLE), ply);
            }
        } else {
            if (g_castle & CBK) != 0
               && g_board[95] == BK && g_board[98] == BR
               && g_board[96] == EMPTY && g_board[97] == EMPTY
               && sq_attacked(95, WHITE) == 0 && sq_attacked(96, WHITE) == 0
               && sq_attacked(97, WHITE) == 0 {
                idx = add_move(idx, mk_move(95, 97, EMPTY, EMPTY, MF_CASTLE), ply);
            }
            if (g_castle & CBQ) != 0
               && g_board[95] == BK && g_board[91] == BR
               && g_board[94] == EMPTY && g_board[93] == EMPTY && g_board[92] == EMPTY
               && sq_attacked(95, WHITE) == 0 && sq_attacked(94, WHITE) == 0
               && sq_attacked(93, WHITE) == 0 {
                idx = add_move(idx, mk_move(95, 93, EMPTY, EMPTY, MF_CASTLE), ply);
            }
        }
    }

    g_first[ply + 1] = idx;
}

// ---------------- make / unmake ----------------

fn make_move(m: i32) -> i32 {
    let from: i32 = m_from(m);
    let to: i32 = m_to(m);
    let flags: i32 = m_flags(m);
    let side: i32 = g_side;
    let p: i32 = g_board[from];
    let cap0: i32 = g_board[to];

    g_h_move[g_hply] = m;
    g_h_cap[g_hply] = g_board[to];
    g_h_castle[g_hply] = g_castle;
    g_h_ep[g_hply] = g_ep;
    g_h_fifty[g_hply] = g_fifty;
    g_h_key[g_hply] = g_key;
    g_hply = g_hply + 1;

    g_key = g_key ^ g_zcastle[g_castle];          // xor OUT old castle/ep state
    if g_ep != 0 { g_key = g_key ^ g_zep[g_ep]; }

    g_fifty = g_fifty + 1;
    if p == WP || p == BP || g_board[to] != EMPTY { g_fifty = 0; }

    if g_board[to] != EMPTY {
        g_key = g_key ^ g_zpiece[g_board[to] * 120 + to];
        g_board[to] = EMPTY;
    }
    if flags == MF_EP {
        var capsq: i32 = to - 10;
        if side == BLACK { capsq = to + 10; }
        g_key = g_key ^ g_zpiece[g_board[capsq] * 120 + capsq];
        g_board[capsq] = EMPTY;
    }

    g_key = g_key ^ g_zpiece[p * 120 + from];
    g_board[from] = EMPTY;
    var placed: i32 = p;
    if m_promo(m) != EMPTY { placed = m_promo(m); }
    g_board[to] = placed;
    g_key = g_key ^ g_zpiece[placed * 120 + to];

    if p == WK { g_ksq[WHITE] = to; }
    if p == BK { g_ksq[BLACK] = to; }

    if flags == MF_CASTLE {
        if to == 27 {
            g_board[28] = EMPTY; g_board[26] = WR;
            g_key = g_key ^ g_zpiece[WR * 120 + 28] ^ g_zpiece[WR * 120 + 26];
        } else if to == 23 {
            g_board[21] = EMPTY; g_board[24] = WR;
            g_key = g_key ^ g_zpiece[WR * 120 + 21] ^ g_zpiece[WR * 120 + 24];
        } else if to == 97 {
            g_board[98] = EMPTY; g_board[96] = BR;
            g_key = g_key ^ g_zpiece[BR * 120 + 98] ^ g_zpiece[BR * 120 + 96];
        } else {
            g_board[91] = EMPTY; g_board[94] = BR;
            g_key = g_key ^ g_zpiece[BR * 120 + 91] ^ g_zpiece[BR * 120 + 94];
        }
    }

    g_castle = g_castle & g_crights[from] & g_crights[to];
    g_ep = 0;
    if flags == MF_DOUBLE {
        g_ep = from + 10 - side * 20;
    }
    g_key = g_key ^ g_zcastle[g_castle];          // xor IN new castle/ep state
    if g_ep != 0 { g_key = g_key ^ g_zep[g_ep]; }

    g_side = 1 - g_side;
    g_key = g_key ^ g_zside;

    if g_nnue_on == 1 { nn_make(side, from, to, flags, p, cap0); }

    if in_check(side) == 1 {
        unmake_move();
        return 0;
    }
    return 1;
}

fn unmake_move() {
    g_hply = g_hply - 1;
    let m: i32 = g_h_move[g_hply];
    let from: i32 = m_from(m);
    let to: i32 = m_to(m);
    let flags: i32 = m_flags(m);

    g_side = 1 - g_side;
    let side: i32 = g_side;

    g_castle = g_h_castle[g_hply];
    g_ep = g_h_ep[g_hply];
    g_fifty = g_h_fifty[g_hply];
    g_key = g_h_key[g_hply];

    var p: i32 = g_board[to];
    let placed: i32 = p;
    let cap: i32 = g_h_cap[g_hply];
    if m_promo(m) != EMPTY {
        p = WP + side * 6;
    }
    g_board[from] = p;
    g_board[to] = g_h_cap[g_hply];

    if flags == MF_EP {
        var capsq: i32 = to - 10;
        if side == BLACK { capsq = to + 10; }
        g_board[capsq] = BP - side * 6;
    }

    if flags == MF_CASTLE {
        if to == 27 { g_board[28] = WR; g_board[26] = EMPTY; }
        else if to == 23 { g_board[21] = WR; g_board[24] = EMPTY; }
        else if to == 97 { g_board[98] = BR; g_board[96] = EMPTY; }
        else { g_board[91] = BR; g_board[94] = EMPTY; }
    }

    if p == WK { g_ksq[WHITE] = from; }
    if p == BK { g_ksq[BLACK] = from; }

    if g_nnue_on == 1 { nn_unmake(side, from, to, flags, p, cap, placed); }
}

fn make_null() {
    g_h_ep[g_hply] = g_ep;
    g_h_key[g_hply] = g_key;
    g_hply = g_hply + 1;
    if g_ep != 0 { g_key = g_key ^ g_zep[g_ep]; }  // ep right dies on a null move
    g_ep = 0;
    g_side = 1 - g_side;
    g_key = g_key ^ g_zside;
    if g_nnue_on == 1 {                            // null ply: empty delta, lazy chain
        g_nn_dn[g_hply] = 0;
        g_nn_km[g_hply * 2] = 0; g_nn_km[g_hply * 2 + 1] = 0;
        g_nn_ok[g_hply * 2] = 0; g_nn_ok[g_hply * 2 + 1] = 0;
        g_nn_acc = &g_nn_accs[g_hply * 2 * NN_H];
    }
}

fn unmake_null() {
    g_hply = g_hply - 1;
    g_side = 1 - g_side;
    g_ep = g_h_ep[g_hply];
    g_key = g_h_key[g_hply];
    if g_nnue_on == 1 { g_nn_acc = &g_nn_accs[g_hply * 2 * NN_H]; }
}

// ================= nn eval =================
let NN_NPTF: i32 = 10;
let NN_NFH: i32 = 40960;           // 64 * NN_NPTF * 64
let NN_H: i32 = 256;               // per-perspective hidden width (v2: int16 FT / int8 heads)
let NN_QMAX: i64 = 127;            // crelu clamp
let NN_K: i32 = 4;                 // expert count
let NN_BAND: i32 = 1600;           // npmat width per band (startpos ~6400 -> band 3)
let NN_BLEND: i32 = 0;
let NN_BLEND_SHIFT: i32 = 0;
// v2 quantization policy (pinned; written into saved headers, checked on load):
// weight = round_half_away(float * 2^k) clamped to +/-q. k=0: the float trainer
// works at integer scale. QFT=127 keeps the boundcheck certificate (32*127<2^12).
let NN_KFT: i64 = 0;               // FT scale exponent
let NN_KW2: i64 = 0;               // head scale exponent
let NN_QFT: i64 = 127;             // FT clamp (int8-range values in int16 storage)
let NN_QW2: i64 = 127;             // head clamp (int8)
let NN_REP_SHIFT: i32 = 0;         // eval-replacement: net scale-down
// runtime eval mode: 0 classical, 1 blend (classical+nn), 2 replace
// (exact material + nn positional). set via `nnue mode`; self-play/search honor it.
var g_eval_mode: i32 = 0;
// v2 storage: FT int16 FEATURE-major (ft[f*NN_H+h]), heads int8, acc int16.
// Lane bound: <=32 active features x max|w|<=127 -> |acc| < 4096 (`nnue boundcheck`).
var g_nn_ft: *i16 = null;          // NN_NFH * NN_H shared feature transformer, feature-major
var g_nn_w2: *i8 = null;
var g_nn_acc: *i16 = null;
var g_nn_tmp: *i16 = null;         // 2*NN_H recompute-compare scratch
var g_nn_dft: *i64 = null;         // trainer grads: NOT allocated in the v2 build (train refuses)
var g_nn_dw2: *i64 = null;
// finny table: per (perspective, own-king-sq64) cached accumulator + board
// snapshot; a king-move refresh DIFFS against the cache instead of rebuilding
var g_fin_acc: *i16 = null;        // 2 * 64 * NN_H
var g_fin_board: *i8 = null;       // 2 * 64 * 120
var g_fin_ok: *i8 = null;          // 2 * 64 validity flags (flushed on weight change)
// per-ply accumulator stack: make copies the parent slab + applies deltas;
// unmake is a POINTER RETREAT (zero column work). g_nn_acc aims at slab g_hply.
var g_nn_accs: *i16 = null;        // 1032 * 2 * NN_H slabs, indexed by g_hply
var g_c_cpy: i64 = 0;              // slab copies (the make-side cost of free unmake)
// nncnt probe: per-search NN work counters (columns / refreshes / evals),
// columns attributed by cause: make-direction / unmake-direction / refresh
var g_c_col: i64 = 0;
var g_c_rec: i64 = 0;
var g_c_eval: i64 = 0;
var g_c_col_mk: i64 = 0;
var g_c_col_un: i64 = 0;
var g_c_col_rf: i64 = 0;
var g_c_attr: i32 = 0;         // 0=make 1=unmake 2=refresh (set by callers)
// on-demand accumulators: nn_make records a dirty DELTA (piece/sq ops + a
// per-side king-move flag) and invalidates the ply's slab; the slab half
// materializes only when nn_eval needs it (nn_ensure_persp: walk back to a
// valid slab and replay deltas; a king barrier / long walk / no valid ancestor
// falls back to a finny refresh from the CURRENT board — self-healing).
var g_nn_ok: *i8 = null;           // 1032*2 (ply,persp) slab-half validity
var g_nn_dn: *i8 = null;           // 1032 delta op counts (<=5)
var g_nn_dpc: *i8 = null;          // 1032*5 op piece (never a king)
var g_nn_dsq: *i8 = null;          // 1032*5 op square (120-board)
var g_nn_dsg: *i8 = null;          // 1032*5 op sign: 1 add / 0 sub
var g_nn_km: *i8 = null;           // 1032*2 king-move flag (the make INTO ply i)
var g_nn_walkcap: i32 = 8;         // max walk length (measured plateau: walks never
                                   // exceed ~depth; refreshes = king barriers only)
var g_nn_oracle: i32 = 0;          // `nnue oracle 1`: recompute-verify every nn_eval
var g_c_ens: i64 = 0;              // ensure materializations (walks)
// eval cache + lazy nn margin: classical caches ALWAYS (pure f(position));
// the raw nn output caches in a second slot filled only when the window
// demands precision. Lazy skip (blend only): classical outside
// [alpha-M, beta+M] with M = lz_a + |classical|>>lz_b (the measured
// correction envelope: near-even positions carry small corrections) skips
// the forward pass AND the accumulator materialization behind it.
let EVC_SIZE: i32 = 131072;        // 2^17 direct-mapped entries
var g_ev_key: *i64 = null;
var g_ev_cls: *i32 = null;         // stm-relative classical (incl. tempo)
var g_ev_nn: *i32 = null;          // raw nn_eval (pre-shift)
var g_ev_has: *i8 = null;          // 0 empty / 1 cls / 2 cls+nn
var g_lz_a: i32 = 100;             // lazy margin base (cp); <0 disables skipping
var g_lz_b: i32 = 2;               // proportional term: + |classical| >> lz_b
var g_c_lzhi: i64 = 0;             // lazy skips, fail-high side
var g_c_lzlo: i64 = 0;             // lazy skips, fail-low side
var g_c_ehit: i64 = 0;             // eval-cache classical hits
var g_c_enn: i64 = 0;              // eval-cache nn hits

fn material_stm() -> i32 {                    // signed material (side-to-move), cp
    var m: i32 = 0;
    var sq: i32 = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if p != EMPTY { if p != OFF {
            if piece_side(p) == WHITE { m = m + g_pval[p]; } else { m = m - g_pval[p]; }
        } }
        sq = sq + 1;
    }
    if g_side == WHITE { return m; }
    return 0 - m;
}
fn nn_npmat() -> i32 {
    var npm: i32 = 0;
    var sq: i32 = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if p != EMPTY { if p != OFF {
            let kind: i32 = p - piece_side(p) * 6;
            if kind != WP { if kind != WK { npm = npm + g_pval[p]; } }
        } }
        sq = sq + 1;
    }
    return npm;
}
fn nn_route() -> i32 {
    var e: i32 = nn_npmat() / NN_BAND;
    if e < 0 { e = 0; }
    if e >= NN_K { e = NN_K - 1; }
    return e;
}
var g_nnue_on: i32 = 0;

fn nn_pt(p: i32) -> i32 {
    if p == WP { return 0; }  if p == WN { return 1; }  if p == WB { return 2; }
    if p == WR { return 3; }  if p == WQ { return 4; }
    if p == BP { return 5; }  if p == BN { return 6; }  if p == BB { return 7; }
    if p == BR { return 8; }  if p == BQ { return 9; }
    return 0 - 1;
}
fn nn_feat(persp: i32, p: i32, sq: i32) -> i32 {
    let t: i32 = nn_pt(p);                       // absolute 0..9 (WP..WQ, BP..BQ)
    var trel: i32 = t % 5;                       // P N B R Q, color stripped
    var own: i32 = 0;
    if t < 5 { if persp == WHITE { own = 1; } } else { if persp == BLACK { own = 1; } }
    if own == 0 { trel = trel + 5; }
    var ksq: i32 = sq64(g_ksq[persp]);
    var psq: i32 = sq64(sq);
    if persp == BLACK { ksq = ksq ^ 56; psq = psq ^ 56; }
    return ksq * (NN_NPTF * 64) + trel * 64 + psq;
}

fn nn_wmix(x: i64) -> i64 {
    var z: i64 = x * 2654435761 + 2246822519;
    z = z ^ (z >> 15); z = z * 40503;
    z = z ^ (z >> 13); z = z * 3266489917;
    z = z ^ (z >> 16);
    return z;
}
fn nn_posmod(a: i64, m: i64) -> i64 { var r: i64 = a % m; if r < 0 { r = r + m; } return r; }
fn nn_init_weights() {
    nn_fin_flush();
    let ftp: *i16 = g_nn_ft;
    var h: i32 = 0;
    while h < NN_H {
        var f: i32 = 0;
        while f < NN_NFH {
            if g_onebit == 1 { ftp[f * NN_H + h] = nn_posmod(nn_wmix((h as i64) * 100003 + (f as i64)), 3) - 1; }
            else { ftp[f * NN_H + h] = nn_posmod(nn_wmix((h as i64) * 100003 + (f as i64)), 17) - 8; }
            f = f + 1;
        }
        h = h + 1;
    }
    var j: i32 = 0;
    while j < NN_K * 2 * NN_H {
        if g_onebit == 1 { g_nn_w2[j] = nn_posmod(nn_wmix(7777 + (j as i64)), 3) - 1; }
        else { g_nn_w2[j] = nn_posmod(nn_wmix(7777 + (j as i64)), 9) - 4; }
        j = j + 1;
    }
}

// pointers AND the bound hoisted to locals: a global reloaded per iteration
// (pointer or trip count) is a phantom clobber — blocks LICM + vectorization
fn nn_col_count() {
    g_c_col = g_c_col + 1;
    if g_c_attr == 0 { g_c_col_mk = g_c_col_mk + 1; }
    else { if g_c_attr == 1 { g_c_col_un = g_c_col_un + 1; } else { g_c_col_rf = g_c_col_rf + 1; } }
}
fn nn_col_add_at(dst: *i16, db: i32, f: i32) { nn_col_count(); let w: *i16 = g_nn_ft; let nh: i32 = NN_H; let wb: i32 = f * nh; var h: i32 = 0; while h < nh { dst[db + h] = dst[db + h] + w[wb + h]; h = h + 1; } }
fn nn_col_sub_at(dst: *i16, db: i32, f: i32) { nn_col_count(); let w: *i16 = g_nn_ft; let nh: i32 = NN_H; let wb: i32 = f * nh; var h: i32 = 0; while h < nh { dst[db + h] = dst[db + h] - w[wb + h]; h = h + 1; } }
fn nn_acc_add(persp: i32, f: i32) { nn_col_add_at(g_nn_acc, persp * NN_H, f); }
fn nn_acc_sub(persp: i32, f: i32) { nn_col_sub_at(g_nn_acc, persp * NN_H, f); }

fn nn_inval_all() {                // every slab half stale (weights/position reset)
    if g_nn_ok == null { return; }
    var i: i32 = 0; while i < 1032 * 2 { g_nn_ok[i] = 0; i = i + 1; }
}
fn evc_clear() {                   // eval cache: weights/eval-shape changed
    if g_ev_has == null { return; }
    var i: i32 = 0; while i < EVC_SIZE { g_ev_has[i] = 0; i = i + 1; }
}
fn nn_fin_flush() {
    nn_inval_all();
    evc_clear();
    if g_fin_ok == null { return; }
    var i: i32 = 0; while i < 128 { g_fin_ok[i] = 0; i = i + 1; }
}

// rebuild ONE perspective (HalfKP keys on the OWN king; kings are not features,
// so the opponent's half is invariant under a king move — never rebuild both)
fn nn_recompute_persp(persp: i32) {
    g_c_rec = g_c_rec + 1;
    g_c_attr = 2;
    let a: *i16 = g_nn_acc;
    let nh: i32 = NN_H;
    let ab: i32 = persp * nh;
    var i: i32 = 0; while i < nh { a[ab + i] = 0; i = i + 1; }
    var sq: i32 = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if nn_pt(p) >= 0 { nn_acc_add(persp, nn_feat(persp, p, sq)); }
        sq = sq + 1;
    }
    g_nn_ok[g_hply * 2 + persp] = 1;
}
fn nn_recompute_all() {
    if g_nn_accs != null { g_nn_acc = &g_nn_accs[g_hply * 2 * NN_H]; }
    nn_recompute_persp(WHITE);
    nn_recompute_persp(BLACK);
}

// king-move refresh through the finny table: seed on miss (ground-truth build
// into the cache), DIFF the board snapshot on hit (typically 1-4 columns),
// then copy the cached half into the live accumulator.
fn nn_refresh_persp(persp: i32) {
    if g_fin_acc == null { nn_recompute_persp(persp); return; }
    g_c_rec = g_c_rec + 1;
    g_c_attr = 2;
    let k64: i32 = sq64(g_ksq[persp]);
    let ei: i32 = persp * 64 + k64;
    let ab: i32 = ei * NN_H;
    let bb: i32 = ei * 120;
    let fa: *i16 = g_fin_acc;
    let fb: *i8 = g_fin_board;
    if g_fin_ok[ei] == 0 {
        let nh: i32 = NN_H;
        var i: i32 = 0; while i < nh { fa[ab + i] = 0; i = i + 1; }
        var sq: i32 = 21;
        while sq <= 98 {
            let p: i32 = g_board[sq];
            if nn_pt(p) >= 0 { nn_col_add_at(fa, ab, nn_feat(persp, p, sq)); }
            sq = sq + 1;
        }
        g_fin_ok[ei] = 1;
    } else {
        var sq: i32 = 21;
        while sq <= 98 {
            let old: i32 = fb[bb + sq] as i32;
            let new: i32 = g_board[sq];
            if old != new {
                if nn_pt(old) >= 0 { nn_col_sub_at(fa, ab, nn_feat(persp, old, sq)); }
                if nn_pt(new) >= 0 { nn_col_add_at(fa, ab, nn_feat(persp, new, sq)); }
            }
            sq = sq + 1;
        }
    }
    var s2: i32 = 0; while s2 < 120 { fb[bb + s2] = g_board[s2] as i8; s2 = s2 + 1; }
    let a: *i16 = g_nn_acc;
    let lb: i32 = persp * NN_H;
    let nh2: i32 = NN_H;
    var h: i32 = 0; while h < nh2 { a[lb + h] = fa[ab + h]; h = h + 1; }
    g_nn_ok[g_hply * 2 + persp] = 1;
}

fn nn_crelu(x: i64) -> i64 { if x < 0 { return 0; } if x > NN_QMAX { return NN_QMAX; } return x; }
fn nn_catval(j: i32) -> i64 {
    if j < NN_H { return g_nn_acc[g_side * NN_H + j]; }
    return g_nn_acc[(1 - g_side) * NN_H + (j - NN_H)];
}
fn nn_eval() -> i64 {
    nn_ensure_persp(WHITE);
    nn_ensure_persp(BLACK);
    if g_nn_oracle == 1 {
        if nn_equal_recompute() == 0 { wr(1, "ORACLE FAIL lazy-acc != recompute\n"); exit(1); }
    }
    g_c_eval = g_c_eval + 1;
    let nh: i32 = NN_H;
    let base: i32 = nn_route() * 2 * nh;         // hard top-1: the routed expert's head
    let w: *i8 = g_nn_w2;
    let a: *i16 = g_nn_acc;
    let s0: i32 = g_side * nh;                   // stm half first, then opponent half
    let s1: i32 = (1 - g_side) * nh;
    var s: i64 = 0; var j: i32 = 0;
    while j < nh { s = s + (w[base + j] as i64) * nn_crelu(a[s0 + j] as i64); j = j + 1; }
    j = 0;
    while j < nh { s = s + (w[base + nh + j] as i64) * nn_crelu(a[s1 + j] as i64); j = j + 1; }
    return s;
}
fn nn_equal_recompute() -> i32 {
    nn_ensure_persp(WHITE);                      // materialize, THEN compare vs ground truth
    nn_ensure_persp(BLACK);
    var i: i32 = 0; while i < 2 * NN_H { g_nn_tmp[i] = g_nn_acc[i]; i = i + 1; }
    nn_recompute_all();
    var ok: i32 = 1;
    i = 0; while i < 2 * NN_H { if g_nn_tmp[i] != g_nn_acc[i] { ok = 0; } i = i + 1; }
    i = 0; while i < 2 * NN_H { g_nn_acc[i] = g_nn_tmp[i]; i = i + 1; }
    return ok;
}

// ordering prior: EXACT child nn_eval from the parent accumulators, O(H) per move.
// quiet-branch only (captures/promos/EP score >=800k and never reach it); king
// moves abstain (king square shifts every feature). child stm = 1-side, so the
// head's first half reads the non-mover perspective. returns child-stm value.
// (the `nnue order` prior + its feature-major transpose retired 2026-07-16:
//  instrument-refused vs the deployed ordering baseline; layout is now feature-major natively)

// ---- on-demand accumulator maintenance: make RECORDS, eval MATERIALIZES ----
fn nn_rec_op(hp: i32, pc: i32, sq: i32, sg: i32) {
    let base: i32 = hp * 5;
    let n: i32 = g_nn_dn[hp] as i32;
    g_nn_dpc[base + n] = pc as i8;
    g_nn_dsq[base + n] = sq as i8;
    g_nn_dsg[base + n] = sg as i8;
    g_nn_dn[hp] = (n + 1) as i8;
}
fn nn_make(side: i32, from: i32, to: i32, flags: i32, p: i32, cap: i32) {
    let hp: i32 = g_hply;                        // this ply (g_hply already advanced)
    g_nn_dn[hp] = 0;
    g_nn_km[hp * 2] = 0; g_nn_km[hp * 2 + 1] = 0;
    g_nn_ok[hp * 2] = 0; g_nn_ok[hp * 2 + 1] = 0;
    g_nn_acc = &g_nn_accs[hp * 2 * NN_H];
    if p == WK || p == BK {
        // mover re-keys (own-king move) -> walk barrier for the mover persp;
        // the opponent half only sees capture removal / castle rook relocation
        var mover: i32 = WHITE; if p == BK { mover = BLACK; }
        g_nn_km[hp * 2 + mover] = 1;
        if cap != EMPTY { nn_rec_op(hp, cap, to, 0); }
        if flags == MF_CASTLE {
            if to == 27 { nn_rec_op(hp, WR, 28, 0); nn_rec_op(hp, WR, 26, 1); }
            if to == 23 { nn_rec_op(hp, WR, 21, 0); nn_rec_op(hp, WR, 24, 1); }
            if to == 97 { nn_rec_op(hp, BR, 98, 0); nn_rec_op(hp, BR, 96, 1); }
            if to == 93 { nn_rec_op(hp, BR, 91, 0); nn_rec_op(hp, BR, 94, 1); }
        }
        return;
    }
    nn_rec_op(hp, p, from, 0);
    if cap != EMPTY { nn_rec_op(hp, cap, to, 0); }
    if flags == MF_EP {
        var capsq: i32 = to - 10;
        if side == BLACK { capsq = to + 10; }
        nn_rec_op(hp, BP - side * 6, capsq, 0);
    }
    nn_rec_op(hp, g_board[to], to, 1);           // placed (promotion-aware)
}
fn nn_unmake(side: i32, from: i32, to: i32, flags: i32, p: i32, cap: i32, placed: i32) {
    // per-ply acc stack: the parent slab is intact — retreat the pointer.
    g_nn_acc = &g_nn_accs[g_hply * 2 * NN_H];
}
// materialize the persp half of slab g_hply: nearest valid ancestor + forward
// delta replay (feature indices valid: no persp-king move crosses the walk, so
// g_ksq[persp] is constant over it); barrier/long-walk/no-ancestor -> finny
// refresh from the CURRENT board (ground truth, no chain dependency).
fn nn_ensure_persp(persp: i32) {
    let k: i32 = g_hply;
    if g_nn_ok[k * 2 + persp] == 1 { return; }
    var src: i32 = 0 - 1;
    var i: i32 = k;
    let lo: i32 = k - g_nn_walkcap;
    while i > 0 && i > lo {
        if g_nn_km[i * 2 + persp] == 1 { break; }         // king barrier at make->ply i
        if g_nn_ok[(i - 1) * 2 + persp] == 1 { src = i - 1; break; }
        i = i - 1;
    }
    if src < 0 { nn_refresh_persp(persp); return; }
    g_c_ens = g_c_ens + 1;
    g_c_attr = 0;
    let accs: *i16 = g_nn_accs;
    let nh: i32 = NN_H;
    var j: i32 = src + 1;
    while j <= k {
        let sb: i32 = (j - 1) * 2 * nh + persp * nh;
        let db: i32 = j * 2 * nh + persp * nh;
        g_c_cpy = g_c_cpy + 1;
        var ci: i32 = 0; while ci < nh { accs[db + ci] = accs[sb + ci]; ci = ci + 1; }
        let nops: i32 = g_nn_dn[j] as i32;
        let ob: i32 = j * 5;
        var oi: i32 = 0;
        while oi < nops {
            let f: i32 = nn_feat(persp, g_nn_dpc[ob + oi] as i32, g_nn_dsq[ob + oi] as i32);
            if g_nn_dsg[ob + oi] as i32 == 1 { nn_col_add_at(accs, db, f); }
            else { nn_col_sub_at(accs, db, f); }
            oi = oi + 1;
        }
        g_nn_ok[j * 2 + persp] = 1;
        j = j + 1;
    }
}

// ---- live in-engine gate: incremental == recompute + make/unmake round-trip ----
fn nnue_selftest(nply: i32) {
    if 2 * NN_H > 512 { wr(1, "fatal: selftest snap scratch < 2*NN_H\n"); exit(1); }
    g_first[0] = 0;
    g_nnue_on = 1;
    nn_recompute_all();
    var rng: i64 = 0x2545F4914F6CDD1D;
    var snap: [i64; 512] = 0;                 // 2*NN_H accumulator snapshot (sized up to 512)
    var fails_inc: i32 = 0;
    var fails_rt: i32 = 0;
    var fails_key: i32 = 0;                   // incremental zobrist == recompute
    var made: i32 = 0;                        // moves kept (for the unwind)
    var plies: i32 = 0;
    while plies < nply {
        gen_moves(0, 0);
        let lo: i32 = g_first[0];
        let hi: i32 = g_first[1];
        let cnt: i32 = hi - lo;
        if cnt <= 0 { plies = nply; }
        else {
            rng = rng ^ (rng << 13); rng = rng ^ (rng >> 7); rng = rng ^ (rng << 17);
            var rr: i64 = rng; if rr < 0 { rr = 0 - rr; }
            let off: i32 = (rr % (cnt as i64)) as i32;
            var picked: i32 = 0;
            var s: i32 = 0;
            while s < cnt && picked == 0 {
                let mv: i32 = g_mv[lo + (off + s) % cnt];
                var t: i32 = 0; while t < 2 * NN_H { snap[t] = g_nn_acc[t]; t = t + 1; }
                if make_move(mv) == 1 {
                    picked = 1;
                    if nn_equal_recompute() == 0 { fails_inc = fails_inc + 1; }
                    unmake_move();
                    var okrt: i32 = 1; var u: i32 = 0;
                    while u < 2 * NN_H { if g_nn_acc[u] != snap[u] { okrt = 0; } u = u + 1; }
                    if okrt == 0 { fails_rt = fails_rt + 1; }
                    make_move(mv);
                    if nn_equal_recompute() == 0 { fails_inc = fails_inc + 1; }
                    if g_key != recompute_key() { fails_key = fails_key + 1; }
                    // null-window probe: the acc slab chain must survive a null
                    // (the class of bug positional maintenance never had)
                    if plies % 16 == 7 {
                        make_null();
                        if nn_equal_recompute() == 0 { fails_inc = fails_inc + 1; }
                        unmake_null();
                        if nn_equal_recompute() == 0 { fails_inc = fails_inc + 1; }
                    }
                    // lazy-chain probe: descend plies with NO ensure between,
                    // then one ensure must replay the whole delta chain (and
                    // king moves in the chain must barrier into finny refresh)
                    if plies % 16 == 11 {
                        // derived LOCAL rng: the probe must not perturb the
                        // walk trajectory (confine identity vs the eager base)
                        var crng: i64 = rng ^ 0x5DEECE66D;
                        var chain: i32 = 0;
                        var cw: i32 = 0;
                        while cw < 3 {
                            gen_moves(0, 0);
                            let clo: i32 = g_first[0];
                            let ccnt: i32 = g_first[1] - clo;
                            if ccnt <= 0 { cw = 3; }
                            else {
                                crng = crng ^ (crng << 13); crng = crng ^ (crng >> 7); crng = crng ^ (crng << 17);
                                var rr2: i64 = crng; if rr2 < 0 { rr2 = 0 - rr2; }
                                let off2: i32 = (rr2 % (ccnt as i64)) as i32;
                                var picked2: i32 = 0;
                                var s2: i32 = 0;
                                while s2 < ccnt && picked2 == 0 {
                                    if make_move(g_mv[clo + (off2 + s2) % ccnt]) == 1 { picked2 = 1; chain = chain + 1; }
                                    s2 = s2 + 1;
                                }
                                if picked2 == 0 { cw = 3; } else { cw = cw + 1; }
                            }
                        }
                        if chain > 0 {
                            if nn_equal_recompute() == 0 { fails_inc = fails_inc + 1; }
                            var cu: i32 = 0; while cu < chain { unmake_move(); cu = cu + 1; }
                            if nn_equal_recompute() == 0 { fails_inc = fails_inc + 1; }
                        }
                    }
                    made = made + 1;
                }
                s = s + 1;
            }
            if picked == 0 { plies = nply; }
            else { plies = plies + 1; }
        }
    }
    var w: i32 = 0;
    while w < made { unmake_move(); w = w + 1; }
    g_nnue_on = 0;
    nn_recompute_all();
    wr(1, "nnue selftest plies ");
    wr_int(1, made as i64);
    wr(1, " inc_fail ");
    wr_int(1, fails_inc as i64);
    wr(1, " rt_fail ");
    wr_int(1, fails_rt as i64);
    wr(1, " key_fail ");
    wr_int(1, fails_key as i64);
    if fails_inc == 0 { if fails_rt == 0 { if fails_key == 0 { wr(1, "  [EXACT: incremental == recompute; make/unmake round-trips; zobrist]"); } } }
    if fails_inc != 0 { wr(1, "  [FAIL]"); }
    if fails_rt != 0 { wr(1, "  [FAIL]"); }
    if fails_key != 0 { wr(1, "  [FAIL]"); }
    wr(1, "\n");
}

// ==================== training: backward = the forward, transposed ====================
fn nn_loss(target: i64) -> i64 { let e: i64 = nn_eval() - target; return e * e; }
fn nn_zero_grads() {
    var i: i32 = 0; while i < NN_H * NN_NFH { g_nn_dft[i] = 0; i = i + 1; }
    i = 0; while i < NN_K * 2 * NN_H { g_nn_dw2[i] = 0; i = i + 1; }
    if g_factor == 1 { i = 0; while i < NN_H * NN_NPTF * 64 { g_nn_dwf[i] = 0; i = i + 1; } }
}
fn nn_backward(target: i64) -> i64 {
    let V: i64 = nn_eval();
    let err: i64 = V - target;
    let dV: i64 = 2 * err;
    let base: i32 = nn_route() * 2 * NN_H;       // gradients land in the routed expert only
    var dcat: [i64; 512] = 0;                    // dL/d(cat[j]); sized for 2*NN_H up to 512
    var j: i32 = 0;
    while j < 2 * NN_H {
        let cj: i64 = nn_catval(j);
        g_nn_dw2[base + j] = g_nn_dw2[base + j] + dV * nn_crelu(cj);
        var gate: i64 = 0;
        if cj > 0 { if cj < NN_QMAX { gate = 1; } }
        dcat[j] = dV * g_nn_w2[base + j] * gate;
        j = j + 1;
    }
    var persp: i32 = 0;
    while persp < 2 {
        var off: i32 = NN_H;
        if persp == g_side { off = 0; }
        var sq: i32 = 21;
        while sq <= 98 {
            let p: i32 = g_board[sq];
            if nn_pt(p) >= 0 {
                let f: i32 = nn_feat(persp, p, sq);
                var h: i32 = 0;
                while h < NN_H { g_nn_dft[h * NN_NFH + f] = g_nn_dft[h * NN_NFH + f] + dcat[off + h]; h = h + 1; }
                if g_factor == 1 {
                    let tp: i32 = f % 640;
                    h = 0;
                    while h < NN_H { g_nn_dwf[h * 640 + tp] = g_nn_dwf[h * 640 + tp] + dcat[off + h]; h = h + 1; }
                }
            }
            sq = sq + 1;
        }
        persp = persp + 1;
    }
    return err * err;
}
fn nn_sgd_step(shift: i64) {
    var i: i32 = 0;
    while i < NN_H * NN_NFH {
        let g: i64 = g_nn_dft[i];
        if g >> shift > 0 { g_nn_ft[i] = g_nn_ft[i] - 1; }
        else if (0 - g) >> shift > 0 { g_nn_ft[i] = g_nn_ft[i] + 1; }
        if g_onebit == 1 {
            if g_nn_ft[i] > 1 { g_nn_ft[i] = 1; }
            if g_nn_ft[i] < 0 - 1 { g_nn_ft[i] = 0 - 1; }
        }
        i = i + 1;
    }
    i = 0;
    while i < NN_K * 2 * NN_H {
        let g2: i64 = g_nn_dw2[i];
        if g2 >> shift > 0 { g_nn_w2[i] = g_nn_w2[i] - 1; }
        else if (0 - g2) >> shift > 0 { g_nn_w2[i] = g_nn_w2[i] + 1; }
        if g_onebit == 1 {
            if g_nn_w2[i] > 1 { g_nn_w2[i] = 1; }
            if g_nn_w2[i] < 0 - 1 { g_nn_w2[i] = 0 - 1; }
        }
        i = i + 1;
    }
    if g_factor == 1 {
        var fs: i64 = g_fshift;
        if fs < 0 { fs = shift; }
        var h: i32 = 0;
        while h < NN_H {
            var tp: i32 = 0;
            while tp < 640 {
                let gf: i64 = g_nn_dwf[h * 640 + tp];
                var step: i64 = 0;
                if gf >> fs > 0 { step = 0 - 1; }
                else if (0 - gf) >> fs > 0 { step = 1; }
                if step != 0 {
                    var k: i32 = 0;
                    while k < 64 {
                        let idx: i32 = h * NN_NFH + k * 640 + tp;
                        g_nn_ft[idx] = g_nn_ft[idx] + step;
                        if g_onebit == 1 {
                            if g_nn_ft[idx] > 1 { g_nn_ft[idx] = 1; }
                            if g_nn_ft[idx] < 0 - 1 { g_nn_ft[idx] = 0 - 1; }
                        }
                        k = k + 1;
                    }
                }
                tp = tp + 1;
            }
            h = h + 1;
        }
    }
}

fn nn_gradcheck(target: i64, out: *i32) {
    nn_recompute_all();
    nn_zero_grads();
    nn_backward(target);
    var okW2: i32 = 0; var nW2: i32 = 0;
    var j: i32 = 0;                              // all K experts: routed = real grad, others 0==0
    while j < NN_K * 2 * NN_H {
        let g: i64 = g_nn_dw2[j];
        let save: i64 = g_nn_w2[j];
        g_nn_w2[j] = save + 1; let lp: i64 = nn_loss(target);
        g_nn_w2[j] = save - 1; let lm: i64 = nn_loss(target);
        g_nn_w2[j] = save;
        nW2 = nW2 + 1;
        if (lp - lm) / 2 == g { okW2 = okW2 + 1; }
        j = j + 1;
    }
    var okF: i32 = 0; var nF: i32 = 0;
    var persp: i32 = 0;
    while persp < 2 {
        var sq: i32 = 21;
        while sq <= 98 {
            let p: i32 = g_board[sq];
            if nn_pt(p) >= 0 {
                let f: i32 = nn_feat(persp, p, sq);
                var h: i32 = 0;
                while h < NN_H {
                    let a: i64 = g_nn_acc[persp * NN_H + h];
                    if a > 1 { if a < NN_QMAX - 1 {
                        let g2: i64 = g_nn_dft[h * NN_NFH + f];
                        let save2: i64 = g_nn_ft[f * NN_H + h];
                        g_nn_ft[f * NN_H + h] = save2 + 1; nn_recompute_all(); let lp2: i64 = nn_loss(target);
                        g_nn_ft[f * NN_H + h] = save2 - 1; nn_recompute_all(); let lm2: i64 = nn_loss(target);
                        g_nn_ft[f * NN_H + h] = save2; nn_recompute_all();
                        nF = nF + 1;
                        if (lp2 - lm2) / 2 == g2 { okF = okF + 1; }
                    } }
                    h = h + 1;
                }
            }
            sq = sq + 1;
        }
        persp = persp + 1;
    }
    out[0] = okW2; out[1] = nW2; out[2] = okF; out[3] = nF;
}

fn nn_factorcheck(target: i64, out: *i32) {
    let save: i32 = g_factor;
    g_factor = 1;
    nn_recompute_all();
    nn_zero_grads();
    nn_backward(target);
    g_factor = save;
    var ok: i32 = 0;
    var n: i32 = 0;
    var h: i32 = 0;
    while h < NN_H {
        var tp: i32 = 0;
        while tp < 640 {
            var s: i64 = 0;
            var k: i32 = 0;
            while k < 64 { s = s + g_nn_dft[h * NN_NFH + k * 640 + tp]; k = k + 1; }
            n = n + 1;
            if s == g_nn_dwf[h * 640 + tp] { ok = ok + 1; }
            tp = tp + 1;
        }
        h = h + 1;
    }
    out[0] = ok; out[1] = n;
}

// ============ self-play data generation + outcome training (GAP 3 #2) ============
let TR_MAXGAMES: i32 = 4096;
let TR_MAXMOVES: i32 = 524288;      // flat replay buffer (sum of game lengths)
var g_tr_moves: *i32 = null;        // recorded moves, all games concatenated
var g_tr_gstart: *i32 = null;       // per-game start index into g_tr_moves
var g_tr_glen: *i32 = null;         // per-game move count
var g_tr_gopen: *i32 = null;
var g_tr_gz: *i32 = null;           // per-game white-relative outcome z in {-1,0,1}
var g_tr_ngames: i32 = 0;
var g_tr_fill: i32 = 0;             // write cursor into g_tr_moves
var g_tr_rng: i64 = 0;             // self-play PRNG state
var g_tr_rootsc: i32 = 0;
var g_tr_sc: *i32 = null;          // per-ply root score, parallel to g_tr_moves
var g_tdlabel: i32 = 0;
var g_tdfocus: i32 = 0;            // 0 = all positions · 1 = punctuation plies only
var g_td_theta: i64 = 32;          // punctuation threshold (cp)
var g_tdfocus_used: i64 = 0;       // positions actually trained (focus accounting)
var g_base_on: i32 = 0;
var g_base_w: *i64 = null;
var g_onebit: i32 = 0;
var g_factor: i32 = 0;
var g_fshift: i64 = 0 - 1;
var g_nn_dwf: *i64 = null;         // NN_H * 640 plane gradient accumulator
fn nn_base_white() -> i64 {
    var d: [i64; 5] = 0;
    td_count_diffs(&d[0]);
    var acc: i64 = g_base_w[0];
    var k: i32 = 0;
    while k < 5 { acc = acc + g_base_w[k + 1] * d[k]; k = k + 1; }
    return acc >> 20;
}
var g_pst_on: i32 = 0;
var g_pstw: *i64 = null;
var g_pst_bias: i64 = 0;
var g_pst_stm: i64 = 0;
fn nn_pst_white() -> i64 {
    var acc: i64 = g_pst_bias;
    if g_side == WHITE { acc = acc + g_pst_stm; } else { acc = acc - g_pst_stm; }
    var sq: i32 = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if p != EMPTY { if p != OFF {
            let side: i32 = piece_side(p);
            let kind: i32 = p - side * 6;
            let s: i32 = sq64(sq);
            if side == WHITE { acc = acc + g_pstw[kind * 64 + s]; }
            else { acc = acc - g_pstw[kind * 64 + (s ^ 56)]; }
        } }
        sq = sq + 1;
    }
    return acc >> 20;
}
fn nn_anybase_white() -> i64 {
    if g_pst_on == 1 { return nn_pst_white(); }
    return nn_base_white();
}
var g_adj_fire: i32 = 0;           // games where the mate band crossed at root
var g_adj_agree: i32 = 0;          // adjudicated verdict == final outcome (mode 1)
var g_adj_disagree: i32 = 0;       // adjudicated verdict != final outcome
var g_adj_rescue: i32 = 0;
var g_adj_inclass: i32 = 0;        // games that reached an exact TB class at root
var g_cap_games: i32 = 0;

fn nn_tr_alloc() {
    if g_tr_moves == null {
        g_tr_moves = alloc(TR_MAXMOVES);
        g_tr_sc = alloc(TR_MAXMOVES);
        g_tr_gstart = alloc(TR_MAXGAMES);
        g_tr_glen = alloc(TR_MAXGAMES);
        g_tr_gopen = alloc(TR_MAXGAMES);
        g_tr_gz = alloc(TR_MAXGAMES);
    }
}
fn td_clamp(sc: i32, scale: i64) -> i64 {
    var s: i64 = sc as i64;
    let lim: i64 = 3 * scale;
    if s > lim { s = lim; }
    if s < 0 - lim { s = 0 - lim; }
    return s;
}
fn nn_rng_next() -> i64 {
    var x: i64 = g_tr_rng;
    x = x ^ (x << 13); x = x ^ (x >> 7); x = x ^ (x << 17);
    g_tr_rng = x;
    if x < 0 { return 0 - x; }
    return x;
}
fn nn_search_move(depth: i32) -> i32 {
    g_nodes = 0; g_stop = 0; g_bestroot = 0;
    g_budget = 0;
    g_first[0] = 0;
    clear_search_tables();
    var d: i32 = 1;
    while d <= depth {
        g_tr_rootsc = search(0 - INF, INF, d, 0, 1);
        d = d + 1;
    }
    return g_bestroot;
}
fn nn_pick_random() -> i32 {
    g_first[0] = 0;
    gen_moves(0, 0);
    let lo: i32 = g_first[0];
    let hi: i32 = g_first[1];
    let cnt: i32 = hi - lo;
    if cnt <= 0 { return 0; }
    let off: i32 = (nn_rng_next() % (cnt as i64)) as i32;
    var s: i32 = 0;
    while s < cnt {
        let mv: i32 = g_mv[lo + (off + s) % cnt];
        if make_move(mv) == 1 { unmake_move(); return mv; }
        s = s + 1;
    }
    return 0;
}
fn nn_play_game(ropen: i32, depth: i32, maxply: i32) -> i32 {
    set_startpos();
    if g_nnue_on == 1 { nn_recompute_all(); }     // net-eval self-play: init accumulator
    let base: i32 = g_tr_fill;
    var ply: i32 = 0;
    var z: i32 = 0;                  // default draw
    var over: i32 = 0;
    var adj_ply: i32 = 0 - 1;
    var adj_z: i32 = 0;              // adjudicated white-relative verdict at that ply
    var inclass: i32 = 0;            // did the root ever land in an exact TB class
    while over == 0 && ply < maxply {
        var mv: i32 = 0;
        if ply < ropen { mv = nn_pick_random(); g_tr_rootsc = 0; }
        else { mv = nn_search_move(depth); }
        if base + ply < TR_MAXMOVES { g_tr_sc[base + ply] = g_tr_rootsc; }
        if g_tbprobe >= 1 { if ply >= ropen {
            if tb_probe(0) == 1 { inclass = 1; }
            if adj_ply < 0 {
                let sc: i32 = g_tr_rootsc;
                if sc > MATE - 200 || sc < 0 - (MATE - 200) {
                    adj_ply = ply;
                    var zp: i32 = 1;
                    if sc < 0 { zp = 0 - 1; }
                    if g_side == BLACK { zp = 0 - zp; }
                    adj_z = zp;
                }
            }
        } }
        if mv == 0 {
            if in_check(g_side) == 1 {
                if g_side == WHITE { z = 0 - 1; } else { z = 1; }
            } else { z = 0; }
            over = 1;
        } else {
            if base + ply < TR_MAXMOVES { g_tr_moves[base + ply] = mv; }
            make_move(mv);
            ply = ply + 1;
            if g_fifty >= 100 { z = 0; over = 1; }
            if g_tbprobe == 2 { if adj_ply >= 0 { z = adj_z; over = 1; } }
        }
    }
    if ply >= maxply { g_cap_games = g_cap_games + 1; }
    if inclass == 1 { g_adj_inclass = g_adj_inclass + 1; }
    if adj_ply >= 0 {
        g_adj_fire = g_adj_fire + 1;
        if adj_z == z { g_adj_agree = g_adj_agree + 1; } else { g_adj_disagree = g_adj_disagree + 1; }
        if adj_z != 0 { if z == 0 { g_adj_rescue = g_adj_rescue + 1; } }
    }
    if g_tr_ngames < TR_MAXGAMES {
        g_tr_gstart[g_tr_ngames] = base;
        g_tr_glen[g_tr_ngames] = ply;
        g_tr_gopen[g_tr_ngames] = ropen;
        g_tr_gz[g_tr_ngames] = z;
        g_tr_ngames = g_tr_ngames + 1;
        g_tr_fill = base + ply;
    }
    return z;
}
fn nn_replay_game(g: i32, scale: i64, do_train: i32) -> i64 {
    set_startpos();
    g_nnue_on = 1;
    nn_recompute_all();
    let start: i32 = g_tr_gstart[g];
    let len: i32 = g_tr_glen[g];
    let ropen: i32 = g_tr_gopen[g];
    let zw: i64 = g_tr_gz[g] as i64;
    var sse: i64 = 0;
    var ply: i32 = 0;
    while ply < len {
        if ply >= ropen {
            var tgt: i64 = zw * scale;
            if g_side == BLACK { tgt = 0 - tgt; }
            if g_tdlabel == 1 { tgt = td_clamp(g_tr_sc[start + ply], scale); }
            if g_base_on == 1 || g_pst_on == 1 {
                var bs: i64 = nn_anybase_white();
                if g_side == BLACK { bs = 0 - bs; }
                tgt = tgt - bs;
            }
            var use: i32 = 1;
            if do_train == 1 {
                if g_tdfocus == 1 {
                    use = 0;
                    if ply >= ropen + 2 {
                        let s0: i64 = td_clamp(g_tr_sc[start + ply], scale);
                        let s1: i64 = td_clamp(g_tr_sc[start + ply - 1], scale);
                        let s2: i64 = td_clamp(g_tr_sc[start + ply - 2], scale);
                        var a: i64 = s0 + 2 * s1 + s2;
                        if a < 0 { a = 0 - a; }
                        if a > g_td_theta { use = 1; }
                    }
                } else if g_tdfocus == 2 {
                    use = 0;
                    if (ply - ropen) % 6 == 0 { use = 1; }
                }
            }
            if use == 1 {
                if do_train == 1 { sse = sse + nn_backward(tgt); g_tdfocus_used = g_tdfocus_used + 1; }
                else { let e: i64 = nn_eval() - tgt; sse = sse + e * e; }
            }
        }
        make_move(g_tr_moves[start + ply]);
        ply = ply + 1;
    }
    g_nnue_on = 0;
    return sse;
}
fn nn_count_positions(g0: i32, g1: i32) -> i64 {
    var n: i64 = 0; var g: i32 = g0;
    while g < g1 { let np: i32 = g_tr_glen[g] - g_tr_gopen[g]; if np > 0 { n = n + np as i64; } g = g + 1; }
    return n;
}

fn nn_expert_report(g0: i32, a0: i32, scale: i64) {
    var ne: [i64; 8] = 0;
    var sse: [i64; 8] = 0;
    var sse0: [i64; 8] = 0;
    g_nnue_on = 1;
    var g: i32 = g0;
    while g < g_tr_ngames {
        set_startpos();
        nn_recompute_all();
        let start: i32 = g_tr_gstart[g];
        let len: i32 = g_tr_glen[g];
        let ropen: i32 = g_tr_gopen[g];
        let zw: i64 = g_tr_gz[g] as i64;
        var ply: i32 = 0;
        while ply < len {
            if ply >= ropen {
                var tgt: i64 = zw * scale;
                if g_side == BLACK { tgt = 0 - tgt; }
                if g_tdlabel == 1 { tgt = td_clamp(g_tr_sc[start + ply], scale); }
                if g_base_on == 1 || g_pst_on == 1 {
                    var bs: i64 = nn_anybase_white();
                    if g_side == BLACK { bs = 0 - bs; }
                    tgt = tgt - bs;
                }
                let e: i32 = nn_route();
                let d: i64 = nn_eval() - tgt;
                ne[e] = ne[e] + 1; sse[e] = sse[e] + d * d; sse0[e] = sse0[e] + tgt * tgt;
            }
            make_move(g_tr_moves[start + ply]);
            ply = ply + 1;
        }
        g = g + 1;
    }
    g_nnue_on = 0;
    var i: i32 = a0;
    while i < g_an_n {
        let base: i32 = i * AN_FENLEN;
        var fl: i32 = 0;
        while g_an_fen[base + fl] != 0 { fl = fl + 1; }
        parse_fen(&g_an_fen[base], fl);
        nn_recompute_all();
        let z64: i64 = g_an_z[i] as i64;
        var tgt: i64 = z64 * scale;
        if g_side == BLACK { tgt = 0 - tgt; }
        let e: i32 = nn_route();
        let d: i64 = nn_eval() - tgt;
        ne[e] = ne[e] + 1; sse[e] = sse[e] + d * d; sse0[e] = sse0[e] + tgt * tgt;
        i = i + 1;
    }
    var e2: i32 = 0;
    while e2 < NN_K {
        wr(1, "  expert "); wr_int(1, e2 as i64);
        wr(1, " n "); wr_int(1, ne[e2]);
        if ne[e2] > 0 {
            wr(1, "  heldout_mse "); wr_int(1, sse[e2] / ne[e2]);
            wr(1, "  predict0 "); wr_int(1, sse0[e2] / ne[e2]);
            if sse[e2] < sse0[e2] { wr(1, "  ADMITTED"); }
            else {
                wr(1, "  REFUSED(zeroed)");
                var z: i32 = 0;
                while z < 2 * NN_H { g_nn_w2[e2 * 2 * NN_H + z] = 0; z = z + 1; }
            }
        } else { wr(1, "  (no held-out positions)"); }
        wr(1, "\n");
        e2 = e2 + 1;
    }
    set_startpos();
}

fn nn_train(games: i32, depth: i32, epochs: i32, shift: i64, scale: i64, ashift: i64, maxply: i32) {
    nn_tr_alloc();
    nn_init_weights();
    g_nnue_on = 0;
    g_tr_ngames = 0; g_tr_fill = 0;
    g_tr_rng = 0x9E3779B97F4A7C15;
    if g_tbprobe >= 1 { if g_tbq == null { wr(1, "building certified tables (KQK+KRK)...\n"); tb_build_all(); } }
    g_adj_fire = 0; g_adj_agree = 0; g_adj_disagree = 0; g_adj_rescue = 0; g_adj_inclass = 0; g_cap_games = 0;
    var g: i32 = 0;
    while g < games {
        if g_tr_fill + maxply + 1 > TR_MAXMOVES { g = games; }
        else {
            let ropen: i32 = 4 + (nn_rng_next() % 9) as i32;     // 4..12 opening plies
            nn_play_game(ropen, depth, maxply);
            g = g + 1;
        }
    }
    if g_tbprobe >= 1 {
        wr(1, "adjudication (tbprobe "); wr_int(1, g_tbprobe as i64); wr(1, "): games "); wr_int(1, g_tr_ngames as i64);
        wr(1, "  mate-band-fired "); wr_int(1, g_adj_fire as i64);
        wr(1, "  in-TB-class "); wr_int(1, g_adj_inclass as i64);
        wr(1, "  maxply-capped "); wr_int(1, g_cap_games as i64);
        if g_tbprobe == 1 {
            wr(1, "  | verify: agree "); wr_int(1, g_adj_agree as i64);
            wr(1, " disagree "); wr_int(1, g_adj_disagree as i64);
            wr(1, " rescued-draw-poison "); wr_int(1, g_adj_rescue as i64);
        }
        wr(1, "\n");
    }
    let ntrain: i32 = g_tr_ngames * 4 / 5;                       // 80% train / 20% held-out
    let n_tr: i64 = nn_count_positions(0, ntrain);
    let n_te: i64 = nn_count_positions(ntrain, g_tr_ngames);
    let an_tr: i32 = g_an_n * 4 / 5;
    let an_te: i32 = g_an_n - an_tr;
    wr(1, "nnue train games "); wr_int(1, g_tr_ngames as i64);
    wr(1, " (train "); wr_int(1, ntrain as i64); wr(1, "/"); wr_int(1, n_tr);
    wr(1, "pos  test "); wr_int(1, (g_tr_ngames - ntrain) as i64); wr(1, "/"); wr_int(1, n_te);
    wr(1, "pos)  depth "); wr_int(1, depth as i64);
    wr(1, " shift "); wr_int(1, shift); wr(1, " scale "); wr_int(1, scale);
    if g_tdlabel == 1 { wr(1, "  labels TD(searched-value)"); }
    if g_an_n > 0 {
        wr(1, "  anchors "); wr_int(1, g_an_n as i64);
        wr(1, " (train "); wr_int(1, an_tr as i64); wr(1, " heldout "); wr_int(1, an_te as i64);
        wr(1, " ashift "); wr_int(1, ashift); wr(1, ")");
    }
    wr(1, "\n");
    var ep: i32 = 0;
    while ep < epochs {
        let sh: i64 = shift + (ep as i64) / 8;      // gentle LR decay (raise the dead-zone)
        g_tdfocus_used = 0;
        var sse_tr: i64 = 0;
        var gg: i32 = 0;
        while gg < ntrain {
            nn_zero_grads();
            sse_tr = sse_tr + nn_replay_game(gg, scale, 1);
            nn_sgd_step(sh);
            gg = gg + 1;
        }
        let ash: i64 = ashift + (ep as i64) / 8;
        var an_sse_tr: i64 = 0;
        if an_tr > 0 { an_sse_tr = nn_anchor_replay(0, an_tr, scale, 1, ash); }
        var sse_te: i64 = 0;
        gg = ntrain;
        while gg < g_tr_ngames { sse_te = sse_te + nn_replay_game(gg, scale, 0); gg = gg + 1; }
        wr(1, "  epoch "); wr_int(1, ep as i64);
        wr(1, "  train_mse "); if n_tr > 0 { wr_int(1, sse_tr / n_tr); } else { wr_int(1, 0); }
        wr(1, "  heldout_mse "); if n_te > 0 { wr_int(1, sse_te / n_te); } else { wr_int(1, 0); }
        if g_an_n > 0 {
            wr(1, "  anchor_mse "); if an_tr > 0 { wr_int(1, an_sse_tr / an_tr as i64); } else { wr_int(1, 0); }
            var an_sse_te: i64 = 0;
            if an_te > 0 { an_sse_te = nn_anchor_replay(an_tr, g_an_n, scale, 0, sh); }
            wr(1, "  anchor_heldout_mse "); if an_te > 0 { wr_int(1, an_sse_te / an_te as i64); } else { wr_int(1, 0); }
            var sa: [i32; 2] = 0;
            nn_anchor_signacc(an_tr, g_an_n, &sa[0]);
            wr(1, "  anchor_sign "); wr_int(1, sa[0] as i64); wr(1, "/"); wr_int(1, sa[1] as i64);
        }
        if g_tdfocus > 0 { wr(1, "  focus_pos "); wr_int(1, g_tdfocus_used); }
        wr(1, "\n");
        ep = ep + 1;
    }
    if NN_K > 1 { nn_expert_report(ntrain, an_tr, scale); }
    g_nnue_on = 0;
    set_startpos();
}

// ============ the label-disagreement map (where does the outcome label differ from the
var g_td_sc: *i32 = null;
fn td_id_capture(maxd: i32) {
    g_nodes = 0; g_stop = 0; g_bestroot = 0; g_budget = 0; g_first[0] = 0;
    clear_search_tables();
    var d: i32 = 1;
    while d <= maxd {
        let s: i32 = search(0 - INF, INF, d, 0, 1);
        if d < 16 { g_td_sc[d] = s; }
        d = d + 1;
    }
}
fn td_map(games: i32, playdepth: i32, sweep: i32) {
    if g_td_sc == null { g_td_sc = alloc(16); }
    nn_tr_alloc();
    g_tr_ngames = 0; g_tr_fill = 0;
    g_tr_rng = 0x9E3779B97F4A7C15;
    let save_probe: i32 = g_tbprobe; g_tbprobe = 0;    // pure outcome labels + pure search
    var g: i32 = 0;
    while g < games {
        if g_tr_fill + 201 > TR_MAXMOVES { g = games; }
        else { let ropen: i32 = 4 + (nn_rng_next() % 9) as i32; nn_play_game(ropen, playdepth, 200); g = g + 1; }
    }
    var agree: [i64; 64] = 0;         // idx = d*NN_K + band
    var tot: [i64; 64] = 0;
    var bpos: [i64; 8] = 0;           // positions per band
    var gg: i32 = 0;
    while gg < g_tr_ngames {
        let zw: i32 = g_tr_gz[gg];
        if zw != 0 {
            let start: i32 = g_tr_gstart[gg]; let len: i32 = g_tr_glen[gg]; let ropen: i32 = g_tr_gopen[gg];
            set_startpos();
            var ply: i32 = 0;
            while ply < len {
                if ply >= ropen {
                    if ply % 2 == 0 {
                        let band: i32 = nn_route();
                        bpos[band] = bpos[band] + 1;
                        td_id_capture(sweep);
                        var d: i32 = 1;
                        while d <= sweep {
                            let sc: i32 = g_td_sc[d];
                            var zs: i32 = 0;
                            if sc > 0 { zs = 1; } else { if sc < 0 { zs = 0 - 1; } }
                            if g_side == BLACK { zs = 0 - zs; }
                            let idx: i32 = d * NN_K + band;
                            tot[idx] = tot[idx] + 1;
                            if zs == zw { agree[idx] = agree[idx] + 1; }
                            d = d + 1;
                        }
                    }
                }
                make_move(g_tr_moves[start + ply]);
                ply = ply + 1;
            }
        }
        gg = gg + 1;
    }
    g_tbprobe = save_probe;
    wr(1, "tdmap games "); wr_int(1, g_tr_ngames as i64); wr(1, "  positions/band");
    var b0: i32 = 0; while b0 < NN_K { wr(1, " b"); wr_int(1, b0 as i64); wr(1, "="); wr_int(1, bpos[b0]); b0 = b0 + 1; }
    wr(1, "  (band = npmat/1600: b0 endgame .. b3 opening)\n");
    wr(1, "depth  overall%   per-band sign-agree(searched-value, outcome) %\n");
    var d2: i32 = 1;
    while d2 <= sweep {
        var sa: i64 = 0; var st: i64 = 0;
        var b: i32 = 0;
        while b < NN_K { sa = sa + agree[d2 * NN_K + b]; st = st + tot[d2 * NN_K + b]; b = b + 1; }
        wr(1, "  "); wr_int(1, d2 as i64); wr(1, "     ");
        if st > 0 { wr_int(1, sa * 100 / st); } else { wr_int(1, 0); }
        wr(1, "        ");
        b = 0;
        while b < NN_K {
            let idx: i32 = d2 * NN_K + b;
            wr(1, " b"); wr_int(1, b as i64); wr(1, "=");
            if tot[idx] > 0 { wr_int(1, agree[idx] * 100 / tot[idx]); } else { wr_int(1, 0); }
            b = b + 1;
        }
        wr(1, "\n");
        d2 = d2 + 1;
    }
    set_startpos();
}

// ============ tdseg: the structure of the value stream along games ============
fn td_seg(games: i32, playdepth: i32, theta: i64) {
    nn_tr_alloc();
    g_tr_ngames = 0; g_tr_fill = 0;
    g_tr_rng = 0x9E3779B97F4A7C15;
    let save_probe: i32 = g_tbprobe; g_tbprobe = 0;
    var g: i32 = 0;
    while g < games {
        if g_tr_fill + 201 > TR_MAXMOVES { g = games; }
        else { let ropen: i32 = 4 + (nn_rng_next() % 9) as i32; nn_play_game(ropen, playdepth, 200); g = g + 1; }
    }
    g_tbprobe = save_probe;
    let vbuf: *i64 = alloc(256);
    let qbuf: *i64 = alloc(256);
    let cbuf: *i64 = alloc(300);
    var tot_n: i64 = 0;
    var tot_int: i64 = 0;
    var tot_punct: i64 = 0;
    var bm_sum: i64 = 0;
    var bm_n: i64 = 0;
    var bm_max: i64 = 0;
    var bm_games: i64 = 0;
    var band_punct: [i64; 8] = 0;
    var band_int: [i64; 8] = 0;
    var gg: i32 = 0;
    while gg < g_tr_ngames {
        let start: i32 = g_tr_gstart[gg];
        let len: i32 = g_tr_glen[gg];
        let ropen: i32 = g_tr_gopen[gg];
        set_startpos();
        var bandbuf: [i32; 256] = 0;
        var ply: i32 = 0;
        var n: i32 = 0;
        while ply < len {
            if ply >= ropen { if n < 256 {
                var v: i64 = td_clamp(g_tr_sc[start + ply], 100);
                if g_side == BLACK { v = 0 - v; }
                vbuf[n] = v;
                bandbuf[n] = nn_route();
                n = n + 1;
            } }
            make_move(g_tr_moves[start + ply]);
            ply = ply + 1;
        }
        tot_n = tot_n + n as i64;
        var i: i32 = 2;
        while i < n {
            let d2: i64 = vbuf[i] - 2 * vbuf[i - 1] + vbuf[i - 2];
            var a: i64 = d2;
            if a < 0 { a = 0 - a; }
            tot_int = tot_int + 1;
            band_int[bandbuf[i]] = band_int[bandbuf[i]] + 1;
            if a > theta { tot_punct = tot_punct + 1; band_punct[bandbuf[i]] = band_punct[bandbuf[i]] + 1; }
            i = i + 1;
        }
        if n >= 8 {
            var j: i32 = 0;
            while j < n { qbuf[j] = (vbuf[j] + 300) / theta; j = j + 1; }
            let L: i32 = bm_l(qbuf, n, BM_PRIME, cbuf);
            bm_sum = bm_sum + L as i64;
            bm_n = bm_n + n as i64;
            if L as i64 > bm_max { bm_max = L as i64; }
            bm_games = bm_games + 1;
        }
        gg = gg + 1;
    }
    wr(1, "tdseg games "); wr_int(1, g_tr_ngames as i64);
    wr(1, "  stream-plies "); wr_int(1, tot_n);
    wr(1, "  theta "); wr_int(1, theta); wr(1, "\n");
    wr(1, "  punctuation "); wr_int(1, tot_punct);
    wr(1, "/"); wr_int(1, tot_int);
    wr(1, " interior plies (density ");
    if tot_int > 0 { wr_int(1, tot_punct * 100 / tot_int); } else { wr_int(1, 0); }
    wr(1, "%  redundancy ");
    if tot_int > 0 { wr_int(1, (tot_int - tot_punct) * 100 / tot_int); } else { wr_int(1, 0); }
    wr(1, "%)\n  per-band punctuation density:");
    var b: i32 = 0;
    while b < NN_K {
        wr(1, "  b"); wr_int(1, b as i64); wr(1, "=");
        if band_int[b] > 0 { wr_int(1, band_punct[b] * 100 / band_int[b]); } else { wr_int(1, 0); }
        wr(1, "%");
        b = b + 1;
    }
    wr(1, "\n  bm_l(quantized): mean L ");
    if bm_games > 0 { wr_int(1, bm_sum / bm_games); } else { wr_int(1, 0); }
    wr(1, " of mean n ");
    if bm_games > 0 { wr_int(1, bm_n / bm_games); } else { wr_int(1, 0); }
    wr(1, " (max L "); wr_int(1, bm_max);
    wr(1, ")  2L/n info ratio ");
    if bm_n > 0 { wr_int(1, bm_sum * 200 / bm_n); } else { wr_int(1, 0); }
    wr(1, "%\n");
    set_startpos();
}

// ============ pst base ============
let PST_NF: i32 = 369;
fn pst_fidx(kind: i32, s: i32) -> i32 {
    if kind == 1 {
        if s < 8 { return 0 - 1; }
        if s >= 56 { return 0 - 1; }
        return 2 + (s - 8);
    }
    if kind == 6 {
        if s == 0 { return 0 - 1; }
        return 2 + 48 + 4 * 64 + (s - 1);
    }
    return 2 + 48 + (kind - 2) * 64 + s;
}
fn pst_features(idx: *i32, val: *i64) -> i32 {
    var xv: [i64; 384] = 0;                      // dense scratch, PST_NF <= 384
    var used: [i32; 40] = 0;
    var nu: i32 = 0;
    var sq: i32 = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if p != EMPTY { if p != OFF {
            let side: i32 = piece_side(p);
            let kind: i32 = p - side * 6;
            var s: i32 = sq64(sq);
            var sgn: i64 = 1;
            if side == BLACK { s = s ^ 56; sgn = 0 - 1; }
            let f: i32 = pst_fidx(kind, s);
            if f >= 0 {
                if xv[f] == 0 { used[nu] = f; nu = nu + 1; }
                xv[f] = xv[f] + sgn;
            }
        } }
        sq = sq + 1;
    }
    var cnt: i32 = 0;
    idx[cnt] = 0; val[cnt] = 1; cnt = cnt + 1;
    var stmv: i64 = 1;
    if g_side == BLACK { stmv = 0 - 1; }
    idx[cnt] = 1; val[cnt] = stmv; cnt = cnt + 1;
    var u: i32 = 0;
    while u < nu {
        let f2: i32 = used[u];
        if xv[f2] != 0 { idx[cnt] = f2; val[cnt] = xv[f2]; cnt = cnt + 1; }
        u = u + 1;
    }
    return cnt;
}
fn pst_store(origid: i32, q: i64) {
    if origid == 0 { g_pst_bias = q; return; }
    if origid == 1 { g_pst_stm = q; return; }
    var r: i32 = origid - 2;
    if r < 48 { g_pstw[1 * 64 + (r + 8)] = q; return; }
    r = r - 48;
    if r < 256 { g_pstw[(2 + r / 64) * 64 + (r % 64)] = q; return; }
    r = r - 256;
    g_pstw[6 * 64 + (r + 1)] = q;
}
fn pst_load(path: *u8) -> i32 {
    let fd: i32 = open(path, 0, 0);
    if fd < 0 { return 0; }
    let cap: i32 = 65536;
    let buf: *u8 = alloc(cap);
    var total: i32 = 0;
    var done: i32 = 0;
    while done == 0 {
        let r: i64 = read(fd, &buf[total], (cap - total) as usize);
        if r <= 0 { done = 1; } else { total = total + r as i32; }
    }
    close(fd);
    if g_pstw == null { g_pstw = alloc(448); }
    var z: i32 = 0;
    while z < 448 { g_pstw[z] = 0; z = z + 1; }
    g_pst_bias = 0; g_pst_stm = 0;
    var pos: i32 = 0;
    var vals: [i64; 2] = 0;
    var nexp: i32 = 0 - 1;
    var got: i32 = 0;
    var pair: i32 = 0;
    while pos < total {
        while pos < total {
            let c: i32 = buf[pos] as i32;
            if c == 45 { break; }
            if c >= 48 { if c <= 57 { break; } }
            pos = pos + 1;
        }
        if pos >= total { break; }
        var neg: i32 = 0;
        if buf[pos] as i32 == 45 { neg = 1; pos = pos + 1; }
        var v: i64 = 0;
        while pos < total {
            let c2: i32 = buf[pos] as i32;
            if c2 < 48 { break; }
            if c2 > 57 { break; }
            v = v * 10 + (c2 - 48) as i64;
            pos = pos + 1;
        }
        if neg == 1 { v = 0 - v; }
        if nexp < 0 { nexp = v as i32; }
        else {
            vals[pair] = v;
            pair = pair + 1;
            if pair == 2 {
                pst_store(vals[0] as i32, vals[1]);
                got = got + 1;
                pair = 0;
            }
        }
    }
    if got != nexp { return 0; }
    return got;
}
fn pst_gate(games: i32, playdepth: i32) {
    nn_tr_alloc();
    g_tr_ngames = 0; g_tr_fill = 0;
    g_tr_rng = 0x9E3779B97F4A7C15;
    let save_probe: i32 = g_tbprobe; g_tbprobe = 0;
    var g: i32 = 0;
    while g < games {
        if g_tr_fill + 201 > TR_MAXMOVES { g = games; }
        else { let ropen: i32 = 4 + (nn_rng_next() % 9) as i32; nn_play_game(ropen, playdepth, 200); g = g + 1; }
    }
    g_tbprobe = save_probe;
    let ntrain: i32 = g_tr_ngames * 4 / 5;
    var ne: [i64; 8] = 0;
    var sse: [i64; 8] = 0;
    var sse0: [i64; 8] = 0;
    var gg: i32 = ntrain;
    while gg < g_tr_ngames {
        let start: i32 = g_tr_gstart[gg];
        let len: i32 = g_tr_glen[gg];
        let ropen: i32 = g_tr_gopen[gg];
        set_startpos();
        var ply: i32 = 0;
        while ply < len {
            if ply >= ropen {
                let V: i64 = nn_pst_white();
                var tgt: i64 = td_clamp(g_tr_sc[start + ply], 100);
                if g_side == BLACK { tgt = 0 - tgt; }
                let band: i32 = nn_route();
                let e: i64 = V - tgt;
                ne[band] = ne[band] + 1;
                sse[band] = sse[band] + e * e;
                sse0[band] = sse0[band] + tgt * tgt;
            }
            make_move(g_tr_moves[start + ply]);
            ply = ply + 1;
        }
        gg = gg + 1;
    }
    wr(1, "pstgate (exact PST model, held-out games, per band):\n");
    var tsse: i64 = 0; var tsse0: i64 = 0; var tn: i64 = 0;
    var b: i32 = 0;
    while b < NN_K {
        wr(1, "  band "); wr_int(1, b as i64);
        wr(1, " n "); wr_int(1, ne[b]);
        if ne[b] > 0 {
            wr(1, "  model_mse "); wr_int(1, sse[b] / ne[b]);
            wr(1, "  predict0 "); wr_int(1, sse0[b] / ne[b]);
            if sse[b] < sse0[b] { wr(1, "  ADMITTED"); } else { wr(1, "  REFUSED"); }
        }
        wr(1, "\n");
        tsse = tsse + sse[b]; tsse0 = tsse0 + sse0[b]; tn = tn + ne[b];
        b = b + 1;
    }
    wr(1, "  overall model_mse ");
    if tn > 0 { wr_int(1, tsse / tn); } else { wr_int(1, 0); }
    wr(1, "  predict0 ");
    if tn > 0 { wr_int(1, tsse0 / tn); } else { wr_int(1, 0); }
    wr(1, "\n");
    set_startpos();
}

fn pst_dump(path: *u8, games: i32, playdepth: i32) {
    nn_tr_alloc();
    g_tr_ngames = 0; g_tr_fill = 0;
    g_tr_rng = 0x9E3779B97F4A7C15;
    let save_probe: i32 = g_tbprobe; g_tbprobe = 0;
    var g: i32 = 0;
    while g < games {
        if g_tr_fill + 201 > TR_MAXMOVES { g = games; }
        else { let ropen: i32 = 4 + (nn_rng_next() % 9) as i32; nn_play_game(ropen, playdepth, 200); g = g + 1; }
    }
    g_tbprobe = save_probe;
    let NF: i32 = PST_NF;
    let A: *i64 = alloc(NF * NF);
    let bv: *i64 = alloc(NF);
    var z: i32 = 0;
    while z < NF * NF { A[z] = 0; z = z + 1; }
    z = 0;
    while z < NF { bv[z] = 0; z = z + 1; }
    var fidx: [i32; 40] = 0;
    var fval: [i64; 40] = 0;
    var rows: i64 = 0;
    let ndump: i32 = g_tr_ngames * 4 / 5;        // train split only
    var gg: i32 = 0;
    while gg < ndump {
        let start: i32 = g_tr_gstart[gg];
        let len: i32 = g_tr_glen[gg];
        let ropen: i32 = g_tr_gopen[gg];
        set_startpos();
        var ply: i32 = 0;
        while ply < len {
            if ply >= ropen {
                let cnt: i32 = pst_features(&fidx[0], &fval[0]);
                var tv: i64 = td_clamp(g_tr_sc[start + ply], 100);
                if g_side == BLACK { tv = 0 - tv; }
                var a: i32 = 0;
                while a < cnt {
                    let ia: i32 = fidx[a];
                    bv[ia] = bv[ia] + fval[a] * tv;
                    var b2: i32 = 0;
                    while b2 < cnt {
                        A[ia * NF + fidx[b2]] = A[ia * NF + fidx[b2]] + fval[a] * fval[b2];
                        b2 = b2 + 1;
                    }
                    a = a + 1;
                }
                rows = rows + 1;
            }
            make_move(g_tr_moves[start + ply]);
            ply = ply + 1;
        }
        gg = gg + 1;
    }
    let keep: *i32 = alloc(NF);
    var n2: i32 = 0;
    var i: i32 = 0;
    while i < NF {
        if A[i * NF + i] != 0 { keep[n2] = i; n2 = n2 + 1; }
        i = i + 1;
    }
    let fd: i32 = creat(path, 438);
    if fd < 0 { wr(1, "pstdump: cannot create file\n"); return; }
    wr_int(fd, n2 as i64); wr(fd, "\n");
    i = 0;
    while i < n2 { wr_int(fd, keep[i] as i64); wr(fd, " "); i = i + 1; }
    wr(fd, "\n");
    i = 0;
    while i < n2 {
        var j: i32 = 0;
        while j < n2 {
            wr_int(fd, A[keep[i] * NF + keep[j]]); wr(fd, " ");
            j = j + 1;
        }
        wr(fd, "\n");
        i = i + 1;
    }
    i = 0;
    while i < n2 { wr_int(fd, bv[keep[i]]); wr(fd, " "); i = i + 1; }
    wr(fd, "\n");
    close(fd);
    wr(1, "pstdump n "); wr_int(1, n2 as i64);
    wr(1, " (of "); wr_int(1, NF as i64);
    wr(1, ")  rows "); wr_int(1, rows);
    wr(1, "  games "); wr_int(1, ndump as i64); wr(1, "\n");
    set_startpos();
}

// ============ solve corpus + gate ============
fn td_count_diffs(d: *i64) {
    var i: i32 = 0;
    while i < 5 { d[i] = 0; i = i + 1; }
    var sq: i32 = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if p != EMPTY { if p != OFF {
            let side: i32 = piece_side(p);
            let kind: i32 = p - side * 6;            // 1..6 = P N B R Q K
            if kind >= 1 { if kind <= 5 {
                if side == WHITE { d[kind - 1] = d[kind - 1] + 1; }
                else { d[kind - 1] = d[kind - 1] - 1; }
            } }
        } }
        sq = sq + 1;
    }
}
fn td_dump(path: *u8, games: i32, playdepth: i32) {
    nn_tr_alloc();
    g_tr_ngames = 0; g_tr_fill = 0;
    g_tr_rng = 0x9E3779B97F4A7C15;
    let save_probe: i32 = g_tbprobe; g_tbprobe = 0;
    var g: i32 = 0;
    while g < games {
        if g_tr_fill + 201 > TR_MAXMOVES { g = games; }
        else { let ropen: i32 = 4 + (nn_rng_next() % 9) as i32; nn_play_game(ropen, playdepth, 200); g = g + 1; }
    }
    g_tbprobe = save_probe;
    let fd: i32 = creat(path, 438);
    if fd < 0 { wr(1, "tddump: cannot create file\n"); return; }
    wr(fd, "game,ply,dp,dn,db,dr,dq,tdv\n");
    let ndump: i32 = g_tr_ngames * 4 / 5;
    var rows: i64 = 0;
    var gg: i32 = 0;
    while gg < ndump {
        let start: i32 = g_tr_gstart[gg];
        let len: i32 = g_tr_glen[gg];
        let ropen: i32 = g_tr_gopen[gg];
        set_startpos();
        var ply: i32 = 0;
        while ply < len {
            if ply >= ropen {
                var d: [i64; 5] = 0;
                td_count_diffs(&d[0]);
                var v: i64 = td_clamp(g_tr_sc[start + ply], 100);
                if g_side == BLACK { v = 0 - v; }
                wr_int(fd, gg as i64); wr(fd, ",");
                wr_int(fd, ply as i64); wr(fd, ",");
                var k: i32 = 0;
                while k < 5 { wr_int(fd, d[k]); wr(fd, ","); k = k + 1; }
                wr_int(fd, v); wr(fd, "\n");
                rows = rows + 1;
            }
            make_move(g_tr_moves[start + ply]);
            ply = ply + 1;
        }
        gg = gg + 1;
    }
    close(fd);
    wr(1, "tddump rows "); wr_int(1, rows);
    wr(1, " (games "); wr_int(1, g_tr_ngames as i64); wr(1, ")\n");
    set_startpos();
}
fn mat_gate(games: i32, playdepth: i32, w: *i64) {
    nn_tr_alloc();
    g_tr_ngames = 0; g_tr_fill = 0;
    g_tr_rng = 0x9E3779B97F4A7C15;
    let save_probe: i32 = g_tbprobe; g_tbprobe = 0;
    var g: i32 = 0;
    while g < games {
        if g_tr_fill + 201 > TR_MAXMOVES { g = games; }
        else { let ropen: i32 = 4 + (nn_rng_next() % 9) as i32; nn_play_game(ropen, playdepth, 200); g = g + 1; }
    }
    g_tbprobe = save_probe;
    let ntrain: i32 = g_tr_ngames * 4 / 5;
    var ne: [i64; 8] = 0;
    var sse: [i64; 8] = 0;
    var sse0: [i64; 8] = 0;
    var gg: i32 = ntrain;
    while gg < g_tr_ngames {
        let start: i32 = g_tr_gstart[gg];
        let len: i32 = g_tr_glen[gg];
        let ropen: i32 = g_tr_gopen[gg];
        set_startpos();
        var ply: i32 = 0;
        while ply < len {
            if ply >= ropen {
                var d: [i64; 5] = 0;
                td_count_diffs(&d[0]);
                var acc: i64 = w[0];                     // bias (Q20)
                var k: i32 = 0;
                while k < 5 { acc = acc + w[k + 1] * d[k]; k = k + 1; }
                let V: i64 = acc >> 20;                  // white-relative model output
                var tgt: i64 = td_clamp(g_tr_sc[start + ply], 100);
                if g_side == BLACK { tgt = 0 - tgt; }
                let band: i32 = nn_route();
                let e: i64 = V - tgt;
                ne[band] = ne[band] + 1;
                sse[band] = sse[band] + e * e;
                sse0[band] = sse0[band] + tgt * tgt;
            }
            make_move(g_tr_moves[start + ply]);
            ply = ply + 1;
        }
        gg = gg + 1;
    }
    wr(1, "matgate (exact 6-param linear model, held-out games, per band):\n");
    var tsse: i64 = 0; var tsse0: i64 = 0; var tn: i64 = 0;
    var b: i32 = 0;
    while b < NN_K {
        wr(1, "  band "); wr_int(1, b as i64);
        wr(1, " n "); wr_int(1, ne[b]);
        if ne[b] > 0 {
            wr(1, "  model_mse "); wr_int(1, sse[b] / ne[b]);
            wr(1, "  predict0 "); wr_int(1, sse0[b] / ne[b]);
            if sse[b] < sse0[b] { wr(1, "  ADMITTED"); } else { wr(1, "  REFUSED"); }
        }
        wr(1, "\n");
        tsse = tsse + sse[b]; tsse0 = tsse0 + sse0[b]; tn = tn + ne[b];
        b = b + 1;
    }
    wr(1, "  overall model_mse ");
    if tn > 0 { wr_int(1, tsse / tn); } else { wr_int(1, 0); }
    wr(1, "  predict0 ");
    if tn > 0 { wr_int(1, tsse0 / tn); } else { wr_int(1, 0); }
    wr(1, "\n");
    set_startpos();
}

// nnue file format v1: 40-byte header [magic, NFH, H, K, BAND] i64 LE, then FT, w2.
// loud loader: any failure -> named ERR line, weights re-init, return 0.
fn put_i64le(buf: *u8, off: i32, v: i64) {
    var x: i64 = v; var i: i32 = 0;
    while i < 8 { buf[off + i] = (x & 255) as u8; x = x >> 8; i = i + 1; }
}
fn get_i64le(buf: *u8, off: i32) -> i64 {
    var v: i64 = 0; var i: i32 = 7;
    while i >= 0 { v = (v << 8) | ((buf[off + i] as i64) & 255); i = i - 1; }
    return v;
}
fn nn_hdr_magic() -> i64 {                   // "WNDRNN02" packed LE (87 78 68 82 78 78 48 50)
    var m: i64 = 50;
    m = (m << 8) | 48; m = (m << 8) | 78; m = (m << 8) | 78;
    m = (m << 8) | 82; m = (m << 8) | 68; m = (m << 8) | 78; m = (m << 8) | 87;
    return m;
}
fn nn_write_all(fd: i32, buf: *u8, n: i32) -> i32 {
    var off: i32 = 0;
    while off < n {
        let w: i64 = write(fd, &buf[off], (n - off) as usize);
        if w <= 0 { return 0; }
        off = off + (w as i32);
    }
    return 1;
}
fn nn_read_all(fd: i32, buf: *u8, n: i32) -> i32 {
    var off: i32 = 0;
    while off < n {
        let r: i64 = read(fd, &buf[off], (n - off) as usize);
        if r <= 0 { return 0; }
        off = off + (r as i32);
    }
    return 1;
}
fn nn_save(path: *u8) -> i32 {
    let fd: i32 = creat(path, 420);          // 0644
    if fd < 0 { wr(1, "nnue save ERR open\n"); return 0; }
    var hdr: [u8; 56] = 0;
    put_i64le(&hdr[0], 0, nn_hdr_magic());
    put_i64le(&hdr[0], 8, NN_NFH as i64);
    put_i64le(&hdr[0], 16, NN_H as i64);
    put_i64le(&hdr[0], 24, NN_K as i64);
    put_i64le(&hdr[0], 32, NN_BAND as i64);
    put_i64le(&hdr[0], 40, NN_KFT);
    put_i64le(&hdr[0], 48, NN_KW2);
    if nn_write_all(fd, &hdr[0], 56) == 0 { close(fd); wr(1, "nnue save ERR hdr\n"); return 0; }
    if nn_write_all(fd, g_nn_ft as *u8, NN_NFH * NN_H * 2) == 0 { close(fd); wr(1, "nnue save ERR ft\n"); return 0; }
    if nn_write_all(fd, g_nn_w2 as *u8, NN_K * 2 * NN_H) == 0 { close(fd); wr(1, "nnue save ERR w2\n"); return 0; }
    close(fd);
    return 1;
}
fn nn_load_dimerr(fd: i32, name: *u8, filev: i64, buildv: i64) {
    close(fd);
    wr(1, "nnue load ERR dim "); wr(1, name);
    wr(1, " file "); wr_int(1, filev);
    wr(1, " build "); wr_int(1, buildv); wr(1, "\n");
    nn_init_weights();
}
fn nn_load(path: *u8) -> i32 {
    nn_fin_flush();
    let fd: i32 = open(path, 0, 0);          // O_RDONLY
    if fd < 0 { wr(1, "nnue load ERR open\n"); nn_init_weights(); return 0; }
    var hdr: [u8; 56] = 0;
    if nn_read_all(fd, &hdr[0], 56) == 0 { close(fd); wr(1, "nnue load ERR short-header\n"); nn_init_weights(); return 0; }
    if get_i64le(&hdr[0], 0) != nn_hdr_magic() { close(fd); wr(1, "nnue load ERR magic\n"); nn_init_weights(); return 0; }
    if get_i64le(&hdr[0], 8) != NN_NFH as i64 { nn_load_dimerr(fd, "NFH", get_i64le(&hdr[0], 8), NN_NFH as i64); return 0; }
    if get_i64le(&hdr[0], 16) != NN_H as i64 { nn_load_dimerr(fd, "H", get_i64le(&hdr[0], 16), NN_H as i64); return 0; }
    if get_i64le(&hdr[0], 24) != NN_K as i64 { nn_load_dimerr(fd, "K", get_i64le(&hdr[0], 24), NN_K as i64); return 0; }
    if get_i64le(&hdr[0], 32) != NN_BAND as i64 { nn_load_dimerr(fd, "BAND", get_i64le(&hdr[0], 32), NN_BAND as i64); return 0; }
    if get_i64le(&hdr[0], 40) != NN_KFT { nn_load_dimerr(fd, "KFT", get_i64le(&hdr[0], 40), NN_KFT); return 0; }
    if get_i64le(&hdr[0], 48) != NN_KW2 { nn_load_dimerr(fd, "KW2", get_i64le(&hdr[0], 48), NN_KW2); return 0; }
    if nn_read_all(fd, g_nn_ft as *u8, NN_NFH * NN_H * 2) == 0 { close(fd); wr(1, "nnue load ERR short-ft\n"); nn_init_weights(); return 0; }
    if nn_read_all(fd, g_nn_w2 as *u8, NN_K * 2 * NN_H) == 0 { close(fd); wr(1, "nnue load ERR short-w2\n"); nn_init_weights(); return 0; }
    var extra: [u8; 1] = 0;                   // exact-size probe: one more byte must be EOF
    let more: i64 = read(fd, &extra[0], 1);
    close(fd);
    if more > 0 { wr(1, "nnue load ERR size (trailing bytes)\n"); nn_init_weights(); return 0; }
    return 1;
}

// ================= nnue corpus dump (train_mlx.py input) =================
// CSV: game,band,side,target,wfeats,bfeats,eval,fen (feats = active indices per
// perspective; eval = classical evaluate(), side-to-move — the residual base).
fn nn_dump_feats(fd: i32, persp: i32) -> i32 {
    var cnt: i32 = 0;
    var sq: i32 = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if nn_pt(p) >= 0 {
            if cnt > 0 { wr(fd, " "); }
            wr_int(fd, nn_feat(persp, p, sq) as i64);
            cnt = cnt + 1;
        }
        sq = sq + 1;
    }
    return cnt;
}
fn nn_dump(path: *u8, games: i32, playdepth: i32, seed: i64) {
    nn_tr_alloc();
    nn_init_weights();
    g_nnue_on = 0;
    g_tr_ngames = 0; g_tr_fill = 0;
    g_tr_rng = seed;
    if g_tbprobe >= 1 { if g_tbq == null { wr(1, "building certified tables (KQK+KRK)...\n"); tb_build_all(); } }
    var g: i32 = 0;
    while g < games {
        if g_tr_fill + 201 > TR_MAXMOVES { g = games; }
        else { let ropen: i32 = 4 + (nn_rng_next() % 9) as i32; nn_play_game(ropen, playdepth, 200); g = g + 1; }
    }
    if g_ph_fen == null { g_ph_fen = alloc(128); }
    let fd: i32 = creat(path, 438);
    if fd < 0 { wr(1, "nnue dump: cannot create file\n"); return; }
    wr(fd, "game,band,side,target,wfeats,bfeats,eval,fen,z\n");
    var rows: i64 = 0;
    var gg: i32 = 0;
    while gg < g_tr_ngames {
        let start: i32 = g_tr_gstart[gg];
        let len: i32 = g_tr_glen[gg];
        let ropen: i32 = g_tr_gopen[gg];
        let zw: i64 = g_tr_gz[gg] as i64;
        set_startpos();
        var ply: i32 = 0;
        while ply < len {
            if ply >= ropen {
                var zstm: i64 = zw * 100;                      // outcome, side-to-move (x100)
                if g_side == BLACK { zstm = 0 - zstm; }
                var tgt: i64 = zstm;
                if g_tdlabel == 1 { tgt = td_clamp(g_tr_sc[start + ply], 100); }
                wr_int(fd, gg as i64); wr(fd, ",");
                wr_int(fd, nn_route() as i64); wr(fd, ",");
                wr_int(fd, g_side as i64); wr(fd, ",");
                wr_int(fd, tgt); wr(fd, ",");
                nn_dump_feats(fd, WHITE); wr(fd, ",");
                nn_dump_feats(fd, BLACK); wr(fd, ",");
                wr_int(fd, evaluate() as i64); wr(fd, ",");
                phi_fen_build(); wr(fd, g_ph_fen); wr(fd, ",");
                wr_int(fd, zstm); wr(fd, "\n");
                rows = rows + 1;
            }
            make_move(g_tr_moves[start + ply]);
            ply = ply + 1;
        }
        gg = gg + 1;
    }
    close(fd);
    wr(1, "nnue dump rows "); wr_int(1, rows);
    wr(1, " games "); wr_int(1, g_tr_ngames as i64);
    wr(1, " seed "); wr_int(1, seed); wr(1, "\n");
    set_startpos();
}

// ============ sibling dump (rank_mlx.py input): move-ordering ground truth ============
// one row per (parent, legal move): parent,band,side,target,wfeats,bfeats,eval,fen
// where target = ID-search value of the CHILD to depth dd (child side-to-move,
// like eval) — the deep ordering truth for rank-sensitive admission.
fn nn_dumpsib(path: *u8, games: i32, playdepth: i32, seed: i64, deepd: i32, stride: i32) {
    nn_tr_alloc();
    nn_init_weights();
    g_nnue_on = 0;
    g_tr_ngames = 0; g_tr_fill = 0;
    g_tr_rng = seed;
    if g_tbprobe >= 1 { if g_tbq == null { wr(1, "building certified tables (KQK+KRK)...\n"); tb_build_all(); } }
    var g: i32 = 0;
    while g < games {
        if g_tr_fill + 201 > TR_MAXMOVES { g = games; }
        else { let ropen: i32 = 4 + (nn_rng_next() % 9) as i32; nn_play_game(ropen, playdepth, 200); g = g + 1; }
    }
    if g_ph_fen == null { g_ph_fen = alloc(128); }
    let fd: i32 = creat(path, 438);
    if fd < 0 { wr(1, "nnue dumpsib: cannot create file\n"); return; }
    wr(fd, "parent,band,side,target,wfeats,bfeats,eval,fen\n");
    var parent: i64 = 0;
    var rows: i64 = 0;
    var gg: i32 = 0;
    while gg < g_tr_ngames {
        let start: i32 = g_tr_gstart[gg];
        let len: i32 = g_tr_glen[gg];
        let ropen: i32 = g_tr_gopen[gg];
        set_startpos();
        var npar: i32 = 0;                        // per-game parent cap
        var ply: i32 = 0;
        while ply < len {
            if ply >= ropen && (ply - ropen) % stride == 0 && npar < 8 {
                gen_moves(0, 0);
                var nleg: i32 = 0;                // count legal children first
                var lm: i32 = g_first[0];
                let lm_hi: i32 = g_first[1];
                while lm < lm_hi {
                    if make_move(g_mv[lm]) == 1 { unmake_move(); nleg = nleg + 1; }
                    lm = lm + 1;
                }
                if nleg >= 2 {
                    clear_search_tables();        // once per parent; siblings share TT
                    lm = g_first[0];
                    while lm < lm_hi {
                        if make_move(g_mv[lm]) == 1 {
                            g_nodes = 0; g_stop = 0; g_bestroot = 0; g_budget = 0;
                            var sc: i32 = 0;
                            var dd: i32 = 1;
                            while dd <= deepd { sc = search(0 - INF, INF, dd, 0, 1); dd = dd + 1; }
                            wr_int(fd, parent); wr(fd, ",");
                            wr_int(fd, nn_route() as i64); wr(fd, ",");
                            wr_int(fd, g_side as i64); wr(fd, ",");
                            wr_int(fd, sc as i64); wr(fd, ",");
                            nn_dump_feats(fd, WHITE); wr(fd, ",");
                            nn_dump_feats(fd, BLACK); wr(fd, ",");
                            wr_int(fd, evaluate() as i64); wr(fd, ",");
                            phi_fen_build(); wr(fd, g_ph_fen); wr(fd, "\n");
                            rows = rows + 1;
                            unmake_move();
                        }
                        lm = lm + 1;
                    }
                    parent = parent + 1;
                    npar = npar + 1;
                }
            }
            make_move(g_tr_moves[start + ply]);
            ply = ply + 1;
        }
        gg = gg + 1;
    }
    close(fd);
    wr(1, "nnue dumpsib rows "); wr_int(1, rows);
    wr(1, " parents "); wr_int(1, parent);
    wr(1, " games "); wr_int(1, g_tr_ngames as i64);
    wr(1, " seed "); wr_int(1, seed); wr(1, "\n");
    set_startpos();
}

// ============ net-in-loop self-play dump (eval-replacement training) ============
// plays self-play with the CURRENTLY LOADED net at the current `nnue mode`, then
// dumps game,band,side,target,mat,wfeats,bfeats,fen where target = deep searched
// value (side-to-move, wide-clamped) and mat = signed material. the net trains to
// predict target - mat; deployment (mode 2) = material + net. iter0 uses mode 0
// (classical bootstrap); iter N uses mode 2 (net-reached distribution).
fn nn_dumpself(path: *u8, games: i32, playdepth: i32, seed: i64) {
    nn_tr_alloc();                                // NOTE: no nn_init_weights — keep loaded net
    g_tr_ngames = 0; g_tr_fill = 0;
    g_tr_rng = seed;
    if g_tbprobe >= 1 { if g_tbq == null { wr(1, "building certified tables (KQK+KRK)...\n"); tb_build_all(); } }
    g_nnue_on = 1;                                // engage accumulator for net-eval self-play
    var g: i32 = 0;
    while g < games {
        if g_tr_fill + 201 > TR_MAXMOVES { g = games; }
        else { let ropen: i32 = 4 + (nn_rng_next() % 9) as i32; nn_play_game(ropen, playdepth, 200); g = g + 1; }
    }
    g_nnue_on = 0;
    if g_ph_fen == null { g_ph_fen = alloc(128); }
    let fd: i32 = creat(path, 438);
    if fd < 0 { wr(1, "nnue dumpself: cannot create file\n"); return; }
    wr(fd, "game,band,side,target,eval,mat,wfeats,bfeats,fen\n");
    var rows: i64 = 0;
    var gg: i32 = 0;
    while gg < g_tr_ngames {
        let start: i32 = g_tr_gstart[gg];
        let len: i32 = g_tr_glen[gg];
        let ropen: i32 = g_tr_gopen[gg];
        set_startpos();
        var ply: i32 = 0;
        while ply < len {
            if ply >= ropen {
                var tgt: i64 = g_tr_sc[start + ply] as i64;   // net-search deep value, wide-clamped
                if tgt > 2000 { tgt = 2000; }
                if tgt < 0 - 2000 { tgt = 0 - 2000; }
                let sm: i32 = g_eval_mode; g_eval_mode = 0;   // pure classical eval (residual base)
                let cev: i32 = evaluate();
                g_eval_mode = sm;
                wr_int(fd, gg as i64); wr(fd, ",");
                wr_int(fd, nn_route() as i64); wr(fd, ",");
                wr_int(fd, g_side as i64); wr(fd, ",");
                wr_int(fd, tgt); wr(fd, ",");
                wr_int(fd, cev as i64); wr(fd, ",");
                wr_int(fd, material_stm() as i64); wr(fd, ",");
                nn_dump_feats(fd, WHITE); wr(fd, ",");
                nn_dump_feats(fd, BLACK); wr(fd, ",");
                phi_fen_build(); wr(fd, g_ph_fen); wr(fd, "\n");
                rows = rows + 1;
            }
            make_move(g_tr_moves[start + ply]);
            ply = ply + 1;
        }
        gg = gg + 1;
    }
    close(fd);
    wr(1, "nnue dumpself rows "); wr_int(1, rows);
    wr(1, " games "); wr_int(1, g_tr_ngames as i64);
    wr(1, " mode "); wr_int(1, g_eval_mode as i64);
    wr(1, " seed "); wr_int(1, seed); wr(1, "\n");
    set_startpos();
}

// ================= nnue import (v1f float export -> canonical v2) =================
// v1f: 40-byte header [magic "WNDRNF01", NFH, H, K, BAND] i64 LE, then raw f32 LE
// feature-major. Quantize via quant.tv at the pinned NN_KFT/NN_KW2 scales
// (round-half-away, clamp +/-127); inf/nan refuse the whole import.
fn nn_impf_magic() -> i64 {                  // "WNDRNF01" packed LE (87 78 68 82 78 70 48 49)
    var m: i64 = 49;
    m = (m << 8) | 48; m = (m << 8) | 70; m = (m << 8) | 78;
    m = (m << 8) | 82; m = (m << 8) | 68; m = (m << 8) | 78; m = (m << 8) | 87;
    return m;
}
fn nn_f32_bits(buf: *u8, off: i32) -> i64 {
    var v: i64 = 0; var i: i32 = 3;
    while i >= 0 { v = (v << 8) | ((buf[off + i] as i64) & 255); i = i - 1; }
    return v;
}
// quantize one f32 from the buffer via quant.tv (exact scaled round + clamp).
// returns 0 ok (q written), 1 non-finite (caller refuses the whole import).
fn nn_f32_quant(buf: *u8, off: i32, k: i64, qmax: i64, q: *i64, nsub: *i64) -> i32 {
    return quant_f32(nn_f32_bits(buf, off), k, qmax, q, nsub);
}
fn nn_import(path: *u8) -> i32 {
    nn_fin_flush();
    let fd: i32 = open(path, 0, 0);
    if fd < 0 { wr(1, "nnue import ERR open\n"); return 0; }
    var hdr: [u8; 40] = 0;
    if nn_read_all(fd, &hdr[0], 40) == 0 { close(fd); wr(1, "nnue import ERR short-header\n"); return 0; }
    if get_i64le(&hdr[0], 0) != nn_impf_magic() { close(fd); wr(1, "nnue import ERR magic\n"); return 0; }
    if get_i64le(&hdr[0], 8) != NN_NFH as i64 { nn_load_dimerr(fd, "NFH", get_i64le(&hdr[0], 8), NN_NFH as i64); return 0; }
    if get_i64le(&hdr[0], 16) != NN_H as i64 { nn_load_dimerr(fd, "H", get_i64le(&hdr[0], 16), NN_H as i64); return 0; }
    if get_i64le(&hdr[0], 24) != NN_K as i64 { nn_load_dimerr(fd, "K", get_i64le(&hdr[0], 24), NN_K as i64); return 0; }
    if get_i64le(&hdr[0], 32) != NN_BAND as i64 { nn_load_dimerr(fd, "BAND", get_i64le(&hdr[0], 32), NN_BAND as i64); return 0; }
    let nft: i32 = NN_H * NN_NFH;
    let nw2: i32 = NN_K * 2 * NN_H;
    let nbytes: i32 = (nft + nw2) * 4;
    let buf: *u8 = alloc(nbytes);
    if nn_read_all(fd, buf, nbytes) == 0 { close(fd); free(buf); wr(1, "nnue import ERR short-payload\n"); return 0; }
    var extra: [u8; 1] = 0;
    let more: i64 = read(fd, &extra[0], 1);
    close(fd);
    if more > 0 { free(buf); wr(1, "nnue import ERR size (trailing bytes)\n"); return 0; }
    var nsub: i64 = 0; var nz: i64 = 0; var wmin: i64 = 0; var wmax: i64 = 0;
    var qv: i64 = 0;
    var i: i32 = 0;
    while i < nft {
        if nn_f32_quant(buf, i * 4, NN_KFT, NN_QFT, &qv, &nsub) != 0 { free(buf); wr(1, "nnue import ERR non-finite ft\n"); nn_init_weights(); return 0; }
        g_nn_ft[i] = qv;
        if qv != 0 { nz = nz + 1; }
        if qv < wmin { wmin = qv; }
        if qv > wmax { wmax = qv; }
        i = i + 1;
    }
    i = 0;
    while i < nw2 {
        if nn_f32_quant(buf, (nft + i) * 4, NN_KW2, NN_QW2, &qv, &nsub) != 0 { free(buf); wr(1, "nnue import ERR non-finite w2\n"); nn_init_weights(); return 0; }
        g_nn_w2[i] = qv;
        i = i + 1;
    }
    free(buf);
    wr(1, "nnue import ok  ft nz "); wr_int(1, nz);
    wr(1, " min "); wr_int(1, wmin); wr(1, " max "); wr_int(1, wmax);
    wr(1, "  subnormals "); wr_int(1, nsub); wr(1, "\n");
    return 1;
}

// ============ certified-anchor rows (GAP 6 Joint A) ============
let AN_MAXROWS: i32 = 32768;
let AN_FENLEN: i32 = 96;             // tbcsv fens <= ~40 bytes; slack for later classes
var g_an_fen: *u8 = null;            // AN_MAXROWS x AN_FENLEN, nul-terminated
var g_an_z: *i32 = null;             // white-relative certified z in {-1,0,+1}
var g_an_dtm: *i32 = null;
var g_an_n: i32 = 0;
var g_an_buf: *u8 = null;            // 64K read scratch (persistent)

fn nn_an_alloc() {
    if g_an_fen == null {
        g_an_fen = alloc(AN_MAXROWS * AN_FENLEN);
        g_an_z = alloc(AN_MAXROWS);
        g_an_dtm = alloc(AN_MAXROWS);
        g_an_buf = alloc(65536);
    }
}
fn nn_anchor_load(path: *u8, stride: i32, cap: i32) {
    nn_an_alloc();
    let fd: i32 = open(path, 0, 0);
    if fd < 0 { wr(1, "nnue anchor: cannot open file\n"); return; }
    var lbuf: [u8; 256] = 0;
    var ll: i32 = 0;
    var first: i32 = 1;                  // header row flag
    var row: i64 = 0;                    // data-row counter
    var kept: i32 = 0;
    var nwin: i32 = 0;
    var ndraw: i32 = 0;
    var lim: i32 = g_an_n + cap;
    if lim > AN_MAXROWS { lim = AN_MAXROWS; }
    var done: i32 = 0;
    while done == 0 {
        let n: i64 = read(fd, g_an_buf, 65536);
        if n <= 0 { done = 1; }
        var i: i32 = 0;
        while i < n as i32 {
            let c: i32 = g_an_buf[i] as i32;
            if c == 10 {
                if first == 1 { first = 0; }
                else if ll > 0 {
                    if row % (stride as i64) == 0 { if g_an_n < lim {
                        var commas: [i32; 8] = 0;
                        var nc: i32 = 0;
                        var j: i32 = 0;
                        while j < ll {
                            if lbuf[j] as i32 == 44 { if nc < 8 { commas[nc] = j; } nc = nc + 1; }
                            j = j + 1;
                        }
                        let fl: i32 = commas[0];
                        if nc >= 6 { if fl > 0 { if fl < AN_FENLEN {
                            var dv: i64 = 0;
                            var neg: i32 = 0;
                            var k: i32 = commas[1] + 1;
                            if lbuf[k] as i32 == 45 { neg = 1; k = k + 1; }
                            while k < commas[2] { dv = dv * 10 + (lbuf[k] as i32 - 48) as i64; k = k + 1; }
                            if neg == 1 { dv = 0 - dv; }
                            var z: i32 = 0;                         // result: "1.0"/"0.5"/"0.0"
                            if lbuf[commas[4] + 1] as i32 == 49 { z = 1; }
                            else if commas[4] + 3 < ll { if lbuf[commas[4] + 3] as i32 == 48 { z = 0 - 1; } }
                            let base: i32 = g_an_n * AN_FENLEN;
                            var m: i32 = 0;
                            while m < fl { g_an_fen[base + m] = lbuf[m]; m = m + 1; }
                            g_an_fen[base + fl] = 0;
                            g_an_z[g_an_n] = z;
                            g_an_dtm[g_an_n] = dv as i32;
                            g_an_n = g_an_n + 1;
                            kept = kept + 1;
                            if z == 0 { ndraw = ndraw + 1; } else { nwin = nwin + 1; }
                        } } }
                    } }
                    row = row + 1;
                }
                ll = 0;
            } else if c != 13 {
                if ll < 255 { lbuf[ll] = g_an_buf[i]; ll = ll + 1; }
            }
            i = i + 1;
        }
    }
    close(fd);
    wr(1, "nnue anchor kept "); wr_int(1, kept as i64);
    wr(1, " of "); wr_int(1, row);
    wr(1, " rows (win "); wr_int(1, nwin as i64);
    wr(1, " draw "); wr_int(1, ndraw as i64);
    wr(1, ")  total "); wr_int(1, g_an_n as i64); wr(1, "\n");
}
fn nn_anchor_replay(a0: i32, a1: i32, scale: i64, do_train: i32, sh: i64) -> i64 {
    var sse: i64 = 0;
    var chunk: i32 = 0;
    if do_train == 1 { nn_zero_grads(); }
    var i: i32 = a0;
    while i < a1 {
        let base: i32 = i * AN_FENLEN;
        var fl: i32 = 0;
        while g_an_fen[base + fl] != 0 { fl = fl + 1; }
        parse_fen(&g_an_fen[base], fl);
        nn_recompute_all();
        let z64: i64 = g_an_z[i] as i64;
        var tgt: i64 = z64 * scale;
        if g_side == BLACK { tgt = 0 - tgt; }
        if do_train == 1 {
            sse = sse + nn_backward(tgt);
            chunk = chunk + 1;
            if chunk >= 128 { nn_sgd_step(sh); nn_zero_grads(); chunk = 0; }
        } else {
            let e: i64 = nn_eval() - tgt;
            sse = sse + e * e;
        }
        i = i + 1;
    }
    if do_train == 1 { if chunk > 0 { nn_sgd_step(sh); } }
    return sse;
}
fn nn_anchor_signacc(a0: i32, a1: i32, out: *i32) {
    var ok: i32 = 0;
    var tot: i32 = 0;
    var i: i32 = a0;
    while i < a1 {
        if g_an_z[i] != 0 {
            let base: i32 = i * AN_FENLEN;
            var fl: i32 = 0;
            while g_an_fen[base + fl] != 0 { fl = fl + 1; }
            parse_fen(&g_an_fen[base], fl);
            nn_recompute_all();
            var zs: i32 = g_an_z[i];
            if g_side == BLACK { zs = 0 - zs; }
            let v: i64 = nn_eval();
            if zs > 0 { if v > 0 { ok = ok + 1; } }
            else { if v < 0 { ok = ok + 1; } }
            tot = tot + 1;
        }
        i = i + 1;
    }
    out[0] = ok;
    out[1] = tot;
}

// ---------------- evaluation ----------------

fn count_mobility(sq: i32, p: i32) -> i32 {
    let side: i32 = piece_side(p);
    let kind: i32 = p - side * 6;        // 1..6, white-relative
    var cnt: i32 = 0;
    if kind == WN {
        var ni: i32 = 0;
        while ni < 8 {
            let c: i32 = g_board[sq + g_kdir[ni]];
            if c != OFF { if c == EMPTY || piece_side(c) != side { cnt = cnt + 1; } }
            ni = ni + 1;
        }
        return cnt;
    }
    var lo: i32 = 0;
    var hi: i32 = 8;
    if kind == WB { hi = 4; }
    else if kind == WR { lo = 4; }
    var di: i32 = lo;
    while di < hi {
        var dv: i32 = 0;
        if di < 4 { dv = g_bdir[di]; } else { dv = g_rdir[di - 4]; }
        var t: i32 = sq + dv;
        while g_board[t] == EMPTY { cnt = cnt + 1; t = t + dv; }
        if g_board[t] != OFF { if piece_side(g_board[t]) != side { cnt = cnt + 1; } }
        di = di + 1;
    }
    return cnt;
}

// ---------------- attacker-based king safety (measurement meter) ----------------

fn in_kzone(t: i32) -> i32 {
    var i: i32 = 0;
    while i < g_kzc {
        if g_kzsq[i] == t { return 1; }
        i = i + 1;
    }
    return 0;
}

fn zone_attacks(sq: i32, p: i32) -> i32 {
    let side: i32 = piece_side(p);
    let kind: i32 = p - side * 6;        // 1..6, white-relative
    var cnt: i32 = 0;
    if kind == WN {
        var ni: i32 = 0;
        while ni < 8 {
            if in_kzone(sq + g_kdir[ni]) == 1 { cnt = cnt + 1; }
            ni = ni + 1;
        }
        return cnt;
    }
    var lo: i32 = 0;
    var hi: i32 = 8;
    if kind == WB { hi = 4; }
    else if kind == WR { lo = 4; }
    else if kind != WQ { return 0; }
    var di: i32 = lo;
    while di < hi {
        var dv: i32 = 0;
        if di < 4 { dv = g_bdir[di]; } else { dv = g_rdir[di - 4]; }
        var t: i32 = sq + dv;
        while g_board[t] != OFF {
            if in_kzone(t) == 1 { cnt = cnt + 1; }
            if g_board[t] != EMPTY { break; }
            t = t + dv;
        }
        di = di + 1;
    }
    return cnt;
}

fn king_danger(kside: i32) -> i32 {
    let atk: i32 = 1 - kside;
    let ksq: i32 = g_ksq[kside];

    g_kzc = 0;
    g_kzsq[g_kzc] = ksq;
    g_kzc = g_kzc + 1;
    var zi: i32 = 0;
    while zi < 8 {
        let z: i32 = ksq + g_kingd[zi];
        if g_board[z] != OFF {
            g_kzsq[g_kzc] = z;
            g_kzc = g_kzc + 1;
        }
        zi = zi + 1;
    }

    var attackers: i32 = 0;
    var value: i32 = 0;
    var sq: i32 = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if p != EMPTY && p != OFF {
            if piece_side(p) == atk {
                let kind: i32 = p - atk * 6;      // 1..6
                if kind == WN || kind == WB || kind == WR || kind == WQ {
                    let za: i32 = zone_attacks(sq, p);
                    if za > 0 {
                        attackers = attackers + 1;
                        var w: i32 = 20;             // knight / bishop
                        if kind == WR { w = 40; }
                        else if kind == WQ { w = 80; }
                        value = value + w * za;
                    }
                }
            }
        }
        sq = sq + 1;
    }

    var n: i32 = attackers;
    if n > 7 { n = 7; }
    g_kd_raw = value;
    g_kd_att = attackers;
    return value * g_ksmult[n] / 100;
}

fn is_hole(z: i32, kside: i32) -> i32 {
    if kside == WHITE {
        var t: i32 = z - 9;
        while g_board[t] != OFF { if g_board[t] == WP { return 0; } t = t - 10; }
        var u: i32 = z - 11;
        while g_board[u] != OFF { if g_board[u] == WP { return 0; } u = u - 10; }
    } else {
        var t2: i32 = z + 9;
        while g_board[t2] != OFF { if g_board[t2] == BP { return 0; } t2 = t2 + 10; }
        var u2: i32 = z + 11;
        while g_board[u2] != OFF { if g_board[u2] == BP { return 0; } u2 = u2 + 10; }
    }
    return 1;
}

fn king_holes(kside: i32) -> i32 {
    let ksq: i32 = g_ksq[kside];
    var holes: i32 = 0;
    var j: i32 = 0;
    while j < 8 {
        let z: i32 = ksq + g_kingd[j];
        if g_board[z] != OFF {
            var fp: i32 = 0;
            if kside == WHITE { if g_board[z] == WP { fp = 1; } }
            else { if g_board[z] == BP { fp = 1; } }
            if fp == 0 {
                if is_hole(z, kside) == 1 { holes = holes + 1; }
            }
        }
        j = j + 1;
    }
    return holes;
}

fn king_weakness(kside: i32) -> i32 {
    let enemy: i32 = 1 - kside;
    let ksq: i32 = g_ksq[kside];
    var expo: i32 = 0;
    let a0: i32 = sq_attackers(ksq, enemy);
    let d0: i32 = sq_attackers(ksq, kside);
    if a0 > d0 { expo = expo + (a0 - d0); }
    var j: i32 = 0;
    while j < 8 {
        let z: i32 = ksq + g_kingd[j];
        if g_board[z] != OFF {
            let a: i32 = sq_attackers(z, enemy);
            let d: i32 = sq_attackers(z, kside);
            if a > d { expo = expo + (a - d); }
        }
        j = j + 1;
    }
    return expo;
}

// ---------- reachability: the PATH from attacker to weakness (the crux) ----------
fn knight_reach_flood(enemy: i32, reach: *i32) {
    var i: i32 = 0;
    while i < 120 { reach[i] = 9; i = i + 1; }
    let kn: i32 = WN + enemy * 6;
    var fa: [i32; 128] = 0;
    var fb: [i32; 128] = 0;
    var fc: i32 = 0;
    var sq: i32 = 21;
    while sq <= 98 {
        if g_board[sq] == kn { reach[sq] = 0; if fc < 128 { fa[fc] = sq; fc = fc + 1; } }
        sq = sq + 1;
    }
    var d: i32 = 0;
    while d < 2 {
        var nc: i32 = 0;
        var fi: i32 = 0;
        while fi < fc {
            let s: i32 = fa[fi];
            var m: i32 = 0;
            while m < 8 {
                let t: i32 = s + g_kdir[m];
                if g_board[t] != OFF {
                    if reach[t] > d + 1 { reach[t] = d + 1; if nc < 128 { fb[nc] = t; nc = nc + 1; } }
                }
                m = m + 1;
            }
            fi = fi + 1;
        }
        var c: i32 = 0;
        while c < nc { fa[c] = fb[c]; c = c + 1; }
        fc = nc;
        d = d + 1;
    }
}

fn slider_hits(sq: i32, atk: i32) -> i32 {
    let b: i32 = WB + atk * 6;
    let q: i32 = WQ + atk * 6;
    let rk: i32 = WR + atk * 6;
    var i: i32 = 0;
    while i < 4 {
        var t: i32 = sq + g_bdir[i];
        while g_board[t] != OFF {
            let p: i32 = g_board[t];
            if p != EMPTY { if p == b || p == q { return 1; } break; }
            t = t + g_bdir[i];
        }
        i = i + 1;
    }
    i = 0;
    while i < 4 {
        var t2: i32 = sq + g_rdir[i];
        while g_board[t2] != OFF {
            let p2: i32 = g_board[t2];
            if p2 != EMPTY { if p2 == rk || p2 == q { return 1; } break; }
            t2 = t2 + g_rdir[i];
        }
        i = i + 1;
    }
    return 0;
}

fn king_reach(kside: i32) -> i32 {
    let enemy: i32 = 1 - kside;
    var reach: [i32; 120] = 0;
    knight_reach_flood(enemy, &reach[0]);
    let ksq: i32 = g_ksq[kside];
    var score: i32 = 0;
    var j: i32 = 0;
    while j < 8 {
        let z: i32 = ksq + g_kingd[j];
        if g_board[z] != OFF {
            var fp: i32 = 0;
            if kside == WHITE { if g_board[z] == WP { fp = 1; } }
            else { if g_board[z] == BP { fp = 1; } }
            if fp == 0 {
                if is_hole(z, kside) == 1 {
                    var d: i32 = reach[z];
                    if slider_hits(z, enemy) == 1 { if d > 1 { d = 1; } }
                    if d <= 2 { score = score + (3 - d); }
                }
            }
        }
        j = j + 1;
    }
    return score;
}

// ---------------- danger state ----------------
let REG_TIN: i32 = 200;        // enter threshold (ROC operating point)
let REG_TOUT: i32 = 150;       // exit threshold (hysteresis, 3/4 of enter)
let REG_K: i32 = 2;            // consecutive plies >= TIN to ignite
let REG_G: i32 = 3;            // consecutive plies < TOUT to extinguish

var g_reg_state: i32 = 0;      // 0 quiet, 1 terror (the early warning is ON)
var g_reg_side: i32 = 0;       // which king is under fire while ON
var g_reg_above: i32 = 0;      // entry persistence counter
var g_reg_below: i32 = 0;      // exit grace counter
var g_reg_onset: i32 = 0;      // stream ply at the last ignition
var g_reg_events: i32 = 0;     // ignitions this game
var g_reg_ply: i32 = 0;        // plies folded into the stream
var g_reg_dmax: i32 = 0;       // latest sample: max RAW danger to either king
var g_reg_base: i32 = 0;       // EMA of quiet-ply danger
var g_reg_phase: i32 = 0;      // 0 quiet (<80) / 1 ANTEROOM [80,200) / 2 terror
let REG_BAND: i32 = 80;        // anteroom floor (raw)

// ---------------- sense stream ----------------
var g_sn_rw: i32 = 0;          // raw danger to WHITE king
var g_sn_rb: i32 = 0;          // raw danger to BLACK king
var g_sn_hw: i32 = 0;
var g_sn_hb: i32 = 0;          // structural holes, black king zone
var g_sn_gw: i32 = 0;          // reach/path to white king's holes (the bridge)
var g_sn_gb: i32 = 0;          // reach/path to black king's holes
var g_sn_xw: i32 = 0;          // dynamic weakness (att>def) around white king
var g_sn_xb: i32 = 0;          // dynamic weakness around black king
var g_sn_npmat: i32 = 0;

fn regime_reset() {
    g_reg_state = 0; g_reg_side = 0; g_reg_above = 0; g_reg_below = 0;
    g_reg_onset = 0; g_reg_events = 0; g_reg_ply = 0; g_reg_dmax = 0;
    g_reg_base = 0; g_reg_phase = 0;
    g_sn_rw = 0; g_sn_rb = 0; g_sn_hw = 0; g_sn_hb = 0;
    g_sn_gw = 0; g_sn_gb = 0; g_sn_xw = 0; g_sn_xb = 0; g_sn_npmat = 0;
}

fn regime_update() {
    let sw: i32 = king_danger(WHITE);   // side effect: g_kd_raw = raw to white K
    let rww: i32 = g_kd_raw;
    let sb: i32 = king_danger(BLACK);   // side effect: g_kd_raw = raw to black K
    let rbb: i32 = g_kd_raw;
    g_sn_rw = rww;
    g_sn_rb = rbb;
    var dmax: i32 = rww;
    var side: i32 = WHITE;
    if rbb > rww { dmax = rbb; side = BLACK; }
    g_reg_dmax = dmax;
    if g_reg_state == 0 {
        g_reg_base = g_reg_base + (dmax - g_reg_base) / 8;
        if dmax >= REG_TIN {
            g_reg_above = g_reg_above + 1;
            if g_reg_above >= REG_K {
                g_reg_state = 1;
                g_reg_side = side;
                g_reg_onset = g_reg_ply;
                g_reg_events = g_reg_events + 1;
                g_reg_below = 0;
            }
        } else {
            g_reg_above = 0;
        }
    } else {
        if dmax < REG_TOUT {
            g_reg_below = g_reg_below + 1;
            if g_reg_below >= REG_G {
                g_reg_state = 0;
                g_reg_above = 0;
                g_reg_below = 0;
            }
        } else {
            g_reg_below = 0;
            g_reg_side = side;
        }
    }
    if g_reg_state == 1 {
        g_reg_phase = 2;
    } else if dmax >= REG_BAND && dmax < REG_TIN {
        g_reg_phase = 1;
    } else {
        g_reg_phase = 0;
    }
    g_reg_ply = g_reg_ply + 1;
    sense_update();
}

fn sense_update() {
    g_sn_hw = king_holes(WHITE);
    g_sn_hb = king_holes(BLACK);
    g_sn_gw = king_reach(WHITE);
    g_sn_gb = king_reach(BLACK);
    g_sn_xw = king_weakness(WHITE);
    g_sn_xb = king_weakness(BLACK);
    var npm: i32 = 0;
    var sq: i32 = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if p != EMPTY && p != OFF {
            let kind: i32 = p - piece_side(p) * 6;
            if kind != WP && kind != WK { npm = npm + g_pval[p]; }
        }
        sq = sq + 1;
    }
    g_sn_npmat = npm;
}

// ---- generalized stream -> decision policy (the anteroom, generalized) ----
let DECIDE_ADAPTIVE: i32 = 0;      // 0 = base (fixed anteroom) · 1 = dev (adaptive)
let REL_MARGIN: i32 = 60;

// smooth budget allocation: logistic band over the danger stream (permille gain)
let TC_CURVE: i32 = 0;             // 0 = binary extend (base) · 1 = curve (dev)
let TC_WIDTH: i32 = 30;            // logistic edge width (cp of raw danger)
let TC_GMAX: i32 = 900;            // permille scale; peak gain ~600 = x1.6
var g_tc_curve: i32 = TC_CURVE;

// algebraic sigmoid in permille: 500 + 500*x/(|x|+s); saturates to 0..1000
fn tc_sig(x: i32, s: i32) -> i32 {
    var ax: i32 = x;
    if ax < 0 { ax = 0 - ax; }
    return 500 + (500 * x) / (ax + s);
}

// rises past REG_BAND, falls past REG_TIN: extend the contested band, not the sealed
fn tc_gain(d: i32) -> i32 {
    let g: i32 = tc_sig(d - REG_BAND, TC_WIDTH) - tc_sig(d - REG_TIN, TC_WIDTH);
    return (g * TC_GMAX) / 1000;
}

fn decide_extend() -> i32 {
    if g_reg_phase == 1 { return 1; }
    if DECIDE_ADAPTIVE == 1 {
        if g_reg_state == 0 {
            if g_reg_dmax >= g_reg_base + REL_MARGIN {
                if g_reg_dmax < REG_TIN { return 1; }
            }
        }
    }
    return 0;
}

fn evaluate_body() -> i32 {      // CLASSICAL eval only (pure f(position))
    var score: i32 = 0;          // from white's view
    var npmat: i32 = 0;          // non-pawn material both sides

    var wpf: [i32; 8] = 0;
    var bpf: [i32; 8] = 0;
    var bmaxb: [i32; 8] = 0;
    var wminw: [i32; 8] = 0;
    var zf: i32 = 0;
    while zf < 8 { wpf[zf] = 0; bpf[zf] = 0; bmaxb[zf] = 0; wminw[zf] = 7; zf = zf + 1; }
    var wbish: i32 = 0;
    var bbish: i32 = 0;

    var sq: i32 = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if p != EMPTY && p != OFF {
            let s: i32 = sq64(sq);
            let f: i32 = s % 8;
            let r: i32 = s / 8;
            if p <= WK {
                var v: i32 = g_pval[p];
                if p != WK {
                    v = v + g_pst[(p - 1) * 64 + s];
                    if p != WP { npmat = npmat + g_pval[p]; }
                }
                score = score + v;
                if p == WP { wpf[f] = wpf[f] + 1; if wminw[f] > r { wminw[f] = r; } }
                else if p == WN { score = score + 4 * count_mobility(sq, p); }
                else if p == WB { wbish = wbish + 1; score = score + 4 * count_mobility(sq, p); }
            } else {
                let ms: i32 = mirror64(s);
                var v2: i32 = g_pval[p];
                if p != BK {
                    v2 = v2 + g_pst[(p - 7) * 64 + ms];
                    if p != BP { npmat = npmat + g_pval[p]; }
                }
                score = score - v2;
                if p == BP { bpf[f] = bpf[f] + 1; if bmaxb[f] < r { bmaxb[f] = r; } }
                else if p == BN { score = score - 4 * count_mobility(sq, p); }
                else if p == BB { bbish = bbish + 1; score = score - 4 * count_mobility(sq, p); }
            }
        }
        sq = sq + 1;
    }
    let endgame: i32 = npmat < 2400;

    let wks: i32 = sq64(g_ksq[WHITE]);
    if endgame == 1 { score = score + g_kend[wks]; }
    else { score = score + g_pst[5 * 64 + wks]; }
    let bks: i32 = mirror64(sq64(g_ksq[BLACK]));
    if endgame == 1 { score = score - g_kend[bks]; }
    else { score = score - g_pst[5 * 64 + bks]; }

    if endgame == 1 {
        let bk64: i32 = sq64(g_ksq[BLACK]);
        var df: i32 = (wks % 8) - (bk64 % 8); if df < 0 { df = 0 - df; }
        var dr: i32 = (wks / 8) - (bk64 / 8); if dr < 0 { dr = 0 - dr; }
        var cheb: i32 = dr; if df > dr { cheb = df; }
        let prox: i32 = (7 - cheb) * 8;
        if score > 200 { score = score + prox; }
        else if score < 0 - 200 { score = score - prox; }
    }

    if endgame == 0 {
        let wk: i32 = g_ksq[WHITE];
        var wsh: i32 = 0;
        if g_board[wk + 9] == WP { wsh = wsh + 1; }
        if g_board[wk + 10] == WP { wsh = wsh + 1; }
        if g_board[wk + 11] == WP { wsh = wsh + 1; }
        score = score + wsh * 8;
        let bk: i32 = g_ksq[BLACK];
        var bsh: i32 = 0;
        if g_board[bk - 9] == BP { bsh = bsh + 1; }
        if g_board[bk - 10] == BP { bsh = bsh + 1; }
        if g_board[bk - 11] == BP { bsh = bsh + 1; }
        score = score - bsh * 8;
    }

    if wbish >= 2 { score = score + 30; }
    if bbish >= 2 { score = score - 30; }

    var f2: i32 = 0;
    while f2 < 8 {
        if wpf[f2] >= 2 { score = score - 12 * (wpf[f2] - 1); }
        if bpf[f2] >= 2 { score = score + 12 * (bpf[f2] - 1); }
        if wpf[f2] > 0 {
            var adj: i32 = 0;
            if f2 > 0 { adj = adj + wpf[f2 - 1]; }
            if f2 < 7 { adj = adj + wpf[f2 + 1]; }
            if adj == 0 { score = score - 15 * wpf[f2]; }
        }
        if bpf[f2] > 0 {
            var adjb: i32 = 0;
            if f2 > 0 { adjb = adjb + bpf[f2 - 1]; }
            if f2 < 7 { adjb = adjb + bpf[f2 + 1]; }
            if adjb == 0 { score = score + 15 * bpf[f2]; }
        }
        f2 = f2 + 1;
    }

    sq = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if p == WR {
            let rf: i32 = sq64(sq) % 8;
            if wpf[rf] == 0 { if bpf[rf] == 0 { score = score + 15; } else { score = score + 7; } }
        } else if p == BR {
            let rf: i32 = sq64(sq) % 8;
            if bpf[rf] == 0 { if wpf[rf] == 0 { score = score - 15; } else { score = score - 7; } }
        } else if p == WP {
            let s2: i32 = sq64(sq);
            let pf: i32 = s2 % 8;
            let pr: i32 = s2 / 8;
            var blk: i32 = bmaxb[pf];
            if pf > 0 { if bmaxb[pf - 1] > blk { blk = bmaxb[pf - 1]; } }
            if pf < 7 { if bmaxb[pf + 1] > blk { blk = bmaxb[pf + 1]; } }
            if blk <= pr { score = score + g_passed[pr]; }
        } else if p == BP {
            let s2: i32 = sq64(sq);
            let pf: i32 = s2 % 8;
            let pr: i32 = s2 / 8;
            var wht: i32 = wminw[pf];
            if pf > 0 { if wminw[pf - 1] < wht { wht = wminw[pf - 1]; } }
            if pf < 7 { if wminw[pf + 1] < wht { wht = wminw[pf + 1]; } }
            if wht >= pr { score = score - g_passed[7 - pr]; }
        }
        sq = sq + 1;
    }

    if g_side == WHITE { return score + 12; }
    return 0 - score + 12;
}

// window-aware eval: cached classical + lazily-cached nn correction.
fn evaluate_w(alpha: i32, beta: i32) -> i32 {
    // eval-replacement (mode 2): the net REPLACES the hand-crafted positional
    // eval; exact material anchors it. screen-only mode: no cache, no lazy.
    if g_eval_mode == 2 {
        return material_stm() + ((nn_eval() >> NN_REP_SHIFT) as i32) + 12;
    }
    let ei: i32 = (((g_key >> 32) ^ g_key) & ((EVC_SIZE as i64) - 1)) as i32;
    var has: i32 = 0;
    var cls: i32 = 0;
    if g_ev_key[ei] == g_key { has = g_ev_has[ei] as i32; }
    if has >= 1 { cls = g_ev_cls[ei]; g_c_ehit = g_c_ehit + 1; }
    else {
        cls = evaluate_body();
        g_ev_key[ei] = g_key; g_ev_cls[ei] = cls; g_ev_has[ei] = 1;
    }
    if NN_BLEND == 0 && g_eval_mode != 1 { return cls; }
    var nnv: i64 = 0;
    if has == 2 { nnv = g_ev_nn[ei] as i64; g_c_enn = g_c_enn + 1; }
    else {
        if g_lz_a >= 0 {
            // precise near the window (tactics live there); fast when the
            // classical verdict is already outside it by the correction envelope
            let m: i32 = g_lz_a + (iabs(cls) >> g_lz_b);
            if cls - m >= beta { g_c_lzhi = g_c_lzhi + 1; return cls; }
            if cls + m <= alpha { g_c_lzlo = g_c_lzlo + 1; return cls; }
        }
        nnv = nn_eval();
        g_ev_nn[ei] = nnv as i32; g_ev_has[ei] = 2;
    }
    return cls + ((nnv >> NN_BLEND_SHIFT) as i32);
}
fn evaluate() -> i32 { return evaluate_w(0 - INF, INF); }

// ---------------- repetition ----------------

fn is_repetition() -> i32 {
    var i: i32 = g_hply - g_fifty;
    if i < 0 { i = 0; }
    while i < g_hply {
        if g_h_key[i] == g_key { return 1; }
        i = i + 1;
    }
    return 0;
}

// ---------------- transposition table ----------------

fn tt_clear() {
    var i: i32 = 0;
    while i < TTSIZE { g_tt_flag[i] = 0; i = i + 1; }
    evc_clear();
}

fn value_to_tt(s: i32, ply: i32) -> i32 {
    if s >= MATE - MAXPLY { return s + ply; }
    if s <= 0 - (MATE - MAXPLY) { return s - ply; }
    return s;
}
fn value_from_tt(s: i32, ply: i32) -> i32 {
    if s >= MATE - MAXPLY { return s - ply; }
    if s <= 0 - (MATE - MAXPLY) { return s + ply; }
    return s;
}

fn tt_store(tti: i32, key: i64, mv: i32, sc: i32, depth: i32, ply: i32, flag: i32) {
    g_tt_key[tti] = key;
    g_tt_move[tti] = mv;
    g_tt_score[tti] = value_to_tt(sc, ply);
    g_tt_depth[tti] = depth;
    g_tt_flag[tti] = flag;
}

// ---------------- search ----------------

fn checkup() {
    if g_budget > 0 && now_ms() - g_starttime >= g_budget {
        g_stop = 1;
    }
}

fn pick_move(from: i32, to: i32) {
    var best: i32 = from;
    var i: i32 = from + 1;
    while i < to {
        if g_msc[i] > g_msc[best] { best = i; }
        i = i + 1;
    }
    let tm: i32 = g_mv[from]; g_mv[from] = g_mv[best]; g_mv[best] = tm;
    let ts: i32 = g_msc[from]; g_msc[from] = g_msc[best]; g_msc[best] = ts;
}

fn qsearch(alpha_in: i32, beta: i32, ply: i32) -> i32 {
    var alpha: i32 = alpha_in;
    g_nodes = g_nodes + 1;
    if (g_nodes & 4095) == 0 { checkup(); }
    if g_stop == 1 { return 0; }

    // in check: no stand-pat (illegal), full evasion set, mate when none exists
    let incheck: i32 = in_check(g_side);
    var stand: i32 = 0 - MATE;
    if incheck == 0 {
        stand = evaluate_w(alpha, beta);
        if ply >= MAXPLY - 1 { return stand; }
        if stand >= beta { return beta; }
        if stand > alpha { alpha = stand; }
    } else {
        if ply >= MAXPLY - 1 { return evaluate(); }
    }

    g_ttmove = 0;
    var legal: i32 = 0;
    gen_moves(ply, 1 - incheck);
    let lo: i32 = g_first[ply];
    let hi: i32 = g_first[ply + 1];
    var i: i32 = lo;
    while i < hi {
        pick_move(i, hi);
        let m: i32 = g_mv[i];
        if make_move(m) == 1 {
            legal = legal + 1;
            let sc: i32 = 0 - qsearch(0 - beta, 0 - alpha, ply + 1);
            unmake_move();
            if g_stop == 1 { return 0; }
            if sc >= beta { return beta; }
            if sc > alpha { alpha = sc; }
        }
        i = i + 1;
    }
    if incheck == 1 { if legal == 0 { return 0 - MATE + ply; } }
    return alpha;
}

// ================= tb build/probe =================
let TB_N: i32 = 524288;              // wk(64) x wp(64) x bk(64) x stm(2)
var g_tbq: *i32 = null;
var g_tbr: *i32 = null;              // KRK
var g_tb: *i32 = null;
var g_tb_piece: i32 = 5;             // build-time strong piece: WQ(5) or WR(4)
var g_tbprobe: i32 = 0;              // 0 off · 1 probe+verify · 2 probe+trust
var g_probe_sc: i32 = 0;             // tb_probe out: stm-relative, ply-adjusted score
var g_use_null: i32 = 1;

fn sq120(s: i32) -> i32 { return 21 + (s / 8) * 10 + (s % 8); }
fn iabs(x: i32) -> i32 { if x < 0 { return 0 - x; } return x; }
fn tb_idx(wk: i32, wp: i32, bk: i32, stm: i32) -> i32 { return ((wk * 64 + wp) * 64 + bk) * 2 + stm; }

fn tb_place(wk: i32, wp: i32, bk: i32, stm: i32) {
    g_board[sq120(wk)] = WK; g_board[sq120(wp)] = g_tb_piece; g_board[sq120(bk)] = BK;
    g_ksq[WHITE] = sq120(wk); g_ksq[BLACK] = sq120(bk);
    g_side = stm; g_ep = 0; g_castle = 0; g_fifty = 0; g_hply = 0; g_key = 0;
}
fn tb_unplace(wk: i32, wp: i32, bk: i32) {
    g_board[sq120(wk)] = EMPTY; g_board[sq120(wp)] = EMPTY; g_board[sq120(bk)] = EMPTY;
}
fn tb_legal(wk: i32, wp: i32, bk: i32, stm: i32) -> i32 {
    if wk == wp { return 0; }
    if wk == bk { return 0; }
    if wp == bk { return 0; }
    if iabs(wk % 8 - bk % 8) <= 1 { if iabs(wk / 8 - bk / 8) <= 1 { return 0; } }
    tb_place(wk, wp, bk, stm);
    var bad: i32 = 0;
    if stm == WHITE { if sq_attacked(sq120(bk), WHITE) == 1 { bad = 1; } }
    else { if sq_attacked(sq120(wk), BLACK) == 1 { bad = 1; } }
    tb_unplace(wk, wp, bk);
    if bad == 1 { return 0; }
    return 1;
}
fn tb_child(m: i32, wk: i32, wp: i32, bk: i32, stm: i32) -> i32 {
    let f: i32 = sq64(m_from(m));
    let t: i32 = sq64(m_to(m));
    if stm == WHITE {
        if f == wk { return tb_idx(t, wp, bk, BLACK); }
        return tb_idx(wk, t, bk, BLACK);
    }
    if t == wp { return 0 - 1; }
    return tb_idx(wk, wp, t, WHITE);
}
fn tb_build() {
    var wk: i32 = 0;
    while wk < 64 { var wp: i32 = 0; while wp < 64 { var bk: i32 = 0; while bk < 64 {
        var stm: i32 = 0;
        while stm < 2 {
            let idx: i32 = tb_idx(wk, wp, bk, stm);
            if tb_legal(wk, wp, bk, stm) == 0 { g_tb[idx] = 0 - 2; }
            else {
                g_tb[idx] = 0 - 1;
                if stm == BLACK {
                    tb_place(wk, wp, bk, stm);
                    gen_moves(0, 0);
                    var i: i32 = g_first[0]; let hi: i32 = g_first[1]; var nl: i32 = 0;
                    while i < hi { if make_move(g_mv[i]) == 1 { nl = nl + 1; unmake_move(); } i = i + 1; }
                    if nl == 0 { if in_check(BLACK) == 1 { g_tb[idx] = 0; } }
                    tb_unplace(wk, wp, bk);
                }
            }
            stm = stm + 1;
        }
        bk = bk + 1; } wp = wp + 1; } wk = wk + 1;
    }
    var k: i32 = 0; var changed: i32 = 1;
    while changed == 1 {
        changed = 0;
        var a1: i32 = 0;
        while a1 < 64 { var a2: i32 = 0; while a2 < 64 { var a3: i32 = 0; while a3 < 64 {
            let idx: i32 = tb_idx(a1, a2, a3, WHITE);
            if g_tb[idx] == 0 - 1 {
                tb_place(a1, a2, a3, WHITE);
                gen_moves(0, 0);
                var i: i32 = g_first[0]; let hi: i32 = g_first[1]; var hit: i32 = 0;
                while i < hi {
                    let m: i32 = g_mv[i];
                    if make_move(m) == 1 {
                        unmake_move();
                        let c: i32 = tb_child(m, a1, a2, a3, WHITE);
                        if c >= 0 { if g_tb[c] == k { hit = 1; } }
                    }
                    i = i + 1;
                }
                tb_unplace(a1, a2, a3);
                if hit == 1 { g_tb[idx] = k + 1; changed = 1; }
            }
            a3 = a3 + 1; } a2 = a2 + 1; } a1 = a1 + 1;
        }
        var b1: i32 = 0;
        while b1 < 64 { var b2: i32 = 0; while b2 < 64 { var b3: i32 = 0; while b3 < 64 {
            let idx: i32 = tb_idx(b1, b2, b3, BLACK);
            if g_tb[idx] == 0 - 1 {
                tb_place(b1, b2, b3, BLACK);
                gen_moves(0, 0);
                var i: i32 = g_first[0]; let hi: i32 = g_first[1];
                var nl: i32 = 0; var all_won: i32 = 1; var mx: i32 = 0 - 1;
                while i < hi {
                    let m: i32 = g_mv[i];
                    if make_move(m) == 1 {
                        nl = nl + 1; unmake_move();
                        let c: i32 = tb_child(m, b1, b2, b3, BLACK);
                        var v: i32 = 0 - 1;
                        if c >= 0 { v = g_tb[c]; }
                        if v < 0 { all_won = 0; } else { if v > mx { mx = v; } }
                    }
                    i = i + 1;
                }
                tb_unplace(b1, b2, b3);
                if all_won == 1 { if nl > 0 { g_tb[idx] = mx + 1; changed = 1; } }
            }
            b3 = b3 + 1; } b2 = b2 + 1; } b1 = b1 + 1;
        }
        k = k + 2;
    }
}
fn tb_longest_of(tbl: *i32) -> i32 {
    var maxd: i32 = 0; var mi: i32 = 0;
    while mi < TB_N {
        let v: i32 = tbl[mi];
        if v > maxd { if mi % 2 == WHITE { maxd = v; } }
        mi = mi + 1;
    }
    return (maxd + 1) / 2;
}
fn tb_mirror_gate() {
    var checked: i32 = 0; var bad: i32 = 0;
    var wk: i32 = 0;
    while wk < 64 { var wp: i32 = 0; while wp < 64 { var bk: i32 = 0; while bk < 64 {
        var stm: i32 = 0;
        while stm < 2 {
            let v: i32 = g_tbq[tb_idx(wk, wp, bk, stm)];
            if v >= 0 - 1 {
                var c0: i32 = 0; while c0 < 120 { g_board[c0] = OFF; c0 = c0 + 1; }
                var r0: i32 = 0; while r0 < 8 { var f0: i32 = 0; while f0 < 8 { g_board[21 + r0 * 10 + f0] = EMPTY; f0 = f0 + 1; } r0 = r0 + 1; }
                g_tb_piece = WQ; tb_place(wk, wp, bk, stm);
                let s_direct: i32 = tb_probe_score();
                tb_unplace(wk, wp, bk);
                var i: i32 = 0; while i < 120 { g_board[i] = OFF; i = i + 1; }
                var r: i32 = 0; while r < 8 { var f: i32 = 0; while f < 8 { g_board[21 + r * 10 + f] = EMPTY; f = f + 1; } r = r + 1; }
                g_board[sq120(wk ^ 56)] = BK; g_ksq[BLACK] = sq120(wk ^ 56);
                g_board[sq120(bk ^ 56)] = WK; g_ksq[WHITE] = sq120(bk ^ 56);
                g_board[sq120(wp ^ 56)] = BQ;
                g_side = 1 - stm; g_ep = 0; g_castle = 0; g_fifty = 0;
                let s_mirror: i32 = tb_probe_score();
                checked = checked + 1;
                if s_direct != s_mirror { bad = bad + 1; }
            }
            stm = stm + 1;
        }
        bk = bk + 1; } wp = wp + 1; } wk = wk + 1;
    }
    var i2: i32 = 0; while i2 < 120 { g_board[i2] = OFF; i2 = i2 + 1; }
    wr(1, "tbmirror checked "); wr_int(1, checked as i64);
    wr(1, "  mismatches "); wr_int(1, bad as i64);
    if bad == 0 { wr(1, "  [EXACT: black-strong mirror == white-strong DTM]\n"); }
    else { wr(1, "  [FAIL]\n"); }
    set_startpos();
}
fn tb_probe_score() -> i32 {
    if tb_probe(0) == 1 { return g_probe_sc; }
    return 0 - 99999;
}
fn tb_build_all() {
    var i: i32 = 0;
    while i < 120 { g_board[i] = OFF; i = i + 1; }
    var r: i32 = 0;
    while r < 8 { var f: i32 = 0; while f < 8 { g_board[21 + r * 10 + f] = EMPTY; f = f + 1; } r = r + 1; }
    if g_tbq == null { g_tbq = alloc(TB_N); }
    if g_tbr == null { g_tbr = alloc(TB_N); }
    g_tb = g_tbq; g_tb_piece = WQ; tb_build();
    g_tb = g_tbr; g_tb_piece = WR; tb_build();
}
fn tb_probe(ply: i32) -> i32 {
    var psq: i32 = 0 - 1; var pkind: i32 = 0; var pside: i32 = 0; var cnt: i32 = 0;
    var sq: i32 = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if p != EMPTY { if p != OFF { if p != WK { if p != BK {
            cnt = cnt + 1; psq = sq; pside = piece_side(p); pkind = p - pside * 6;
        } } } }
        sq = sq + 1;
    }
    if cnt != 1 { return 0; }
    if pkind != WR { if pkind != WQ { return 0; } }
    var tbl: *i32 = g_tbr;
    if pkind == WQ { tbl = g_tbq; }
    if tbl == null { return 0; }
    var wk: i32 = 0; var wp: i32 = 0; var bk: i32 = 0; var st: i32 = 0;
    if pside == WHITE {
        wk = sq64(g_ksq[WHITE]); wp = sq64(psq); bk = sq64(g_ksq[BLACK]); st = g_side;
    } else {
        wk = sq64(g_ksq[BLACK]) ^ 56; wp = sq64(psq) ^ 56; bk = sq64(g_ksq[WHITE]) ^ 56;
        if g_side == pside { st = WHITE; } else { st = BLACK; }
    }
    let v: i32 = tbl[tb_idx(wk, wp, bk, st)];
    if v == 0 - 2 { return 0; }
    if v == 0 - 1 { g_probe_sc = 0; return 1; }
    let sc: i32 = MATE - (v + ply);
    if g_side == pside { g_probe_sc = sc; } else { g_probe_sc = 0 - sc; }
    return 1;
}

fn search(alpha_in: i32, beta: i32, depth_in: i32, ply: i32, can_null: i32) -> i32 {
    var alpha: i32 = alpha_in;
    var depth: i32 = depth_in;
    let alpha_orig: i32 = alpha_in;   // for classifying the TT bound on store

    if ply > 0 && (is_repetition() == 1 || g_fifty >= 100) { return 0; }
    if g_tbprobe >= 1 { if ply > 0 { if tb_probe(ply) == 1 { return g_probe_sc; } } }

    let incheck: i32 = in_check(g_side);
    if incheck == 1 { depth = depth + 1; }

    if depth <= 0 { return qsearch(alpha, beta, ply); }

    g_nodes = g_nodes + 1;
    if (g_nodes & 4095) == 0 { checkup(); }
    if g_stop == 1 { return 0; }
    if ply >= MAXPLY - 1 { return evaluate(); }

    let tti: i32 = (g_key & TTMASK) as i32;
    var ttm: i32 = 0;
    if g_tt_flag[tti] != 0 && g_tt_key[tti] == g_key {
        ttm = g_tt_move[tti];
        if ply > 0 && g_tt_depth[tti] >= depth {
            let tsc: i32 = value_from_tt(g_tt_score[tti], ply);
            let tfl: i32 = g_tt_flag[tti];
            if tfl == TT_EXACT { return tsc; }
            if tfl == TT_LOWER && tsc >= beta { return tsc; }
            if tfl == TT_UPPER && tsc <= alpha { return tsc; }
        }
    }

    if can_null == 1 && g_use_null == 1 && incheck == 0 && ply > 0 && depth >= 3 {
        var big: i32 = 0;
        var sq: i32 = 21;
        let lo2: i32 = 2 + g_side * 6;
        let hi2: i32 = 5 + g_side * 6;
        while sq <= 98 {
            let pp: i32 = g_board[sq];
            if pp >= lo2 && pp <= hi2 { big = 1; break; }
            sq = sq + 1;
        }
        if big == 1 {
            // the null child gens at ply+1 BEFORE this node gens its own list:
            // g_first[ply+1] is stale (can point INSIDE an ancestor's live
            // segment -> the child's gen tramples it). Aim it at this node's
            // own unstarted region — always safe, rewritten by our gen after.
            g_first[ply + 1] = g_first[ply];
            make_null();
            let ns: i32 = 0 - search(0 - beta, 0 - beta + 1, depth - 3, ply + 1, 0);
            unmake_null();
            if g_stop == 1 { return 0; }
            if ns >= beta { return beta; }
        }
    }

    g_ttmove = ttm;
    gen_moves(ply, 0);
    let lo: i32 = g_first[ply];
    let hi: i32 = g_first[ply + 1];
    var legal: i32 = 0;
    var bestsc: i32 = 0 - INF;
    var bestmove: i32 = 0;

    var i: i32 = lo;
    while i < hi {
        pick_move(i, hi);
        let m: i32 = g_mv[i];
        if make_move(m) == 1 {
            legal = legal + 1;
            var sc: i32 = 0;
            if legal == 1 {
                sc = 0 - search(0 - beta, 0 - alpha, depth - 1, ply + 1, 1);
            } else {
                var R: i32 = 0;
                if depth >= 3 && legal >= 4 && ply > 0
                   && m_cap(m) == EMPTY && m_promo(m) == EMPTY
                   && incheck == 0
                   && m != g_killer1[ply] && m != g_killer2[ply]
                   && in_check(g_side) == 0 {
                    R = 1;
                    if legal >= 8 { R = 2; }
                    if depth >= 7 { R = R + 1; }
                    if R > depth - 2 { R = depth - 2; }
                }
                sc = 0 - search(0 - alpha - 1, 0 - alpha, depth - 1 - R, ply + 1, 1);
                if g_stop == 0 && R > 0 && sc > alpha {
                    sc = 0 - search(0 - alpha - 1, 0 - alpha, depth - 1, ply + 1, 1);
                }
                if g_stop == 0 && sc > alpha && sc < beta {
                    sc = 0 - search(0 - beta, 0 - alpha, depth - 1, ply + 1, 1);
                }
            }
            unmake_move();
            if g_stop == 1 { return 0; }
            if ply == 0 && g_temp > 0 && g_root_n < 256 {
                g_root_mv[g_root_n] = m;
                g_root_sc[g_root_n] = sc;
                g_root_n = g_root_n + 1;
            }
            if sc > bestsc {
                bestsc = sc;
                bestmove = m;
                if ply == 0 { g_bestroot = m; }
            }
            if sc > alpha {
                if sc >= beta {
                    if m_cap(m) == EMPTY && m_promo(m) == EMPTY {
                        if m != g_killer1[ply] {
                            g_killer2[ply] = g_killer1[ply];
                            g_killer1[ply] = m;
                        }
                        let hidx: i32 = m_from(m) * 120 + m_to(m);
                        g_hist[hidx] = g_hist[hidx] + depth * depth;
                        if g_hist[hidx] > 700000 { g_hist[hidx] = 700000; }
                    }
                    tt_store(tti, g_key, m, sc, depth, ply, TT_LOWER);
                    return beta;
                }
                alpha = sc;
            }
        }
        i = i + 1;
    }

    if legal == 0 {
        var term: i32 = 0;
        if incheck == 1 { term = 0 - MATE + ply; }
        tt_store(tti, g_key, 0, term, depth, ply, TT_EXACT);
        return term;
    }
    var flag: i32 = TT_UPPER;
    if alpha > alpha_orig { flag = TT_EXACT; }
    tt_store(tti, g_key, bestmove, bestsc, depth, ply, flag);
    return alpha;
}

// ---------------- move <-> string ----------------

fn wr_move(fd: i32, m: i32) {
    let from: i32 = m_from(m);
    let to: i32 = m_to(m);
    wr_ch(fd, from % 10 - 1 + 97);
    wr_ch(fd, from / 10 - 2 + 49);
    wr_ch(fd, to % 10 - 1 + 97);
    wr_ch(fd, to / 10 - 2 + 49);
    let pr: i32 = m_promo(m);
    if pr != EMPTY {
        let k: i32 = pr - piece_side(pr) * 6;
        if k == WQ { wr_ch(fd, 113); }
        else if k == WR { wr_ch(fd, 114); }
        else if k == WB { wr_ch(fd, 98); }
        else { wr_ch(fd, 110); }
    }
}

fn apply_uci_move(s: *u8, len: i32) -> i32 {
    if len < 4 { return 0; }
    let from: i32 = 21 + (s[0] as i32 - 97) + (s[1] as i32 - 49) * 10;
    let to: i32 = 21 + (s[2] as i32 - 97) + (s[3] as i32 - 49) * 10;
    var promo_kind: i32 = 0;
    if len >= 5 {
        let c: i32 = s[4] as i32;
        if c == 113 { promo_kind = WQ; }
        if c == 114 { promo_kind = WR; }
        if c == 98 { promo_kind = WB; }
        if c == 110 { promo_kind = WN; }
    }
    gen_moves(0, 0);
    var i: i32 = g_first[0];
    let hi: i32 = g_first[1];
    while i < hi {
        let m: i32 = g_mv[i];
        if m_from(m) == from && m_to(m) == to {
            var pk: i32 = m_promo(m);
            if pk != EMPTY { pk = pk - piece_side(pk) * 6; }
            if pk == promo_kind {
                if make_move(m) == 1 { return 1; }
                return 0;
            }
        }
        i = i + 1;
    }
    return 0;
}

// ---------------- FEN ----------------

fn parse_fen(s: *u8, len: i32) -> i32 {
    nn_inval_all();
    var i: i32 = 0;
    while i < 120 { g_board[i] = OFF; i = i + 1; }
    var r: i32 = 0;
    while r < 8 {
        var f: i32 = 0;
        while f < 8 { g_board[21 + r * 10 + f] = EMPTY; f = f + 1; }
        r = r + 1;
    }

    var pos: i32 = 0;
    var row: i32 = 7;
    var file: i32 = 0;
    while pos < len {
        let c: i32 = s[pos] as i32;
        if c == 32 { pos = pos + 1; break; }
        if c == 47 { row = row - 1; file = 0; }
        else if c >= 49 && c <= 56 { file = file + (c - 48); }
        else {
            var p: i32 = 0;
            if c == 80 { p = WP; }  if c == 78 { p = WN; }
            if c == 66 { p = WB; }  if c == 82 { p = WR; }
            if c == 81 { p = WQ; }  if c == 75 { p = WK; }
            if c == 112 { p = BP; } if c == 110 { p = BN; }
            if c == 98 { p = BB; }  if c == 114 { p = BR; }
            if c == 113 { p = BQ; } if c == 107 { p = BK; }
            if p != 0 {
                let sq: i32 = 21 + row * 10 + file;
                g_board[sq] = p;
                if p == WK { g_ksq[WHITE] = sq; }
                if p == BK { g_ksq[BLACK] = sq; }
                file = file + 1;
            }
        }
        pos = pos + 1;
    }

    g_side = WHITE;
    if pos < len && s[pos] as i32 == 98 { g_side = BLACK; }
    while pos < len && s[pos] as i32 != 32 { pos = pos + 1; }
    pos = pos + 1;

    g_castle = 0;
    while pos < len && s[pos] as i32 != 32 {
        let c2: i32 = s[pos] as i32;
        if c2 == 75 { g_castle = g_castle | CWK; }
        if c2 == 81 { g_castle = g_castle | CWQ; }
        if c2 == 107 { g_castle = g_castle | CBK; }
        if c2 == 113 { g_castle = g_castle | CBQ; }
        pos = pos + 1;
    }
    pos = pos + 1;

    g_ep = 0;
    if pos < len && s[pos] as i32 != 45 && s[pos] as i32 != 0 {
        if pos + 1 < len {
            g_ep = 21 + (s[pos] as i32 - 97) + (s[pos + 1] as i32 - 49) * 10;
        }
    }

    g_fifty = 0;                                   // fifth field: the halfmove clock
    while pos < len && s[pos] as i32 != 32 { pos = pos + 1; }
    pos = pos + 1;
    while pos < len {
        let c5: i32 = s[pos] as i32;
        if c5 < 48 || c5 > 57 { break; }
        g_fifty = g_fifty * 10 + (c5 - 48);
        pos = pos + 1;
    }
    if g_fifty > 100 { g_fifty = 100; }
    g_hply = 0;
    g_key = recompute_key();
    return 1;
}

// ---------------- perft ----------------

fn perft(depth: i32, ply: i32) -> i64 {
    if depth == 0 { return 1; }
    var nodes: i64 = 0;
    gen_moves(ply, 0);
    var i: i32 = g_first[ply];
    let hi: i32 = g_first[ply + 1];
    while i < hi {
        if make_move(g_mv[i]) == 1 {
            nodes = nodes + perft(depth - 1, ply + 1);
            unmake_move();
        }
        i = i + 1;
    }
    return nodes;
}

// ---------------- think ----------------

// Sample a root move weighted by w = max(0, g_temp - (bestsc - sc)); best always
// qualifies (gap 0), moves > g_temp cp below best are excluded. Fallback g_bestroot.
fn sample_root() -> i32 {
    if g_root_cn <= 0 { return g_bestroot; }
    var bestsc: i32 = 0 - INF;
    var i: i32 = 0;
    while i < g_root_cn {
        if g_root_csc[i] > bestsc { bestsc = g_root_csc[i]; }
        i = i + 1;
    }
    var total: i64 = 0;
    i = 0;
    while i < g_root_cn {
        var w: i32 = g_temp - (bestsc - g_root_csc[i]);
        if w > 0 { total = total + w as i64; }
        i = i + 1;
    }
    if total <= 0 { return g_bestroot; }
    var r: i64 = (rand64() & 4611686018427387903) % total;
    i = 0;
    while i < g_root_cn {
        var w: i32 = g_temp - (bestsc - g_root_csc[i]);
        if w > 0 {
            r = r - w as i64;
            if r < 0 { return g_root_cmv[i]; }
        }
        i = i + 1;
    }
    return g_bestroot;
}

fn think() {
    g_nodes = 0;
    g_stop = 0;
    g_bestroot = 0;
    g_starttime = now_ms();
    clear_search_tables();

    if NN_BLEND == 1 || g_eval_mode >= 1 { g_nnue_on = 1; nn_recompute_all(); }

    if g_budget > 0 && g_tc_clock == 1 {
        if g_tc_curve == 1 {
            g_budget = g_budget + (g_budget * (tc_gain(g_reg_dmax) as i64)) / 1000;
        } else if decide_extend() == 1 {
            g_budget = g_budget + (g_budget * 3) / 5;
        }
    }
    wr(1, "info string regime ");
    wr_int(1, g_reg_state as i64);
    wr(1, " phase ");
    wr_int(1, g_reg_phase as i64);
    wr(1, " dmax ");
    wr_int(1, g_reg_dmax as i64);
    wr(1, " base ");
    wr_int(1, g_reg_base as i64);
    wr(1, " budget ");
    wr_int(1, g_budget);
    wr(1, "\n");

    var best: i32 = 0;
    var d: i32 = 1;
    while d <= g_maxdepth {
        if g_temp > 0 { g_root_n = 0; }
        let sc: i32 = search(0 - INF, INF, d, 0, 1);
        if g_stop == 1 { break; }
        best = g_bestroot;
        if g_temp > 0 {
            g_root_cn = g_root_n;
            var ci: i32 = 0;
            while ci < g_root_n {
                g_root_cmv[ci] = g_root_mv[ci];
                g_root_csc[ci] = g_root_sc[ci];
                ci = ci + 1;
            }
        }
        wr(1, "info depth ");
        wr_int(1, d as i64);
        wr(1, " score cp ");
        wr_int(1, sc as i64);
        wr(1, " nodes ");
        wr_int(1, g_nodes);
        wr(1, " time ");
        wr_int(1, now_ms() - g_starttime);
        wr(1, " pv ");
        wr_move(1, best);
        wr(1, "\n");
        if sc > MATE - 200 || sc < 0 - MATE + 200 { break; }
        if g_budget > 0 && now_ms() - g_starttime > g_budget / 2 { break; }
        d = d + 1;
    }
    if best == 0 {
        best = g_bestroot;
    }
    if best == 0 {
        gen_moves(0, 0);
        var i: i32 = g_first[0];
        while i < g_first[1] {
            if make_move(g_mv[i]) == 1 { unmake_move(); best = g_mv[i]; break; }
            i = i + 1;
        }
    }
    var played: i32 = best;
    if g_temp > 0 && g_root_cn > 0 {
        let s: i32 = sample_root();
        if s != 0 { played = s; }
    }
    wr(1, "bestmove ");
    if played == 0 { wr(1, "0000"); }
    else { wr_move(1, played); }
    wr(1, "\n");
}

// ============================================================
// ============================================================

let PH_MAXS: i32 = 65536;          // sample cap (loud)
let PH_NWI: i32 = 16;              // image words per sample
let PH_NWP: i32 = 5;               // position words per sample
let PH_TAB: i32 = 262144;          // open-address slots (2^18)
let PH_TMASK: i64 = 262143;

var g_ph_img: *i64 = null;         // PH_MAXS * PH_NWI
var g_ph_pos: *i64 = null;         // PH_MAXS * PH_NWP
var g_ph_z: *i64 = null;           // PH_MAXS: target (stm-relative, trainer units)
var g_ph_band: *i32 = null;        // PH_MAXS: nn_route at the position
var g_ph_src: *i32 = null;         // g*512+ply, or 2^30+anchor_idx
var g_ph_fid: *i32 = null;         // PH_MAXS: fiber id per sample
var g_ph_pid: *i32 = null;         // PH_MAXS: position id per sample
var g_ph_n: i32 = 0;
var g_ph_over: i32 = 0;            // sample-cap hit (results void, loud)
var g_ph_map: i32 = 0;

var g_ph_ftab: *i32 = null;        // PH_TAB: fiber table, sample idx+1, 0 empty
var g_ph_ptab: *i32 = null;        // PH_TAB: position table, sample idx+1
var g_ph_qkey: *i64 = null;        // PH_TAB: (fid+1)<<32|(pid+1) pair-existence keys
var g_ph_fcnt: *i64 = null;        // per-fiber stats
var g_ph_fS: *i64 = null;
var g_ph_fQ: *i64 = null;
var g_ph_fzmin: *i64 = null;
var g_ph_fzmax: *i64 = null;
var g_ph_fimin: *i32 = null;       // sample idx of extreme members (witnesses)
var g_ph_fimax: *i32 = null;
var g_ph_fpos: *i32 = null;        // distinct positions in fiber
var g_ph_fband: *i32 = null;
var g_ph_nf: i32 = 0;
var g_ph_pcnt: *i64 = null;        // per-position stats
var g_ph_pS: *i64 = null;
var g_ph_pQ: *i64 = null;
var g_ph_pband: *i32 = null;
var g_ph_np: i32 = 0;

var g_ph_dpath: *u8 = null;        // dump path (128); g_ph_dlen 0 = off
var g_ph_dlen: i32 = 0;
var g_ph_dfd: i32 = 0;
var g_ph_ob: *u8 = null;           // buffered dump writer (65536)
var g_ph_oblen: i32 = 0;
var g_ph_fen: *u8 = null;          // FEN scratch (128)

fn phi_alloc() {
    if g_ph_img == null {
        g_ph_img = alloc(PH_MAXS * PH_NWI);
        g_ph_pos = alloc(PH_MAXS * PH_NWP);
        g_ph_z = alloc(PH_MAXS);
        g_ph_band = alloc(PH_MAXS);
        g_ph_src = alloc(PH_MAXS);
        g_ph_fid = alloc(PH_MAXS);
        g_ph_pid = alloc(PH_MAXS);
        g_ph_ftab = alloc(PH_TAB);
        g_ph_ptab = alloc(PH_TAB);
        g_ph_qkey = alloc(PH_TAB);
        g_ph_fcnt = alloc(PH_MAXS);
        g_ph_fS = alloc(PH_MAXS);
        g_ph_fQ = alloc(PH_MAXS);
        g_ph_fzmin = alloc(PH_MAXS);
        g_ph_fzmax = alloc(PH_MAXS);
        g_ph_fimin = alloc(PH_MAXS);
        g_ph_fimax = alloc(PH_MAXS);
        g_ph_fpos = alloc(PH_MAXS);
        g_ph_fband = alloc(PH_MAXS);
        g_ph_pcnt = alloc(PH_MAXS);
        g_ph_pS = alloc(PH_MAXS);
        g_ph_pQ = alloc(PH_MAXS);
        g_ph_pband = alloc(PH_MAXS);
        g_ph_dpath = alloc(128);
        g_ph_ob = alloc(65536);
        g_ph_fen = alloc(128);
    }
}

fn phb_ch(c: i32) {
    g_ph_ob[g_ph_oblen] = c as u8;
    g_ph_oblen = g_ph_oblen + 1;
    if g_ph_oblen >= 65472 { write(g_ph_dfd, g_ph_ob, g_ph_oblen as usize); g_ph_oblen = 0; }
}
fn phb_str(s: *u8) { var i: i32 = 0; while s[i] != 0 { phb_ch(s[i] as i32); i = i + 1; } }
fn phb_int(n: i64) {
    if n < 0 {
        phb_ch(45);
        let hi: i64 = n / 10;
        let lo: i64 = n % 10;
        if hi != 0 { phb_int(0 - hi); }
        phb_ch(((0 - lo) + 48) as i32);
        return;
    }
    if n >= 10 { phb_int(n / 10); }
    phb_ch(((n % 10) + 48) as i32);
}
fn phb_flush() { if g_ph_oblen > 0 { write(g_ph_dfd, g_ph_ob, g_ph_oblen as usize); g_ph_oblen = 0; } }

fn ph_mix(h: i64, v: i64) -> i64 {
    var x: i64 = h ^ (v * 2654435761);
    x = x * 0x9E3779B97F4A7C15;
    x = x ^ (x >> 29);
    return x;
}
fn ph_img_hash(i: i32) -> i64 {
    var h: i64 = g_ph_band[i] as i64;
    var w: i32 = 0;
    while w < PH_NWI { h = ph_mix(h, g_ph_img[i * PH_NWI + w]); w = w + 1; }
    if h < 0 { h = 0 - h; }
    return h;
}
fn ph_pos_hash(i: i32) -> i64 {
    var h: i64 = 12345;
    var w: i32 = 0;
    while w < PH_NWP { h = ph_mix(h, g_ph_pos[i * PH_NWP + w]); w = w + 1; }
    if h < 0 { h = 0 - h; }
    return h;
}
fn ph_img_eq(a: i32, b: i32) -> i32 {
    if g_ph_band[a] != g_ph_band[b] { return 0; }
    var w: i32 = 0;
    while w < PH_NWI {
        if g_ph_img[a * PH_NWI + w] != g_ph_img[b * PH_NWI + w] { return 0; }
        w = w + 1;
    }
    return 1;
}
fn ph_pos_eq(a: i32, b: i32) -> i32 {
    var w: i32 = 0;
    while w < PH_NWP {
        if g_ph_pos[a * PH_NWP + w] != g_ph_pos[b * PH_NWP + w] { return 0; }
        w = w + 1;
    }
    return 1;
}

fn ph_pack_pos(idx: i32) {
    let base: i32 = idx * PH_NWP;
    var w: i32 = 0;
    while w < PH_NWP { g_ph_pos[base + w] = 0; w = w + 1; }
    var r: i32 = 0;
    while r < 64 {
        let sq: i32 = 21 + (r / 8) * 10 + (r % 8);
        let p: i32 = g_board[sq];
        g_ph_pos[base + r / 16] = g_ph_pos[base + r / 16] | ((p as i64) << ((r % 16) * 4));
        r = r + 1;
    }
    g_ph_pos[base + 4] = (g_side as i64) | ((g_castle as i64) << 1) | ((g_ep as i64) << 5);
}

fn ph_img_mat(idx: i32) {
    let base: i32 = idx * PH_NWI;
    var w: i32 = 0;
    while w < PH_NWI { g_ph_img[base + w] = 0; w = w + 1; }
    var d: [i32; 5] = 0;                      // dP dN dB dR dQ (white - black)
    var sq: i32 = 21;
    while sq <= 98 {
        let p: i32 = g_board[sq];
        if p != EMPTY && p != OFF && p != WK && p != BK {
            let t: i32 = nn_pt(p);            // 0..4 white, 5..9 black
            if t < 5 { d[t] = d[t] + 1; } else { d[t - 5] = d[t - 5] - 1; }
        }
        sq = sq + 1;
    }
    var img: i64 = 1;                          // map id 1
    img = img | ((g_side as i64) << 3);
    var k: i32 = 0;
    while k < 5 {
        img = img | (((d[k] + 16) as i64) << (4 + k * 5));
        k = k + 1;
    }
    g_ph_img[base] = img;
}
fn ph_img_sense(idx: i32) {
    let base: i32 = idx * PH_NWI;
    var w: i32 = 0;
    while w < PH_NWI { g_ph_img[base + w] = 0; w = w + 1; }
    king_danger(WHITE);
    var rw: i64 = g_kd_raw as i64;
    king_danger(BLACK);
    var rb: i64 = g_kd_raw as i64;
    var hw: i64 = king_holes(WHITE) as i64;
    var hb: i64 = king_holes(BLACK) as i64;
    var gw: i64 = king_reach(WHITE) as i64;
    var gb: i64 = king_reach(BLACK) as i64;
    var xw: i64 = king_weakness(WHITE) as i64;
    var xb: i64 = king_weakness(BLACK) as i64;
    if rw > 4095 { rw = 4095; }
    if rb > 4095 { rb = 4095; }
    if hw > 31 { hw = 31; }
    if hb > 31 { hb = 31; }
    if gw > 31 { gw = 31; }
    if gb > 31 { gb = 31; }
    if xw > 31 { xw = 31; }
    if xb > 31 { xb = 31; }
    var img: i64 = 2;                          // map id 2 (bits 0..3)
    img = img | (rw << 4) | (rb << 16);
    img = img | (hw << 28) | (hb << 33) | (gw << 38) | (gb << 43) | (xw << 48) | (xb << 53);
    g_ph_img[base] = img;
}
fn ph_img_pst(idx: i32) {
    let base: i32 = idx * PH_NWI;
    let pb: i32 = idx * PH_NWP;
    var w: i32 = 0;
    while w < PH_NWI { g_ph_img[base + w] = 0; w = w + 1; }
    g_ph_img[base] = 3 | ((g_side as i64) << 3);
    w = 0;
    while w < 4 { g_ph_img[base + 1 + w] = g_ph_pos[pb + w]; w = w + 1; }
}
fn ph_img_nn(idx: i32, old: i32) {
    let base: i32 = idx * PH_NWI;
    var w: i32 = 0;
    while w < PH_NWI { g_ph_img[base + w] = 0; w = w + 1; }
    var slot: i32 = 0;
    var c0: i32 = 0;
    var pi: i32 = 0;
    while pi < 2 {
        var persp: i32 = g_side;
        if pi == 1 { persp = 1 - g_side; }
        var sq: i32 = 21;
        while sq <= 98 {
            let p: i32 = g_board[sq];
            if p != EMPTY && p != OFF && p != WK && p != BK {
                var f: i32 = 0;
                if old == 1 { f = sq64(g_ksq[persp]) * (NN_NPTF * 64) + nn_pt(p) * 64 + sq64(sq); }
                else { f = nn_feat(persp, p, sq); }
                g_ph_img[base + 1 + slot / 4] = g_ph_img[base + 1 + slot / 4] | ((f as i64) << ((slot % 4) * 16));
                slot = slot + 1;
            }
            sq = sq + 1;
        }
        if pi == 0 { c0 = slot; }
        pi = pi + 1;
    }
    var id: i64 = 4;
    if old == 1 { id = 5; }
    g_ph_img[base] = id | ((slot as i64) << 8) | ((c0 as i64) << 24);
}

fn phi_fen_build() {
    let L: *u8 = "PNBRQKpnbrqk";
    var o: i32 = 0;
    var rr: i32 = 7;
    while rr >= 0 {
        var emp: i32 = 0;
        var f: i32 = 0;
        while f < 8 {
            let sq: i32 = 21 + rr * 10 + f;
            let p: i32 = g_board[sq];
            if p == EMPTY { emp = emp + 1; }
            else {
                if emp > 0 { g_ph_fen[o] = (48 + emp) as u8; o = o + 1; emp = 0; }
                g_ph_fen[o] = L[p - 1]; o = o + 1;
            }
            f = f + 1;
        }
        if emp > 0 { g_ph_fen[o] = (48 + emp) as u8; o = o + 1; }
        if rr > 0 { g_ph_fen[o] = 47; o = o + 1; }
        rr = rr - 1;
    }
    g_ph_fen[o] = 32; o = o + 1;
    if g_side == WHITE { g_ph_fen[o] = 119; } else { g_ph_fen[o] = 98; }
    o = o + 1;
    g_ph_fen[o] = 32; o = o + 1;
    if g_castle == 0 { g_ph_fen[o] = 45; o = o + 1; }
    else {
        if g_castle & CWK != 0 { g_ph_fen[o] = 75; o = o + 1; }
        if g_castle & CWQ != 0 { g_ph_fen[o] = 81; o = o + 1; }
        if g_castle & CBK != 0 { g_ph_fen[o] = 107; o = o + 1; }
        if g_castle & CBQ != 0 { g_ph_fen[o] = 113; o = o + 1; }
    }
    g_ph_fen[o] = 32; o = o + 1;
    if g_ep == 0 { g_ph_fen[o] = 45; o = o + 1; }
    else {
        g_ph_fen[o] = (97 + (g_ep % 10) - 1) as u8; o = o + 1;
        g_ph_fen[o] = (49 + (g_ep / 10) - 2) as u8; o = o + 1;
    }
    g_ph_fen[o] = 32; o = o + 1;
    var ff: i32 = g_fifty;
    if ff >= 100 { g_ph_fen[o] = (48 + ff / 100) as u8; o = o + 1; ff = ff % 100; g_ph_fen[o] = (48 + ff / 10) as u8; o = o + 1; g_ph_fen[o] = (48 + ff % 10) as u8; o = o + 1; }
    else if ff >= 10 { g_ph_fen[o] = (48 + ff / 10) as u8; o = o + 1; g_ph_fen[o] = (48 + ff % 10) as u8; o = o + 1; }
    else { g_ph_fen[o] = (48 + ff) as u8; o = o + 1; }
    g_ph_fen[o] = 32; o = o + 1;
    g_ph_fen[o] = 49; o = o + 1;
    g_ph_fen[o] = 0;
}

fn phi_record(z: i64, src: i32) {
    if g_ph_n >= PH_MAXS {
        if g_ph_over == 0 { wr(1, "phifloor: SAMPLE CAP HIT -- results VOID (loud)\n"); }
        g_ph_over = 1;
        return;
    }
    let idx: i32 = g_ph_n;
    ph_pack_pos(idx);
    g_ph_band[idx] = nn_route();
    if g_ph_map == 1 { ph_img_mat(idx); }
    else if g_ph_map == 2 { ph_img_sense(idx); }
    else if g_ph_map == 3 { ph_img_pst(idx); }
    else if g_ph_map == 4 { ph_img_nn(idx, 0); }
    else { ph_img_nn(idx, 1); }
    g_ph_z[idx] = z;
    g_ph_src[idx] = src;
    if g_ph_dfd > 0 {
        phb_int(g_ph_map as i64); phb_ch(44);
        var setv: i64 = 0;
        if src >= 1073741824 { setv = 1; }
        phb_int(setv); phb_ch(44);
        phb_int(g_ph_band[idx] as i64); phb_ch(44);
        phb_int(z); phb_ch(44);
        phb_int(src as i64); phb_ch(44);
        phi_fen_build();
        phb_str(g_ph_fen);
        var w: i32 = 0;
        while w < PH_NWI { phb_ch(44); phb_int(g_ph_img[idx * PH_NWI + w]); w = w + 1; }
        w = 0;
        while w < PH_NWP { phb_ch(44); phb_int(g_ph_pos[idx * PH_NWP + w]); w = w + 1; }
        phb_ch(10);
    }
    g_ph_n = g_ph_n + 1;
}

fn phi_scan_games(scale: i64) {
    var g: i32 = 0;
    while g < g_tr_ngames {
        set_startpos();
        let start: i32 = g_tr_gstart[g];
        let len: i32 = g_tr_glen[g];
        let ropen: i32 = g_tr_gopen[g];
        var ply: i32 = 0;
        while ply < len {
            if ply >= ropen { phi_record(td_clamp(g_tr_sc[start + ply], scale), g * 512 + ply); }
            make_move(g_tr_moves[start + ply]);
            ply = ply + 1;
        }
        g = g + 1;
    }
    set_startpos();
}
fn phi_scan_anchors(scale: i64) {
    var i: i32 = 0;
    while i < g_an_n {
        let base: i32 = i * AN_FENLEN;
        var fl: i32 = 0;
        while g_an_fen[base + fl] != 0 { fl = fl + 1; }
        parse_fen(&g_an_fen[base], fl);
        var tgt: i64 = (g_an_z[i] as i64) * scale;
        if g_side == BLACK { tgt = 0 - tgt; }
        phi_record(tgt, 1073741824 + i);
        i = i + 1;
    }
    set_startpos();
}

fn phi_group() {
    var t: i32 = 0;
    while t < PH_TAB { g_ph_ftab[t] = 0; g_ph_ptab[t] = 0; g_ph_qkey[t] = 0; t = t + 1; }
    g_ph_nf = 0;
    g_ph_np = 0;
    var i: i32 = 0;
    while i < g_ph_n {
        // ---- fiber ----
        var h: i64 = ph_img_hash(i) & PH_TMASK;
        var fid: i32 = 0 - 1;
        while fid < 0 {
            let e: i32 = g_ph_ftab[h as i32];
            if e == 0 {
                fid = g_ph_nf;
                g_ph_ftab[h as i32] = i + 1;
                g_ph_fid[i] = fid;
                g_ph_fcnt[fid] = 0; g_ph_fS[fid] = 0; g_ph_fQ[fid] = 0;
                g_ph_fzmin[fid] = 1000000000; g_ph_fzmax[fid] = 0 - 1000000000;
                g_ph_fimin[fid] = i; g_ph_fimax[fid] = i;
                g_ph_fpos[fid] = 0;
                g_ph_fband[fid] = g_ph_band[i];
                g_ph_nf = g_ph_nf + 1;
            } else {
                let r: i32 = e - 1;
                if ph_img_eq(i, r) == 1 { fid = g_ph_fid[r]; g_ph_fid[i] = fid; }
                else { h = (h + 1) & PH_TMASK; }
            }
        }
        let z: i64 = g_ph_z[i];
        g_ph_fcnt[fid] = g_ph_fcnt[fid] + 1;
        g_ph_fS[fid] = g_ph_fS[fid] + z;
        g_ph_fQ[fid] = g_ph_fQ[fid] + z * z;
        if z < g_ph_fzmin[fid] { g_ph_fzmin[fid] = z; g_ph_fimin[fid] = i; }
        if z > g_ph_fzmax[fid] { g_ph_fzmax[fid] = z; g_ph_fimax[fid] = i; }
        // ---- position ----
        h = ph_pos_hash(i) & PH_TMASK;
        var pid: i32 = 0 - 1;
        while pid < 0 {
            let e2: i32 = g_ph_ptab[h as i32];
            if e2 == 0 {
                pid = g_ph_np;
                g_ph_ptab[h as i32] = i + 1;
                g_ph_pid[i] = pid;
                g_ph_pcnt[pid] = 0; g_ph_pS[pid] = 0; g_ph_pQ[pid] = 0;
                g_ph_pband[pid] = g_ph_band[i];
                g_ph_np = g_ph_np + 1;
            } else {
                let r2: i32 = e2 - 1;
                if ph_pos_eq(i, r2) == 1 { pid = g_ph_pid[r2]; g_ph_pid[i] = pid; }
                else { h = (h + 1) & PH_TMASK; }
            }
        }
        g_ph_pcnt[pid] = g_ph_pcnt[pid] + 1;
        g_ph_pS[pid] = g_ph_pS[pid] + z;
        g_ph_pQ[pid] = g_ph_pQ[pid] + z * z;
        // ---- (fiber, position) pairs ----
        let key: i64 = (((fid + 1) as i64) << 32) | ((pid + 1) as i64);
        h = ph_mix(777, key);
        if h < 0 { h = 0 - h; }
        h = h & PH_TMASK;
        var done: i32 = 0;
        while done == 0 {
            let k: i64 = g_ph_qkey[h as i32];
            if k == 0 {
                g_ph_qkey[h as i32] = key;
                g_ph_fpos[fid] = g_ph_fpos[fid] + 1;
                done = 1;
            } else {
                if k == key { done = 1; }
                else { h = (h + 1) & PH_TMASK; }
            }
        }
        i = i + 1;
    }
}

fn phi_replay_to(g: i32, ply: i32) {
    set_startpos();
    let start: i32 = g_tr_gstart[g];
    var i: i32 = 0;
    while i < ply { make_move(g_tr_moves[start + i]); i = i + 1; }
}
fn phi_witness_sample(s: i32) {
    let src: i32 = g_ph_src[s];
    wr(1, "      z="); wr_int(1, g_ph_z[s]);
    wr(1, " b"); wr_int(1, g_ph_band[s] as i64);
    wr(1, "  ");
    if src >= 1073741824 {
        let ai: i32 = src - 1073741824;
        wr(1, &g_an_fen[ai * AN_FENLEN]);
        wr(1, "  [anchor "); wr_int(1, ai as i64); wr(1, "]");
    } else {
        phi_replay_to(src / 512, src % 512);
        phi_fen_build();
        wr(1, g_ph_fen);
        wr(1, "  [g"); wr_int(1, (src / 512) as i64);
        wr(1, " ply"); wr_int(1, (src % 512) as i64); wr(1, "]");
    }
    wr(1, "\n");
}

fn phi_report() {
    var bn: [i64; 8] = 0;          // per band: samples
    var bq: [i64; 8] = 0;          // sse0 = sum z^2
    var bf: [i64; 8] = 0;          // fiber floor
    var bp: [i64; 8] = 0;          // label (position) floor
    var bfib: [i64; 8] = 0;        // fibers
    var bpos: [i64; 8] = 0;        // positions
    var bcol: [i64; 8] = 0;
    var i: i32 = 0;
    while i < g_ph_n {
        let b: i32 = g_ph_band[i];
        bn[b] = bn[b] + 1;
        bq[b] = bq[b] + g_ph_z[i] * g_ph_z[i];
        if g_ph_fpos[g_ph_fid[i]] >= 2 { bcol[b] = bcol[b] + 1; }
        i = i + 1;
    }
    var f: i32 = 0;
    while f < g_ph_nf {
        let c: i64 = g_ph_fcnt[f];
        let fl: i64 = g_ph_fQ[f] - (g_ph_fS[f] * g_ph_fS[f]) / c;
        bf[g_ph_fband[f]] = bf[g_ph_fband[f]] + fl;
        bfib[g_ph_fband[f]] = bfib[g_ph_fband[f]] + 1;
        f = f + 1;
    }
    var p: i32 = 0;
    while p < g_ph_np {
        let c2: i64 = g_ph_pcnt[p];
        let pl: i64 = g_ph_pQ[p] - (g_ph_pS[p] * g_ph_pS[p]) / c2;
        bp[g_ph_pband[p]] = bp[g_ph_pband[p]] + pl;
        bpos[g_ph_pband[p]] = bpos[g_ph_pband[p]] + 1;
        p = p + 1;
    }
    var tn: i64 = 0; var tq: i64 = 0; var tf: i64 = 0; var tp2: i64 = 0;
    var tfib: i64 = 0; var tpos: i64 = 0; var tcol: i64 = 0;
    var b2: i32 = 0;
    while b2 < 4 {
        wr(1, "  b"); wr_int(1, b2 as i64);
        wr(1, " n="); wr_int(1, bn[b2]);
        wr(1, " sse0="); wr_int(1, bq[b2]);
        wr(1, " fibers="); wr_int(1, bfib[b2]);
        wr(1, " pos="); wr_int(1, bpos[b2]);
        wr(1, " collided="); wr_int(1, bcol[b2]);
        wr(1, " fiber_floor="); wr_int(1, bf[b2]);
        wr(1, " label_floor="); wr_int(1, bp[b2]);
        wr(1, " map_loss="); wr_int(1, bf[b2] - bp[b2]);
        wr(1, "\n");
        tn = tn + bn[b2]; tq = tq + bq[b2]; tf = tf + bf[b2]; tp2 = tp2 + bp[b2];
        tfib = tfib + bfib[b2]; tpos = tpos + bpos[b2]; tcol = tcol + bcol[b2];
        b2 = b2 + 1;
    }
    wr(1, "  TOTAL n="); wr_int(1, tn);
    wr(1, " sse0="); wr_int(1, tq);
    wr(1, " fibers="); wr_int(1, tfib);
    wr(1, " pos="); wr_int(1, tpos);
    wr(1, " collided="); wr_int(1, tcol);
    wr(1, " fiber_floor="); wr_int(1, tf);
    wr(1, " label_floor="); wr_int(1, tp2);
    wr(1, " map_loss="); wr_int(1, tf - tp2);
    wr(1, "\n");
    if tn > 0 {
        wr(1, "  per-sample: mse0="); wr_int(1, tq / tn);
        wr(1, " fiber_floor="); wr_int(1, tf / tn);
        wr(1, " label_floor="); wr_int(1, tp2 / tn);
        wr(1, " map_loss="); wr_int(1, (tf - tp2) / tn);
        wr(1, "\n");
    }
    var w0: i32 = 0 - 1; var w1: i32 = 0 - 1; var w2: i32 = 0 - 1;
    var s0: i64 = 0 - 1; var s1: i64 = 0 - 1; var s2: i64 = 0 - 1;
    f = 0;
    while f < g_ph_nf {
        if g_ph_fpos[f] >= 2 {
            let sp: i64 = g_ph_fzmax[f] - g_ph_fzmin[f];
            if sp > s0 { s2 = s1; w2 = w1; s1 = s0; w1 = w0; s0 = sp; w0 = f; }
            else if sp > s1 { s2 = s1; w2 = w1; s1 = sp; w1 = f; }
            else if sp > s2 { s2 = sp; w2 = f; }
        }
        f = f + 1;
    }
    if w0 >= 0 {
        wr(1, "  witnesses (multi-position fibers, by target spread):\n");
        var wi: i32 = 0;
        while wi < 3 {
            var wf: i32 = 0 - 1;
            if wi == 0 { wf = w0; }
            if wi == 1 { wf = w1; }
            if wi == 2 { wf = w2; }
            if wf >= 0 {
                wr(1, "    fiber n="); wr_int(1, g_ph_fcnt[wf]);
                wr(1, " distinct_pos="); wr_int(1, g_ph_fpos[wf] as i64);
                wr(1, " spread="); wr_int(1, g_ph_fzmax[wf] - g_ph_fzmin[wf]);
                if ph_pos_eq(g_ph_fimin[wf], g_ph_fimax[wf]) == 1 { wr(1, "  [same-position extremes: label-noise]"); }
                else { wr(1, "  [DIFFERENT positions, one image: MAP LOSS]"); }
                wr(1, "\n");
                phi_witness_sample(g_ph_fimin[wf]);
                phi_witness_sample(g_ph_fimax[wf]);
            }
            wi = wi + 1;
        }
        set_startpos();
    } else {
        wr(1, "  witnesses: none (no fiber contains two distinct positions)\n");
    }
}

fn phi_mapname(id: i32) {
    if id == 1 { wr(1, "mat"); }
    else if id == 2 { wr(1, "sense"); }
    else if id == 3 { wr(1, "pst"); }
    else if id == 4 { wr(1, "nnue"); }
    else { wr(1, "nnueold"); }
}
fn phi_run(mapid: i32, anchors: i32, scale: i64) {
    g_ph_map = mapid;
    g_ph_n = 0;
    g_ph_over = 0;
    g_ph_dfd = 0;
    if g_ph_dlen > 0 { g_ph_dfd = creat(g_ph_dpath, 438); g_ph_oblen = 0; }
    let t0: i64 = now_ms();
    if anchors == 1 { phi_scan_anchors(scale); } else { phi_scan_games(scale); }
    wr(1, "phifloor map=");
    phi_mapname(mapid);
    if anchors == 1 { wr(1, " set=anchors"); } else { wr(1, " set=games"); }
    wr(1, " scale="); wr_int(1, scale);
    wr(1, " samples="); wr_int(1, g_ph_n as i64);
    wr(1, "\n");
    if g_ph_over == 1 {
        wr(1, "phifloor: VOID (sample cap)\n");
    } else {
        phi_group();
        phi_report();
    }
    if g_ph_dfd > 0 { phb_flush(); close(g_ph_dfd); g_ph_dfd = 0; }
    wr(1, "  ("); wr_int(1, now_ms() - t0); wr(1, " ms)\n");
}
fn phi_gen(games: i32, depth: i32, maxply: i32) {
    nn_tr_alloc();
    g_tr_ngames = 0;
    g_tr_fill = 0;
    g_tr_rng = 0x9E3779B97F4A7C15;
    let t0: i64 = now_ms();
    var g: i32 = 0;
    while g < games {
        if g_tr_fill + maxply + 1 > TR_MAXMOVES { g = games; }
        else {
            let ropen: i32 = 4 + (nn_rng_next() % 9) as i32;
            nn_play_game(ropen, depth, maxply);
            g = g + 1;
        }
    }
    set_startpos();
    wr(1, "phifloor gen games "); wr_int(1, g_tr_ngames as i64);
    wr(1, " positions "); wr_int(1, nn_count_positions(0, g_tr_ngames));
    wr(1, " depth "); wr_int(1, depth as i64);
    wr(1, " maxply "); wr_int(1, maxply as i64);
    wr(1, "  ("); wr_int(1, now_ms() - t0); wr(1, " ms)\n");
}

// ---------------- token scanning ----------------

var g_scanpos: i32 = 0;

fn next_tok(line: *u8, len: i32) -> i32 {
    var p: i32 = g_scanpos;
    while p < len && (line[p] as i32 == 32 || line[p] as i32 == 9) { p = p + 1; }
    if p >= len { return 0; }
    var t: i32 = 0;
    while p < len && line[p] as i32 != 32 && line[p] as i32 != 9 && t < 255 {
        g_tok[t] = line[p];
        t = t + 1;
        p = p + 1;
    }
    g_tok[t] = 0;
    g_scanpos = p;
    return 1;
}

fn tok_eq(s: *u8) -> i32 {
    var i: i32 = 0;
    while s[i] != 0 || g_tok[i] != 0 {
        if s[i] != g_tok[i] { return 0; }
        i = i + 1;
    }
    return 1;
}

fn tok_to_int() -> i64 {
    var v: i64 = 0;
    var i: i32 = 0;
    var neg: i32 = 0;
    if g_tok[0] as i32 == 45 { neg = 1; i = 1; }
    while g_tok[i] != 0 {
        v = v * 10 + (g_tok[i] as i32 - 48) as i64;
        i = i + 1;
    }
    if neg == 1 { return 0 - v; }
    return v;
}

// ---------------- uci ----------------

fn handle_position(line: *u8, len: i32) {
    regime_reset();
    if next_tok(line, len) == 0 { return; }
    if tok_eq("startpos") == 1 {
        set_startpos();
    } else if tok_eq("fen") == 1 {
        var fenbuf: [u8; 128] = 0;
        var fl: i32 = 0;
        var got: i32 = next_tok(line, len);
        while got == 1 && tok_eq("moves") == 0 {
            var i: i32 = 0;
            while g_tok[i] != 0 && fl < 126 {
                fenbuf[fl] = g_tok[i];
                fl = fl + 1;
                i = i + 1;
            }
            fenbuf[fl] = 32;
            fl = fl + 1;
            got = next_tok(line, len);
        }
        fenbuf[fl] = 0;
        parse_fen(&fenbuf[0], fl);
        regime_update();
        if got == 1 && tok_eq("moves") == 1 {
            while next_tok(line, len) == 1 {
                apply_uci_move(g_tok, str_len(g_tok));
                regime_update();
            }
        }
        return;
    }
    if next_tok(line, len) == 1 && tok_eq("moves") == 1 {
        while next_tok(line, len) == 1 {
            apply_uci_move(g_tok, str_len(g_tok));
            regime_update();
        }
    }
}

fn handle_go(line: *u8, len: i32) {
    var wtime: i64 = 0 - 1;
    var btime: i64 = 0 - 1;
    var winc: i64 = 0;
    var binc: i64 = 0;
    var movetime: i64 = 0 - 1;
    var depth: i32 = 0;
    var temp: i32 = 0;
    var seed: i64 = 0 - 1;

    while next_tok(line, len) == 1 {
        if tok_eq("wtime") == 1 { if next_tok(line, len) == 1 { wtime = tok_to_int(); } }
        else if tok_eq("btime") == 1 { if next_tok(line, len) == 1 { btime = tok_to_int(); } }
        else if tok_eq("winc") == 1 { if next_tok(line, len) == 1 { winc = tok_to_int(); } }
        else if tok_eq("binc") == 1 { if next_tok(line, len) == 1 { binc = tok_to_int(); } }
        else if tok_eq("movetime") == 1 { if next_tok(line, len) == 1 { movetime = tok_to_int(); } }
        else if tok_eq("depth") == 1 { if next_tok(line, len) == 1 { depth = tok_to_int() as i32; } }
        else if tok_eq("temperature") == 1 { if next_tok(line, len) == 1 { temp = tok_to_int() as i32; } }
        else if tok_eq("seed") == 1 { if next_tok(line, len) == 1 { seed = tok_to_int(); } }
    }

    if temp < 0 { temp = 0; }
    if temp > 1000 { temp = 1000; }
    g_temp = temp;
    g_root_cn = 0;
    if seed >= 0 { g_rng = seed + 88172645463325252; }

    g_maxdepth = 64;
    g_budget = 0;
    g_tc_clock = 0;
    if depth > 0 {
        g_maxdepth = depth;
    } else if movetime >= 0 {
        g_budget = movetime - 20;
        if g_budget < 10 { g_budget = 10; }
    } else {
        var mytime: i64 = wtime;
        var myinc: i64 = winc;
        if g_side == BLACK { mytime = btime; myinc = binc; }
        if mytime >= 0 {
            g_budget = mytime / 25 + myinc / 2;
            if g_budget > mytime - 100 { g_budget = mytime - 100; }
            if g_budget < 15 { g_budget = 15; }
            g_tc_clock = 1;
        } else {
            g_budget = 2000;
        }
    }
    think();
}

fn handle_line(line: *u8, len: i32) {
    g_scanpos = 0;
    if next_tok(line, len) == 0 { return; }

    if tok_eq("uci") == 1 {
        wr(1, "id name Wanderer 1.0\n");
        wr(1, "id author Traveler\n");
        wr(1, "uciok\n");
    } else if tok_eq("isready") == 1 {
        wr(1, "readyok\n");
    } else if tok_eq("nncnt") == 1 {
        wr(1, "nncnt cols "); wr_int(1, g_c_col);
        wr(1, " mk "); wr_int(1, g_c_col_mk);
        wr(1, " un "); wr_int(1, g_c_col_un);
        wr(1, " rf "); wr_int(1, g_c_col_rf);
        wr(1, " rec "); wr_int(1, g_c_rec);
        wr(1, " cpy "); wr_int(1, g_c_cpy);
        wr(1, " evals "); wr_int(1, g_c_eval);
        wr(1, " ens "); wr_int(1, g_c_ens);
        wr(1, " lzhi "); wr_int(1, g_c_lzhi);
        wr(1, " lzlo "); wr_int(1, g_c_lzlo);
        wr(1, " ehit "); wr_int(1, g_c_ehit);
        wr(1, " enn "); wr_int(1, g_c_enn); wr(1, "\n");
        g_c_col = 0; g_c_rec = 0; g_c_eval = 0;
        g_c_col_mk = 0; g_c_col_un = 0; g_c_col_rf = 0; g_c_cpy = 0; g_c_ens = 0;
        g_c_lzhi = 0; g_c_lzlo = 0; g_c_ehit = 0; g_c_enn = 0;
    } else if tok_eq("ucinewgame") == 1 {
        tt_clear();
        set_startpos();
    } else if tok_eq("position") == 1 {
        handle_position(line, len);
    } else if tok_eq("go") == 1 {
        handle_go(line, len);
    } else if tok_eq("tb") == 1 {
        tb_build_all();
        wr(1, "tb built  KQK longest-mate "); wr_int(1, tb_longest_of(g_tbq) as i64);
        wr(1, " (want 10)  KRK longest-mate "); wr_int(1, tb_longest_of(g_tbr) as i64);
        wr(1, " (want 16)\n");
    } else if tok_eq("tbprobe") == 1 {
        if next_tok(line, len) == 1 { g_tbprobe = tok_to_int() as i32; }
        wr(1, "tbprobe "); wr_int(1, g_tbprobe as i64); wr(1, "\n");
    } else if tok_eq("nullmove") == 1 {
        if next_tok(line, len) == 1 { g_use_null = tok_to_int() as i32; }
        wr(1, "nullmove "); wr_int(1, g_use_null as i64); wr(1, "\n");
    } else if tok_eq("timecurve") == 1 {
        // set 0|1 (optional), then print the gain curve sampled at d=0..400 step 50
        if next_tok(line, len) == 1 { g_tc_curve = tok_to_int() as i32; }
        wr(1, "timecurve "); wr_int(1, g_tc_curve as i64);
        var td: i32 = 0;
        while td <= 400 {
            wr(1, " "); wr_int(1, td as i64); wr(1, ":"); wr_int(1, tc_gain(td) as i64);
            td = td + 50;
        }
        wr(1, "\n");
    } else if tok_eq("tdlabel") == 1 {
        if next_tok(line, len) == 1 { g_tdlabel = tok_to_int() as i32; }
        wr(1, "tdlabel "); wr_int(1, g_tdlabel as i64); wr(1, "\n");
    } else if tok_eq("tdfocus") == 1 {
        if next_tok(line, len) == 1 { g_tdfocus = tok_to_int() as i32; }
        if next_tok(line, len) == 1 { g_td_theta = tok_to_int(); }
        wr(1, "tdfocus "); wr_int(1, g_tdfocus as i64);
        wr(1, " theta "); wr_int(1, g_td_theta); wr(1, "\n");
    } else if tok_eq("phifloor") == 1 {
        phi_alloc();
        if next_tok(line, len) == 1 {
            if tok_eq("gen") == 1 {
                var pg: i32 = 320; var pd: i32 = 4; var pm: i32 = 200;
                if next_tok(line, len) == 1 { pg = tok_to_int() as i32; }
                if next_tok(line, len) == 1 { pd = tok_to_int() as i32; }
                if next_tok(line, len) == 1 { pm = tok_to_int() as i32; }
                if pm > 500 { pm = 500; }
                phi_gen(pg, pd, pm);
            } else if tok_eq("dump") == 1 {
                if next_tok(line, len) == 1 {
                    if tok_eq("off") == 1 { g_ph_dlen = 0; wr(1, "phifloor dump off\n"); }
                    else {
                        var di: i32 = 0;
                        while g_tok[di] != 0 && di < 127 { g_ph_dpath[di] = g_tok[di]; di = di + 1; }
                        g_ph_dpath[di] = 0;
                        g_ph_dlen = di;
                        wr(1, "phifloor dump -> "); wr(1, g_ph_dpath); wr(1, "\n");
                    }
                }
            } else {
                var mapid: i32 = 0;
                if tok_eq("mat") == 1 { mapid = 1; }
                else if tok_eq("sense") == 1 { mapid = 2; }
                else if tok_eq("pst") == 1 { mapid = 3; }
                else if tok_eq("nnue") == 1 { mapid = 4; }
                else if tok_eq("nnueold") == 1 { mapid = 5; }
                if mapid == 0 { wr(1, "phifloor: unknown map (mat|sense|pst|nnue|nnueold)\n"); }
                else {
                    var anch: i32 = 0;
                    var scale: i64 = 100;
                    if next_tok(line, len) == 1 {
                        if tok_eq("anchors") == 1 { anch = 1; }
                        else { scale = tok_to_int(); }
                    }
                    if next_tok(line, len) == 1 { scale = tok_to_int(); }
                    if scale < 1 { scale = 100; }
                    if anch == 1 && g_an_n == 0 { wr(1, "phifloor: no anchors loaded (nnue anchor PATH first)\n"); }
                    else if anch == 0 && g_tr_ngames == 0 { wr(1, "phifloor: no corpus (run `phifloor gen` first)\n"); }
                    else { phi_run(mapid, anch, scale); }
                }
            }
        }
    } else if tok_eq("pstdump") == 1 {
        if next_tok(line, len) == 1 {
            var pbuf: [u8; 256] = 0;
            var pi: i32 = 0;
            while g_tok[pi] != 0 && pi < 255 { pbuf[pi] = g_tok[pi]; pi = pi + 1; }
            pbuf[pi] = 0;
            var dg: i32 = 320; var dd: i32 = 4;
            if next_tok(line, len) == 1 { dg = tok_to_int() as i32; }
            if next_tok(line, len) == 1 { dd = tok_to_int() as i32; }
            pst_dump(&pbuf[0], dg, dd);
        }
    } else if tok_eq("pstgate") == 1 {
        var pg: i32 = 320; var pd: i32 = 4;
        if next_tok(line, len) == 1 { pg = tok_to_int() as i32; }
        if next_tok(line, len) == 1 { pd = tok_to_int() as i32; }
        pst_gate(pg, pd);
    } else if tok_eq("tddump") == 1 {
        if next_tok(line, len) == 1 {
            var pbuf: [u8; 256] = 0;
            var pi: i32 = 0;
            while g_tok[pi] != 0 && pi < 255 { pbuf[pi] = g_tok[pi]; pi = pi + 1; }
            pbuf[pi] = 0;
            var dg: i32 = 320; var dd: i32 = 4;
            if next_tok(line, len) == 1 { dg = tok_to_int() as i32; }
            if next_tok(line, len) == 1 { dd = tok_to_int() as i32; }
            td_dump(&pbuf[0], dg, dd);
        }
    } else if tok_eq("matgate") == 1 {
        var mg: i32 = 320; var md: i32 = 4;
        var mw: [i64; 6] = 0;
        if next_tok(line, len) == 1 { mg = tok_to_int() as i32; }
        if next_tok(line, len) == 1 { md = tok_to_int() as i32; }
        var mi: i32 = 0;
        while mi < 6 { if next_tok(line, len) == 1 { mw[mi] = tok_to_int(); } mi = mi + 1; }
        mat_gate(mg, md, &mw[0]);
    } else if tok_eq("tdseg") == 1 {
        var sg: i32 = 80; var sp: i32 = 4; var st: i64 = 32;
        if next_tok(line, len) == 1 { sg = tok_to_int() as i32; }
        if next_tok(line, len) == 1 { sp = tok_to_int() as i32; }
        if next_tok(line, len) == 1 { st = tok_to_int(); }
        td_seg(sg, sp, st);
    } else if tok_eq("tbmirror") == 1 {
        tb_mirror_gate();
    } else if tok_eq("tbat") == 1 {
        let r: i32 = tb_probe(0);
        wr(1, "tbat inclass "); wr_int(1, r as i64); wr(1, " score "); wr_int(1, g_probe_sc as i64); wr(1, "\n");
    } else if tok_eq("tdmap") == 1 {
        var tg: i32 = 80; var tp: i32 = 4; var ts: i32 = 8;
        if next_tok(line, len) == 1 { tg = tok_to_int() as i32; }
        if next_tok(line, len) == 1 { tp = tok_to_int() as i32; }
        if next_tok(line, len) == 1 { ts = tok_to_int() as i32; }
        td_map(tg, tp, ts);
    } else if tok_eq("perft") == 1 {
        if next_tok(line, len) == 1 {
            let d: i32 = tok_to_int() as i32;
            let t0: i64 = now_ms();
            let n: i64 = perft(d, 0);
            let t1: i64 = now_ms();
            wr(1, "perft ");
            wr_int(1, d as i64);
            wr(1, " = ");
            wr_int(1, n);
            wr(1, "  (");
            wr_int(1, t1 - t0);
            wr(1, " ms)\n");
        }
    } else if tok_eq("legalmoves") == 1 {
        wr(1, "legalmoves");
        gen_moves(0, 0);
        var lm: i32 = g_first[0];
        let lm_hi: i32 = g_first[1];
        while lm < lm_hi {
            if make_move(g_mv[lm]) == 1 {
                unmake_move();
                wr(1, " ");
                wr_move(1, g_mv[lm]);
            }
            lm = lm + 1;
        }
        wr(1, " | check ");
        wr_int(1, in_check(g_side) as i64);
        wr(1, "\n");
    } else if tok_eq("board") == 1 {
        wr(1, "board ");
        var br: i32 = 7;
        while br >= 0 {
            var bemp: i32 = 0;
            var bf: i32 = 0;
            while bf < 8 {
                let bp: i32 = g_board[21 + br * 10 + bf];
                if bp == EMPTY {
                    bemp = bemp + 1;
                } else {
                    if bemp > 0 { wr_int(1, bemp as i64); bemp = 0; }
                    let bk: i32 = bp - piece_side(bp) * 6;
                    var bc: i32 = 107;                    // k
                    if bk == WP { bc = 112; }
                    else if bk == WN { bc = 110; }
                    else if bk == WB { bc = 98; }
                    else if bk == WR { bc = 114; }
                    else if bk == WQ { bc = 113; }
                    if piece_side(bp) == WHITE { bc = bc - 32; }
                    wr_ch(1, bc);
                }
                bf = bf + 1;
            }
            if bemp > 0 { wr_int(1, bemp as i64); }
            if br > 0 { wr_ch(1, 47); }
            br = br - 1;
        }
        if g_side == WHITE { wr(1, " w\n"); } else { wr(1, " b\n"); }
    } else if tok_eq("eval") == 1 {
        wr(1, "eval ");
        wr_int(1, evaluate() as i64);
        wr(1, "\n");
    } else if tok_eq("evalks") == 1 {
        var npm: i32 = 0;
        var s2: i32 = 21;
        while s2 <= 98 {
            let p: i32 = g_board[s2];
            if p != EMPTY && p != OFF {
                let kind: i32 = p - piece_side(p) * 6;
                if kind != WP && kind != WK { npm = npm + g_pval[p]; }
            }
            s2 = s2 + 1;
        }
        wr(1, "evalks kw ");
        wr_int(1, king_danger(WHITE) as i64);
        wr(1, " rw ");
        wr_int(1, g_kd_raw as i64);
        wr(1, " aw ");
        wr_int(1, g_kd_att as i64);
        wr(1, " xw ");
        wr_int(1, king_weakness(WHITE) as i64);
        wr(1, " hw ");
        wr_int(1, king_holes(WHITE) as i64);
        wr(1, " gw ");
        wr_int(1, king_reach(WHITE) as i64);
        wr(1, " kb ");
        wr_int(1, king_danger(BLACK) as i64);
        wr(1, " rb ");
        wr_int(1, g_kd_raw as i64);
        wr(1, " ab ");
        wr_int(1, g_kd_att as i64);
        wr(1, " xb ");
        wr_int(1, king_weakness(BLACK) as i64);
        wr(1, " hb ");
        wr_int(1, king_holes(BLACK) as i64);
        wr(1, " gb ");
        wr_int(1, king_reach(BLACK) as i64);
        wr(1, " npmat ");
        wr_int(1, npm as i64);
        wr(1, " total ");
        wr_int(1, evaluate() as i64);
        wr(1, "\n");
    } else if tok_eq("regime") == 1 {
        wr(1, "regime state ");
        wr_int(1, g_reg_state as i64);
        wr(1, " phase ");
        wr_int(1, g_reg_phase as i64);
        wr(1, " side ");
        wr_int(1, g_reg_side as i64);
        wr(1, " dmax ");
        wr_int(1, g_reg_dmax as i64);
        wr(1, " base ");
        wr_int(1, g_reg_base as i64);
        wr(1, " onset ");
        wr_int(1, g_reg_onset as i64);
        wr(1, " events ");
        wr_int(1, g_reg_events as i64);
        wr(1, " ply ");
        wr_int(1, g_reg_ply as i64);
        wr(1, "\n");
    } else if tok_eq("sense") == 1 {
        wr(1, "sense rw ");
        wr_int(1, g_sn_rw as i64);
        wr(1, " rb ");
        wr_int(1, g_sn_rb as i64);
        wr(1, " hw ");
        wr_int(1, g_sn_hw as i64);
        wr(1, " hb ");
        wr_int(1, g_sn_hb as i64);
        wr(1, " gw ");
        wr_int(1, g_sn_gw as i64);
        wr(1, " gb ");
        wr_int(1, g_sn_gb as i64);
        wr(1, " xw ");
        wr_int(1, g_sn_xw as i64);
        wr(1, " xb ");
        wr_int(1, g_sn_xb as i64);
        wr(1, " npmat ");
        wr_int(1, g_sn_npmat as i64);
        wr(1, " phase ");
        wr_int(1, g_reg_phase as i64);
        wr(1, "\n");
    } else if tok_eq("nnue") == 1 {
        if next_tok(line, len) == 0 {
            nn_recompute_all();
            wr(1, "nnue eval "); wr_int(1, nn_eval());
            wr(1, " gate "); wr_int(1, nn_equal_recompute() as i64); wr(1, "\n");
        } else if tok_eq("selftest") == 1 {
            var np: i32 = 200;
            if next_tok(line, len) == 1 { np = tok_to_int() as i32; }
            if np < 1 { np = 1; }
            if np > 800 { np = 800; }
            nnue_selftest(np);
        } else if tok_eq("gradcheck") == 1 {
            wr(1, "nnue gradcheck ERR retired-v2 (in-engine trainer retired at H=256; train via MLX)\n");
        } else if tok_eq("train") == 1 {
            wr(1, "nnue train ERR retired-v2 (in-engine trainer retired at H=256; train via MLX)\n");
        } else if tok_eq("boundcheck") == 1 {
            // lane-bound certificate: 32 active features x max|w| must stay under 2^12
            let ftp: *i16 = g_nn_ft;
            var mx: i64 = 0; var ii: i32 = 0;
            while ii < NN_NFH * NN_H { var v: i64 = ftp[ii] as i64; if v < 0 { v = 0 - v; } if v > mx { mx = v; } ii = ii + 1; }
            let bound: i64 = mx * 32;
            wr(1, "nnue boundcheck max|w| "); wr_int(1, mx);
            wr(1, " x32 "); wr_int(1, bound);
            if bound < 4096 { wr(1, "  [CERTIFIED: acc fits int16 with 3 guard bits]\n"); }
            else { if bound < 32768 { wr(1, "  [OK: fits int16, no lane-guard headroom]\n"); } else { wr(1, "  [FAIL: int16 overflow possible]\n"); } }
        } else if tok_eq("oracle") == 1 {
            // recompute-verify every nn_eval (the differential oracle; slow)
            if next_tok(line, len) == 1 { g_nn_oracle = tok_to_int() as i32; }
            wr(1, "nnue oracle "); wr_int(1, g_nn_oracle as i64); wr(1, "\n");
        } else if tok_eq("lazy") == 1 {
            // lazy margin M = a + |classical|>>b; a<0 disables skipping
            if next_tok(line, len) == 1 { g_lz_a = tok_to_int() as i32; }
            if next_tok(line, len) == 1 {
                g_lz_b = tok_to_int() as i32;
                if g_lz_b < 0 { g_lz_b = 0; }
                if g_lz_b > 8 { g_lz_b = 8; }
            }
            evc_clear();               // slots stay exact under any policy; cleared
                                       // so A/B timing runs start cold (fair ruler)
            wr(1, "nnue lazy a "); wr_int(1, g_lz_a as i64);
            wr(1, " b "); wr_int(1, g_lz_b as i64); wr(1, "\n");
        } else if tok_eq("walkcap") == 1 {
            if next_tok(line, len) == 1 {
                g_nn_walkcap = tok_to_int() as i32;
                if g_nn_walkcap < 1 { g_nn_walkcap = 1; }
            }
            wr(1, "nnue walkcap "); wr_int(1, g_nn_walkcap as i64); wr(1, "\n");
        } else if tok_eq("onebit") == 1 {
            if next_tok(line, len) == 1 { g_onebit = tok_to_int() as i32; }
            wr(1, "nnue onebit "); wr_int(1, g_onebit as i64); wr(1, "\n");
        } else if tok_eq("mode") == 1 {
            if next_tok(line, len) == 1 { g_eval_mode = tok_to_int() as i32; }
            wr(1, "nnue mode "); wr_int(1, g_eval_mode as i64);
            if g_eval_mode == 0 { wr(1, " (classical)"); }
            if g_eval_mode == 1 { wr(1, " (blend)"); }
            if g_eval_mode == 2 { wr(1, " (replace: material+net)"); }
            wr(1, "\n");
        } else if tok_eq("factor") == 1 {
            if next_tok(line, len) == 1 { g_factor = tok_to_int() as i32; }
            if next_tok(line, len) == 1 { g_fshift = tok_to_int(); }
            wr(1, "nnue factor "); wr_int(1, g_factor as i64);
            wr(1, " fshift "); wr_int(1, g_fshift); wr(1, "\n");
        } else if tok_eq("factorcheck") == 1 {
            wr(1, "factorcheck ERR retired-v2 (in-engine trainer retired at H=256; train via MLX)\n");
        } else if tok_eq("ternarycheck") == 1 {
            var bad: i64 = 0;
            var ii: i32 = 0;
            while ii < NN_H * NN_NFH { let v: i64 = g_nn_ft[ii]; if v > 1 { bad = bad + 1; } if v < 0 - 1 { bad = bad + 1; } ii = ii + 1; }
            ii = 0;
            while ii < NN_K * 2 * NN_H { let v2: i64 = g_nn_w2[ii]; if v2 > 1 { bad = bad + 1; } if v2 < 0 - 1 { bad = bad + 1; } ii = ii + 1; }
            wr(1, "ternarycheck violations "); wr_int(1, bad);
            if bad == 0 { wr(1, "  [EXACT: all weights in {-1,0,+1}]\n"); } else { wr(1, "  [FAIL]\n"); }
        } else if tok_eq("pstbase") == 1 {
            if next_tok(line, len) == 1 {
                if tok_eq("off") == 1 {
                    g_pst_on = 0;
                    evc_clear();       // classical eval shape may change
                    wr(1, "nnue pstbase off\n");
                } else {
                    var pb: [u8; 256] = 0;
                    var pj: i32 = 0;
                    while g_tok[pj] != 0 && pj < 255 { pb[pj] = g_tok[pj]; pj = pj + 1; }
                    pb[pj] = 0;
                    let nw: i32 = pst_load(&pb[0]);
                    if nw > 0 { g_pst_on = 1; g_base_on = 0; }
                    wr(1, "nnue pstbase loaded "); wr_int(1, nw as i64); wr(1, " weights\n");
                }
            }
        } else if tok_eq("base") == 1 {
            if next_tok(line, len) == 1 {
                if tok_eq("off") == 1 {
                    g_base_on = 0;
                    wr(1, "nnue base off\n");
                } else {
                    if g_base_w == null { g_base_w = alloc(6); }
                    g_base_w[0] = tok_to_int();
                    var bi: i32 = 1;
                    while bi < 6 { if next_tok(line, len) == 1 { g_base_w[bi] = tok_to_int(); } bi = bi + 1; }
                    g_base_on = 1;
                    g_pst_on = 0;
                    wr(1, "nnue base on (Q20:");
                    bi = 0;
                    while bi < 6 { wr(1, " "); wr_int(1, g_base_w[bi]); bi = bi + 1; }
                    wr(1, ")\n");
                }
            }
        } else if tok_eq("anchor") == 1 {
            if next_tok(line, len) == 1 {
                if tok_eq("clear") == 1 {
                    g_an_n = 0;
                    wr(1, "nnue anchor cleared\n");
                } else {
                    var pbuf: [u8; 256] = 0;      // copy path out: next_tok clobbers g_tok
                    var pi: i32 = 0;
                    while g_tok[pi] != 0 && pi < 255 { pbuf[pi] = g_tok[pi]; pi = pi + 1; }
                    pbuf[pi] = 0;
                    var stride: i32 = 1;
                    var cap: i32 = 8192;
                    if next_tok(line, len) == 1 { stride = tok_to_int() as i32; }
                    if next_tok(line, len) == 1 { cap = tok_to_int() as i32; }
                    if stride < 1 { stride = 1; }
                    if cap < 0 { cap = 0; }
                    nn_anchor_load(&pbuf[0], stride, cap);
                }
            }
        } else if tok_eq("save") == 1 {
            if next_tok(line, len) == 1 {
                let rc: i32 = nn_save(g_tok);
                wr(1, "nnue save "); wr_int(1, rc as i64); wr(1, "\n");
            }
        } else if tok_eq("load") == 1 {
            if next_tok(line, len) == 1 {
                let rc: i32 = nn_load(g_tok);
                wr(1, "nnue load "); wr_int(1, rc as i64); wr(1, "\n");
            }
        } else if tok_eq("dump") == 1 {
            if next_tok(line, len) == 1 {
                var pbuf: [u8; 256] = 0;      // copy path: next_tok clobbers g_tok
                var pi: i32 = 0;
                while g_tok[pi] != 0 && pi < 255 { pbuf[pi] = g_tok[pi]; pi = pi + 1; }
                pbuf[pi] = 0;
                var games: i32 = 200; var depth: i32 = 4; var seed: i64 = 0x9E3779B97F4A7C15;
                if next_tok(line, len) == 1 { games = tok_to_int() as i32; }
                if next_tok(line, len) == 1 { depth = tok_to_int() as i32; }
                if next_tok(line, len) == 1 { seed = tok_to_int(); }
                nn_dump(&pbuf[0], games, depth, seed);
            }
        } else if tok_eq("dumpsib") == 1 {
            if next_tok(line, len) == 1 {
                var pbuf2: [u8; 256] = 0;         // copy path: next_tok clobbers g_tok
                var pj2: i32 = 0;
                while g_tok[pj2] != 0 && pj2 < 255 { pbuf2[pj2] = g_tok[pj2]; pj2 = pj2 + 1; }
                pbuf2[pj2] = 0;
                var sg: i32 = 60; var sd: i32 = 4; var sseed: i64 = 0x9E3779B97F4A7C15;
                var sdd: i32 = 5; var sstr: i32 = 7;
                if next_tok(line, len) == 1 { sg = tok_to_int() as i32; }
                if next_tok(line, len) == 1 { sd = tok_to_int() as i32; }
                if next_tok(line, len) == 1 { sseed = tok_to_int(); }
                if next_tok(line, len) == 1 { sdd = tok_to_int() as i32; }
                if next_tok(line, len) == 1 { sstr = tok_to_int() as i32; }
                if sstr < 1 { sstr = 1; }
                nn_dumpsib(&pbuf2[0], sg, sd, sseed, sdd, sstr);
            }
        } else if tok_eq("dumpself") == 1 {
            if next_tok(line, len) == 1 {
                var pbuf3: [u8; 256] = 0;
                var pj3: i32 = 0;
                while g_tok[pj3] != 0 && pj3 < 255 { pbuf3[pj3] = g_tok[pj3]; pj3 = pj3 + 1; }
                pbuf3[pj3] = 0;
                var fg: i32 = 100; var fd2: i32 = 4; var fseed: i64 = 0x9E3779B97F4A7C15;
                if next_tok(line, len) == 1 { fg = tok_to_int() as i32; }
                if next_tok(line, len) == 1 { fd2 = tok_to_int() as i32; }
                if next_tok(line, len) == 1 { fseed = tok_to_int(); }
                nn_dumpself(&pbuf3[0], fg, fd2, fseed);
            }
        } else if tok_eq("import") == 1 {
            if next_tok(line, len) == 1 {
                let rc: i32 = nn_import(g_tok);
                wr(1, "nnue import "); wr_int(1, rc as i64); wr(1, "\n");
            }
        } else {
            nn_recompute_all();
            wr(1, "nnue eval "); wr_int(1, nn_eval());
            wr(1, " gate "); wr_int(1, nn_equal_recompute() as i64); wr(1, "\n");
        }
    } else if tok_eq("quit") == 1 {
        exit(0);
    }
}

fn main() {
    init_tables();
    if NN_BLEND == 1 || g_eval_mode >= 1 {  // any net-consuming build boots it
        if nn_load("wanderer.nnue") == 0 {
            wr(2, "fatal: net-eval build requires valid wanderer.nnue\n");
            exit(1);
        }
    }
    set_startpos();

    let scratch: *u8 = alloc(4096);
    var used: i32 = 0;
    while 1 == 1 {
        let n: i64 = read_bytes(0, scratch, 4096);
        if n <= 0 { break; }
        var ci: i32 = 0;
        while ci < n as i32 && used < 65530 {
            g_inbuf[used] = scratch[ci];
            used = used + 1;
            ci = ci + 1;
        }

        var start: i32 = 0;
        var i: i32 = 0;
        while i < used {
            if g_inbuf[i] as i32 == 10 {
                var l: i32 = 0;
                var j: i32 = start;
                while j < i && l < 8190 {
                    if g_inbuf[j] as i32 != 13 {
                        g_line[l] = g_inbuf[j];
                        l = l + 1;
                    }
                    j = j + 1;
                }
                g_line[l] = 0;
                handle_line(g_line, l);
                start = i + 1;
            }
            i = i + 1;
        }
        var k: i32 = 0;
        while start < used {
            g_inbuf[k] = g_inbuf[start];
            k = k + 1;
            start = start + 1;
        }
        used = k;
    }
}
